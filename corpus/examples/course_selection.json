              "indices": [
                "c"
              ]
            }
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 2
        }
      },
      "prerequisite_satisfied": {
        "domain": [
          "Courses",
          "Courses"
        ],
        "sparse_filter": "prerequisites",
        "expression": {
