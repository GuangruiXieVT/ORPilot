        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "categories",
        "ordered": false
      }
    },
    "parameters": {
      "category_membership": {
        "domain": [
          "Courses",
          "Categories"
        ],
        "type": "float",
        "source": "category_membership.csv",
        "column": "is_member",
        "index_columns": [
