  },
  "ir": {
    "problem_class": "SetCoveringIP",
    "model_type": "Integer Program",
    "sense": "minimize",
    "sets": {
      "Courses": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "courses",
        "ordered": false
      },
      "Categories": {
        "size": null,
