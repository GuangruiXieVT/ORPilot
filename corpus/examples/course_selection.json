{
  "problem": {
    "title": "OR Master's Course Selection: Minimum Set Covering with Prerequisites",
    "description": "An OR master's student must take at least 2 courses from each of three categories: Mathematics, Operations Research, and Computer Science. Seven courses are available; some belong to multiple categories and count toward all their categories. Prerequisites must also be satisfied: Computer Simulation and Data Structures require Computer Programming; Management Statistics requires Calculus; Forecasting requires Management Statistics. Minimize the total number of courses taken.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total number of courses taken",
    "constraints": [
      {
        "description": "For each category, the sum of selected courses belonging to that category must be at least 2"
      },
      {
        "description": "For each (course, prerequisite) pair in the prerequisites table, if the course is selected its prerequisite must also be selected: take[course] <= take[prereq]"
      }
    ],
    "decision_variables": [
      "take[c]: 1 if course c is taken, 0 otherwise (binary)"
    ],
    "parameters": [
      "category_membership[c, cat]: 1 if course c belongs to category cat, 0 otherwise (sparse)",
      "prerequisites[c1, c2]: 1 if c1 requires c2 as a prerequisite (sparse, course-prereq pairs)"
    ],
    "additional_notes": "Category coverage: sum_c(category_membership[c,cat]*take[c]) >= 2. Prerequisite constraint uses sparse_filter: take[c1] - take[prereq] <= 0, enforced only for rows in prerequisites.csv. Optimal solution: take {calculus, operations_research, computer_programming, computer_simulation} = 4 courses. These satisfy math(calculus+OR), OR(OR+simulation), CS(programming+simulation) and all prerequisites.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "category_membership": "category_membership.csv",
      "prerequisites": "prerequisites.csv"
    }
  },
  "csv_schemas": {
