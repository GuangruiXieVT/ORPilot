        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": true
      },
      "u": {
        "description": "Integer position of customer c in the tour (MTZ subtour elimination)",
        "label": "visit_position",
