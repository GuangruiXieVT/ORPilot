{
  "problem": {
    "title": "Traveling Salesman Problem with MTZ Subtour Elimination",
    "description": "A salesman must visit 7 cities exactly once and return to the starting city (city 1, the depot). The distance between every pair of cities is given in a symmetric matrix stored as directed arcs (both directions included). Minimize total travel distance. The model uses a depot/customer structure: city 1 is the depot and cities 2-7 are customers. MTZ subtour elimination constraints prevent disconnected sub-tours among customer nodes.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total travel distance of the complete tour starting and ending at the depot",
    "constraints": [
      {
        "description": "Each city is departed exactly once: for each city c, sum over all j of x[c,j] = 1"
      },
      {
        "description": "Each city is entered exactly once: for each city c, sum over all i of x[i,c] = 1"
      },
      {
        "description": "MTZ subtour elimination: for customer pairs (c1,c2) with c1 != c2, u[c1] - u[c2] + n*x[c1,c2] <= n-1 where n = |Cities|"
      }
    ],
    "decision_variables": [
      "x[c1, c2]: binary arc variable, 1 if the salesman travels directly from city c1 to city c2 (exclude diagonal: no self-loops)",
      "u[c]: integer position variable for non-depot customers, used in MTZ subtour elimination (lb=1, ub=|Customers|)"
    ],
    "parameters": [
      "distance[c1, c2]: travel distance from city c1 to city c2 (symmetric, stored as directed arcs, no diagonal)"
    ],
    "additional_notes": "Key patterns: (1) Use filter_column='node_type', filter_value='customer' to create Customers subset from cities.csv; Cities set includes all nodes. (2) x variable uses exclude_diagonal=true. (3) MTZ domain is [Customers, Customers] with diagonal guard (compiler skips c1==c2 automatically). (4) set_size expression used as big-M in MTZ constraint and RHS. (5) u variable domain is [Customers] only — depot position is unconstrained. (6) distances.csv stores all directed pairs (both directions for symmetric matrix).",
    "csv_file_paths": {
      "all_cities": "all_cities.csv",
      "cities": "cities.csv",
      "distances": "distances.csv"
    }
  },
