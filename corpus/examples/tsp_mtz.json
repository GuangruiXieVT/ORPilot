          "operation": "indexed_sum",
          "over": [
            "Cities:c1"
          ],
          "body": {
            "type": "variable",
            "name": "x",
            "indices": [
              "c1",
              "c"
            ]
          }
        },
        "sense": "=",
        "rhs": {
