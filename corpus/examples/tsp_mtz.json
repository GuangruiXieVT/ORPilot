              ]
            },
            "right": {
              "type": "variable",
              "name": "u",
              "indices": [
                "c2"
              ]
            }
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "set_size",
              "set": "Cities"
            },
            "right": {
              "type": "variable",
              "name": "x",
              "indices": [
                "c1",
                "c2"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "operation": "subtract",
          "left": {
            "type": "set_size",
            "set": "Cities"
          },
          "right": {
            "type": "constant",
            "value": 1
          }
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Cities:c1",
          "Cities:c2"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "dist",
            "indices": [
              "c1",
              "c2"
            ]
          },
          "right": {
