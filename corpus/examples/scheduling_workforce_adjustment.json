{
  "problem": {
    "title": "Multi-Period Workforce Adjustment Planning",
    "description": "A manufacturing company must plan its workforce size over six quarterly periods. In each period, the company can hire additional workers or lay off existing ones. Workforce adjustments carry transition costs: a fixed cost per new hire and a fixed cost per layoff. Workers also generate a recurring labor cost each period. The company must maintain a workforce level that meets the forecast demand in every period without exceeding a maximum headcount. The workforce in each period equals the previous period's workforce plus new hires minus layoffs. Starting workforce is given by a policy parameter.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost of hiring, firing, and labor across all periods",
    "constraints": [
      {
        "description": "In the first period, workforce equals initial workforce plus hires minus fires"
      },
      {
        "description": "In each subsequent period, workforce equals previous period workforce plus hires minus fires"
      },
      {
        "description": "Workforce in each period must meet or exceed the required staffing level"
      },
      {
        "description": "Workforce in each period must not exceed the maximum allowed headcount"
      }
    ],
    "decision_variables": [
      "workforce[t]: number of workers employed in period t (non-negative integer)",
      "hire[t]: number of new workers hired at the start of period t (non-negative integer)",
      "fire[t]: number of workers laid off at the start of period t (non-negative integer)"
    ],
    "parameters": [
      "required_workers[t]: minimum workforce needed in period t",
      "hire_cost[t]: cost per worker hired in period t",
      "fire_cost[t]: cost per worker laid off in period t",
      "labor_cost[t]: cost per worker employed in period t",
      "initial_workforce: number of workers at the start of the planning horizon",
      "max_workers: maximum allowed workforce at any time"
    ],
    "additional_notes": "The workforce balance constraint uses temporal lag: workforce[t] = workforce[t-1] + hire[t] - fire[t]. The first-period constraint handles the initial condition separately.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand_data": "demand_data.csv",
      "policy": "policy.csv"
    }
  },
  "ir_patterns": [
    "integer variable",
    "ordered set",
    "temporal lag",
    "init constraint",
    "scalar parameter"
  ],
