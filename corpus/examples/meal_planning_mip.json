{
  "problem": {
    "title": "Meal Planning MIP: Maximize Fiber with Binary Food Selection Constraints",
    "description": "Maximize fiber intake from a 600g meal with $15 budget. Vegetables: okra(3.2g fiber/100g, $2.6/100g), carrots(2.7, $1.2), celery(1.6, $1.6), cabbage(2.0, $2.3). Proteins: salmon($4/100g), beef($3.6), pork($1.8). Must choose exactly 1 protein type and at least 2 vegetable types. If a food type is chosen (z=1), at least 10g must be included (minimum portion). Maximize total fiber.",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Total fiber (g) = sum(fiber_per_100g[f] * x[f] / 100) over all foods",
    "constraints": [
      {
        "description": "Total food weight: sum(x[f]) = 600 grams"
      },
      {
        "description": "Budget: sum(price[f] * x[f] / 100) <= 15"
      },
      {
        "description": "Exactly 1 protein type: sum(z[f] for f in Proteins) = 1"
      },
      {
        "description": "At least 2 vegetable types: sum(z[f] for f in Vegetables) >= 2"
      },
      {
        "description": "Big-M: x[f] <= 600 * z[f] (amount > 0 only if food type chosen)"
      },
      {
        "description": "Minimum portion: x[f] >= 10 * z[f] (at least 10g if food type chosen)"
      }
    ],
    "decision_variables": [
      "x[f]: grams of food f included in the meal (continuous, >=0)",
      "z[f]: binary, 1 if food type f is chosen for the meal"
    ],
    "parameters": [
      "fiber_per_100g[f]: fiber content in grams per 100g of food f",
      "budget_rate[f]: price in dollars per 100g of food f"
    ],
    "additional_notes": "Two sets: Vegetables (okra,carrots,celery,cabbage) and Proteins (salmon,beef,pork) from sets.csv. Optimal: z_pork=1 (10g min), z_okra=1 (552.86g), z_carrots=1 (37.14g). Total fiber≈18.6943g."
  },
