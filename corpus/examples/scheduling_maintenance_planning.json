{
  "problem": {
    "title": "Preventive Machine Maintenance Scheduling",
    "description": "A factory has five machines that require periodic preventive maintenance over an eight-period planning horizon. Each maintenance event has a known cost that varies by machine and period (reflecting labor and parts availability). Each machine must receive at least a minimum number of maintenance sessions and at most a maximum number during the horizon (reflecting reliability requirements and maintenance contracts). In any given period, the on-site maintenance workshop can handle at most a limited number of machines simultaneously. Determine which machines to maintain in each period to minimize total maintenance cost while satisfying all frequency and workshop-capacity constraints.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total maintenance cost across all selected machine-period assignments",
    "constraints": [
      {
        "description": "Each machine must receive at least min_maintenance maintenance sessions over the planning horizon"
      },
      {
        "description": "Each machine must receive at most max_maintenance maintenance sessions over the planning horizon"
      },
      {
        "description": "The total number of machines maintained in any period must not exceed the workshop capacity"
      }
    ],
    "decision_variables": [
      "maintain[m,p]: 1 if machine m is maintained in period p, 0 otherwise (binary)"
    ],
    "parameters": [
      "maintenance_cost[m,p]: cost of maintaining machine m in period p",
      "min_maintenance[m]: minimum number of maintenance sessions required for machine m",
      "max_maintenance[m]: maximum number of maintenance sessions allowed for machine m",
      "workshop_capacity[p]: maximum number of machines that can be maintained simultaneously in period p"
    ],
    "additional_notes": "The min/max maintenance frequency constraints ensure each machine receives appropriate preventive care without over-scheduling. Workshop capacity prevents resource conflicts.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "machines": "machines.csv",
      "maintenance_costs": "maintenance_costs.csv",
      "workshop_capacity": "workshop_capacity.csv"
    }
  },
