{
  "problem": {
    "title": "Bin Packing with Weight and Packaging Constraints",
    "description": "A company must pack five types of goods (A: 120 units/0.5t each; B: 90 units/1t each; C: 300 units/0.4t each; D: 90 units/0.6t each; E: 120 units/0.65t each) into containers. Each container holds at most 60 tons and must be loaded with at least 18 tons if used. Every used container must contain at least 12 units of good D. If any good A is loaded in a container, at least 1 unit of good C must also be in that container. Minimize the total number of containers used.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total number of containers used",
    "constraints": [
      {
        "description": "All units of each item type must be packed: sum over containers of x[i,k] = total_units[i]"
      },
      {
        "description": "Weight per used container cannot exceed 60 tons: sum_i(weight[i]*x[i,k]) <= 60*y[k]"
      },
      {
        "description": "Each used container must hold at least 18 tons: sum_i(weight[i]*x[i,k]) >= 18*y[k]"
      },
      {
        "description": "At least 12 units of D must be in each used container: x[D,k] >= 12*y[k]"
      },
      {
        "description": "x[A,k] <= 120*z[k]: if A items exist in container k, z[k]=1"
      },
      {
        "description": "x[C,k] >= z[k]: if z[k]=1 (container has A items), at least 1 C must be present"
      }
    ],
    "decision_variables": [
      "x[i,k]: integer units of item type i in container k (non-negative integer)",
      "y[k]: binary, 1 if container k is used",
      "z[k]: binary, 1 if container k contains any A items"
    ],
    "parameters": [
      "total_units[i]: total number of units of item type i to be packed",
      "weight_per_unit[i]: weight in tons per unit of item type i"
    ],
    "additional_notes": "10 containers (k01..k10) are available; optimal uses 7. The D-per-container and A-implies-C constraints use hardcoded item IDs ('D', 'A', 'C') in scalar index position within Containers domain. min_D constraint domain=[Containers]: x['D',k] - 12*y[k] >= 0. a_link: x['A',k] - 120*z[k] <= 0. c_if_a: x['C',k] - z[k] >= 0. Capacity constraints use indexed_sum over Items:i.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "items": "items.csv"
    }
  },
