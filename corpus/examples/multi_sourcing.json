{
  "problem": {
    "title": "Multi-Sourcing Procurement with Supplier Allocation Limits",
    "description": "A buyer procures several items from multiple suppliers. Each supplier offers different unit costs per item and has a total supply capacity. Additionally, each supplier-item combination has a maximum allocation limit (e.g., due to supplier contracts or risk-spreading policies). All demand must be met exactly. Determine how much of each item to order from each supplier to minimize total procurement cost while respecting supplier capacities and per-source allocation limits.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total procurement cost = sum of unit cost times order quantity over all supplier-item pairs",
    "constraints": [
      {
        "description": "Demand coverage: total quantity ordered across all suppliers for each item must exactly meet demand"
      },
      {
        "description": "Supplier capacity: total quantity supplied by each supplier across all items must not exceed that supplier's capacity"
      },
      {
        "description": "Allocation limit: quantity ordered from a specific supplier for a specific item must not exceed the per-source maximum"
      }
    ],
    "decision_variables": [
      "order[s,i]: quantity of item i ordered from supplier s (continuous, non-negative)"
    ],
    "parameters": [
      "demand[i]: total demand for item i",
      "unit_cost[s,i]: cost per unit of item i sourced from supplier s",
      "capacity[s]: maximum total units that supplier s can supply across all items",
      "max_qty[s,i]: maximum quantity of item i that may be sourced from supplier s"
    ],
    "additional_notes": "Multi-sourcing distributes procurement risk across suppliers. The capacity and max_qty constraints together shape how demand is split: the optimizer selects cheapest feasible combinations.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "items": "items.csv",
      "suppliers": "suppliers.csv",
      "supply_cost": "supply_cost.csv"
    }
  },
