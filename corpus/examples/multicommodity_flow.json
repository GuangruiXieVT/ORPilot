  "ir": {
    "problem_class": "MulticommodityFlow",
    "model_type": "Linear Program",
    "sense": "minimize",
    "sets": {
      "Nodes": {
        "size": null,
        "index_symbol": "i",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "nodes",
        "ordered": false
      },
      "Commodities": {
        "size": null,
        "index_symbol": "k",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "commodities",
        "ordered": false
      }
    },
    "parameters": {
      "arc_cost": {
        "domain": [
          "Nodes",
          "Nodes"
        ],
        "type": "float",
        "source": "arc_cost.csv",
        "column": "cost",
        "index_columns": [
          "from_node",
          "to_node"
        ],
        "missing_default": "inf"
      },
      "arc_limit": {
        "domain": [
          "Nodes",
          "Nodes"
        ],
        "type": "float",
        "source": "arc_capacity.csv",
        "column": "capacity",
        "index_columns": [
          "from_node",
          "to_node"
        ],
        "missing_default": "zero"
      },
      "net_supply": {
        "domain": [
          "Commodities",
          "Nodes"
        ],
        "type": "float",
        "source": "net_supply.csv",
        "column": "supply",
        "index_columns": [
          "commodity_id",
          "node_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "flow": {
        "description": "Units of commodity k flowing on arc from node i to node j",
        "label": "commodity_flows",
        "domain": [
          "Commodities",
          "Nodes",
          "Nodes"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "flow_conservation": {
        "domain": [
          "Commodities",
          "Nodes"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Nodes:j"
            ],
            "body": {
              "type": "variable",
              "name": "flow",
              "indices": [
                "k",
                "i",
                "j"
              ]
            }
          },
          "right": {
            "operation": "sum",
            "left": {
              "operation": "indexed_sum",
              "over": [
                "Nodes:j"
              ],
              "body": {
                "type": "variable",
                "name": "flow",
                "indices": [
                  "k",
                  "j",
                  "i"
                ]
              }
            },
            "right": {
              "type": "parameter",
              "name": "net_supply",
              "indices": [
                "k",
                "i"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "arc_capacity_limit": {
        "domain": [
          "Nodes",
          "Nodes"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Commodities:k"
            ],
            "body": {
              "type": "variable",
              "name": "flow",
              "indices": [
                "k",
                "i1",
                "i2"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "arc_limit",
            "indices": [
              "i1",
              "i2"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Commodities:k",
          "Nodes:l1",
          "Nodes:l2"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "arc_cost",
            "indices": [
              "l1",
              "l2"
            ]
          },
          "right": {
            "type": "variable",
            "name": "flow",
            "indices": [
              "k",
              "l1",
              "l2"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "duplicate set",
    "exclude diagonal",
    "sparse filter"
  ]
}