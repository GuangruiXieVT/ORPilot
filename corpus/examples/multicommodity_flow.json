{
  "problem": {
    "title": "Multicommodity Network Flow",
    "description": "A network operator routes multiple traffic demands (commodities) over a shared 5-node network with 8 directed arcs. Each commodity has a source node with positive supply and a destination node with negative supply; transit nodes have zero supply. Each arc has a capacity shared across all commodities. Minimize total routing cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum over all commodities and arcs of arc_cost[i,j]*flow[k,i,j]",
    "constraints": [
      {
        "description": "Flow conservation: for each commodity-node pair, outflow minus inflow equals net supply (positive at source, negative at destination, zero at transit)"
      },
      {
        "description": "Arc capacity: total flow across all commodities on each arc must not exceed arc capacity"
      }
    ],
    "decision_variables": [
      "flow[k,i,j]: units of commodity k flowing on arc (i,j) (continuous, non-negative)"
    ],
    "parameters": [
      "arc_cost[i,j]: per-unit routing cost on arc from node i to node j",
      "arc_limit[i,j]: capacity on arc from node i to node j (shared across commodities; 0 for non-existent arcs)",
      "net_supply[k,i]: net supply of commodity k at node i (+demand at source, -demand at destination, 0 at transit)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "arc_cost": "arc_cost.csv",
      "arc_capacity": "arc_capacity.csv",
      "net_supply": "net_supply.csv"
    }
  },
  "csv_schemas": {
