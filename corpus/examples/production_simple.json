{
  "problem": {
    "title": "Furniture Factory Single-Period Production Mix",
    "description": "A furniture factory produces chairs, tables, and shelves. Each product type requires a certain number of labor-hours and board-feet of wood per unit. The factory has a fixed supply of labor hours and wood for the period. Products can only be produced in whole units — no fractional quantities. Each product type has a maximum production capacity due to machine constraints. Each product type earns a revenue per unit produced and incurs a variable per unit production cost. Determine how many units of each product type to produce to maximize total profit.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total profit across all products, where profit is total revenue minus total variable production cost",
    "constraints": [
      {
        "description": "Total labor-hours consumed across all products cannot exceed the factory's fixed labor capacity for the period"
      },
      {
        "description": "Total board-feet of wood consumed across all products cannot exceed the factory's fixed wood supply for the period"
      },
      {
        "description": "Production of each product type cannot exceed its maximum machine capacity for the period"
      }
    ],
    "decision_variables": [
      "produce[p]: integer number of units of product p to produce"
    ],
    "parameters": [
      "revenue_per_unit[p]: revenue earned per unit of product p sold",
      "production_cost[p]: variable cost per unit of product p produced",
      "labor_hours[p]: labor-hours required to produce one unit of product p",
      "wood_board_feet[p]: board-feet of wood required to produce one unit of product p",
      "max_capacity[p]: maximum number of units of product p that can be produced in the period",
      "labor_capacity: total labor-hours available for the period",
      "wood_capacity: total board-feet of wood available for the period"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "capacity": "capacity.csv"
    }
  },
  "ir_patterns": [
    "integer variable",
    "scalar parameter"
  ],
