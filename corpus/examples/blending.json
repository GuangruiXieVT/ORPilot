          ]
        }
      },
      "min_content": {
        "domain": [
          "Beans",
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "blend",
            "indices": [
              "b",
              "p"
            ]
          },
          "right": {
            "operation": "multiply",
            "left": {
