        "element": "arabica"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "beans",
          "products"
        ],
        "element": [
          "arabica",
          "robusta",
          "blend_x",
          "premium",
          "standard",
          "economy"
        ]
      }
    },
