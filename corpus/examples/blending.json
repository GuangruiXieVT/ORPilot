{
  "problem": {
    "title": "Coffee Blending",
    "description": "A coffee producer must blend three bean types (arabica, robusta, blend_x) to meet volume demand for three product grades (premium, standard, economy). Each product has minimum arabica content and maximum robusta/blend_x fractions. Minimise total bean cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total bean cost across all products",
    "constraints": [
      {
        "description": "Volume met: total beans blended equals product demand"
      },
      {
        "description": "Minimum fraction: bean b must contribute at least min_fraction of product p volume"
      },
      {
        "description": "Maximum fraction: bean b must contribute at most max_fraction of product p volume"
      }
    ],
    "decision_variables": [
      "blend[Beans,Products]: kg of bean b used in product p (continuous, non-negative)"
    ],
    "parameters": [
      "bean_cost[Beans]: cost per kg of each bean type",
      "demand_vol[Products]: required volume (kg) of each product",
      "min_fraction[Beans,Products]: minimum fraction of bean b in product p",
      "max_fraction[Beans,Products]: maximum fraction of bean b in product p"
    ],
    "additional_notes": "Fraction constraints are linearised using the known total volume: blend[b,p] >= min_fraction[b,p]*demand_vol[p]. Optimal: arabica at minimum, robusta at maximum, blend_x fills remainder. Objective = 395 (premium) + 610 (standard) + 367.5 (economy) = 1372.5.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "beans": "beans.csv",
      "products": "products.csv",
      "blend_limits": "blend_limits.csv"
    }
  },
  "ir_patterns": [],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
