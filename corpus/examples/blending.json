              "indices": [
                "p"
              ]
            }
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "max_content": {
        "domain": [
          "Beans",
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "max_fraction",
              "indices": [
                "b",
                "p"
              ]
            },
            "right": {
              "type": "parameter",
              "name": "demand_vol",
              "indices": [
                "p"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "blend",
            "indices": [
              "b",
              "p"
            ]
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Beans:b",
          "Products:p"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "bean_cost",
            "indices": [
              "b"
            ]
          },
          "right": {
            "type": "variable",
            "name": "blend",
            "indices": [
              "b",
              "p"
            ]
          }
        }
      }
    }
  }
