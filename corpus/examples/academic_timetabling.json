{
  "problem": {
    "title": "Academic Course Timetabling",
    "description": "Assign university courses to classrooms and time slots. Courses can only be assigned to eligible rooms (meeting capacity requirements). No room can host two courses simultaneously. Maximize total faculty slot preference.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total slot preference score across all scheduled course-room-slot assignments",
    "constraints": [
      {
        "description": "Each course is scheduled in exactly one room-slot combination"
      },
      {
        "description": "Each room-slot combination hosts at most one course"
      }
    ],
    "decision_variables": [
      "schedule[c,r,sl]: 1 if course c is scheduled in room r at slot sl (binary, only for eligible course-room pairs)"
    ],
    "parameters": [
      "eligibility[c,r]: 1 if course c can use room r (sparse)",
      "slot_preference[c,sl]: faculty preference for course c in slot sl"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "room_eligibility": "room_eligibility.csv",
      "slot_pref": "slot_pref.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "3D variable",
    "preference maximization"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "courses",
        "element": "cs101"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "courses",
          "rooms",
          "slots"
        ],
        "element": [
          "cs101",
          "cs201",
          "cs301",
          "cs401",
          "cs501",
          "cs601",
          "r101",
          "r201",
          "r301",
          "m1",
          "m2",
          "m3",
          "m4",
          "m5",
          "m6"
        ]
      }
    },
    "room_eligibility": {
      "columns": {
        "course_id": "str",
        "room_id": "str",
        "eligibility": "int"
      },
      "sample": {
        "course_id": "cs101",
        "room_id": "r101",
        "eligibility": 1
      },
      "optional": false,
      "distinct_values": {
        "course_id": [
          "cs101",
          "cs201",
          "cs301",
          "cs401",
          "cs501",
          "cs601"
        ],
        "room_id": [
          "r101",
          "r201",
          "r301"
        ]
      }
    },
    "slot_pref": {
      "columns": {
        "course_id": "str",
        "slot_id": "str",
        "slot_preference": "float"
      },
      "sample": {
        "course_id": "cs101",
        "slot_id": "m1",
        "slot_preference": 5.0
      },
      "optional": false,
      "distinct_values": {
        "course_id": [
          "cs101",
          "cs201",
          "cs301",
          "cs401",
          "cs501",
          "cs601"
        ],
        "slot_id": [
          "m1",
          "m2",
          "m3",
          "m4",
          "m5",
          "m6"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "CourseTimetabling",
    "model_type": "Mixed Integer Program",
    "sense": "maximize",
    "sets": {
      "Courses": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "courses",
        "ordered": false
      },
      "Rooms": {
        "size": null,
        "index_symbol": "r",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "rooms",
        "ordered": false
      },
      "Slots": {
        "size": null,
        "index_symbol": "sl",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "slots",
        "ordered": false
      }
    },
    "parameters": {
      "eligibility": {
        "domain": [
          "Courses",
          "Rooms"
        ],
        "type": "float",
        "source": "room_eligibility.csv",
        "column": "eligibility",
        "index_columns": [
          "course_id",
          "room_id"
        ],
        "missing_default": "zero"
      },
      "slot_preference": {
        "domain": [
          "Courses",
          "Slots"
        ],
        "type": "float",
        "source": "slot_pref.csv",
        "column": "slot_preference",
        "index_columns": [
          "course_id",
          "slot_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "schedule": {
        "description": "1 if course c is assigned to room r in slot sl (only for eligible course-room pairs)",
        "label": "course_room_slot_schedule",
        "domain": [
          "Courses",
          "Rooms",
          "Slots"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "eligibility"
      }
    },
    "constraints": {
      "each_course_once": {
        "domain": [
          "Courses"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Rooms:r",
            "Slots:sl"
          ],
          "body": {
            "type": "variable",
            "name": "schedule",
            "indices": [
              "c",
              "r",
              "sl"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "room_slot_once": {
        "domain": [
          "Rooms",
          "Slots"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Courses:c"
          ],
          "body": {
            "type": "variable",
            "name": "schedule",
            "indices": [
              "c",
              "r",
              "sl"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Courses:c",
          "Rooms:r",
          "Slots:sl"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "slot_preference",
            "indices": [
              "c",
              "sl"
            ]
          },
          "right": {
            "type": "variable",
            "name": "schedule",
            "indices": [
              "c",
              "r",
              "sl"
            ]
          }
        }
      }
    }
  }
}
