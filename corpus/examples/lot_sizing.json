          "left": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "initial_inv",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "produce",
              "indices": [
                "p",
                "Periods[0]"
              ]
            }
          },
          "right": {
