{
  "problem": {
    "title": "Capacitated Lot Sizing Problem (CLSP)",
    "description": "A manufacturer produces several products on a shared machine over a multi-period planning horizon. In each period, a product can only be produced if the machine is set up for it, incurring a fixed setup cost. Variable production cost and per-unit holding cost also apply. The machine has a limited total capacity per period shared across all products. Known demand must be met each period from available inventory. Determine which products to set up and how much to produce each period to minimize total setup, production, and holding costs.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of setup costs (when machine is set up for a product) plus variable production costs plus inventory holding costs, over all products and periods",
    "constraints": [
      {
        "description": "Inventory balance initialization: first-period ending inventory equals initial inventory plus production minus demand"
      },
      {
        "description": "Inventory balance: ending inventory equals previous inventory plus production minus demand (temporal lag)"
      },
      {
        "description": "Setup link: production quantity is zero unless the machine is set up (big-M linking constraint)"
      },
      {
        "description": "Machine capacity: total production across all products in a period must not exceed the machine capacity"
      }
    ],
    "decision_variables": [
      "produce[p,t]: units of product p produced in period t (continuous, non-negative)",
      "setup[p,t]: 1 if product p is set up on the machine in period t, else 0 (binary)",
      "inventory[p,t]: units of product p in inventory at the end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[p,t]: known demand for product p in period t",
      "setup_cost[p]: fixed cost incurred when the machine is set up for product p",
      "prod_cost[p]: variable production cost per unit of product p",
      "holding_cost[p]: per-unit per-period holding cost for product p",
      "initial_inv[p]: inventory on hand at the start of the planning horizon for product p",
      "max_batch[p]: maximum units of product p producible per period (big-M for setup link)",
      "machine_cap: total machine capacity (units) available per period, shared across all products"
    ],
    "additional_notes": "The setup_link constraint (produce[p,t] <= max_batch[p] * setup[p,t]) forces the binary setup variable to 1 before any production occurs. The inventory balance uses a temporal lag to link adjacent periods.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv",
      "machine_params": "machine_params.csv"
    }
  },
