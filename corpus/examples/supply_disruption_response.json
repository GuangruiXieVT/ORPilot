        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Scenarios": {
        "size": null,
        "index_symbol": "sc",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "scenarios",
        "ordered": false
      }
    },
    "parameters": {
