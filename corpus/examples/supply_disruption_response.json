  "ir": {
    "problem_class": "SupplyDisruptionResponse",
    "model_type": "Linear Program",
    "sense": "minimize",
    "sets": {
      "Suppliers": {
        "size": null,
        "index_symbol": "s",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "suppliers",
        "ordered": false
      },
      "Products": {
