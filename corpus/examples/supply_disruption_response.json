      }
    },
    "variables": {
      "contract": {
        "description": "Contracted capacity from supplier s for product p",
        "label": "contracted_capacity",
        "domain": [
          "Suppliers",
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "source": {
        "description": "Actual sourcing from supplier s for product p in scenario sc",
        "label": "actual_sourcing",
        "domain": [
          "Suppliers",
          "Products",
          "Scenarios"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "shortage": {
        "description": "Unmet demand for product p in scenario sc",
        "label": "demand_shortage",
        "domain": [
          "Products",
          "Scenarios"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "source_limit": {
        "domain": [
          "Suppliers",
          "Products",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "source",
            "indices": [
              "s",
              "p",
              "sc"
            ]
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "available_fraction",
              "indices": [
                "s",
                "sc"
              ]
            },
            "right": {
              "type": "variable",
              "name": "contract",
              "indices": [
                "s",
                "p"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "demand_balance": {
        "domain": [
          "Products",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "operation": "indexed_sum",
              "over": [
                "Suppliers:s"
              ],
              "body": {
                "type": "variable",
                "name": "source",
                "indices": [
                  "s",
                  "p",
                  "sc"
                ]
              }
            },
            "right": {
              "type": "variable",
              "name": "shortage",
              "indices": [
                "p",
                "sc"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "demand",
            "indices": [
              "p"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Suppliers:s",
            "Products:p"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "contract_cost",
              "indices": [
                "s",
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "contract",
              "indices": [
                "s",
                "p"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "Scenarios:sc"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "probability",
              "indices": [
                "sc"
              ]
            },
            "right": {
              "operation": "sum",
              "left": {
                "operation": "indexed_sum",
                "over": [
                  "Suppliers:s",
                  "Products:p"
                ],
                "body": {
                  "operation": "multiply",
                  "left": {
                    "type": "parameter",
                    "name": "source_cost",
                    "indices": [
                      "s",
                      "p"
                    ]
                  },
                  "right": {
                    "type": "variable",
                    "name": "source",
                    "indices": [
                      "s",
                      "p",
                      "sc"
                    ]
                  }
                }
              },
              "right": {
                "operation": "indexed_sum",
                "over": [
                  "Products:p"
                ],
                "body": {
                  "operation": "multiply",
                  "left": {
                    "type": "parameter",
                    "name": "shortage_cost",
                    "indices": [
                      "p"
                    ]
                  },
                  "right": {
                    "type": "variable",
                    "name": "shortage",
                    "indices": [
                      "p",
                      "sc"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
