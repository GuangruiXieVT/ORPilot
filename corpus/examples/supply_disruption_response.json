{
  "problem": {
    "title": "Supply Disruption Response",
    "description": "A supply chain faces potential supplier disruptions across scenarios. First stage: commit to supplier contracts (capacity reservation). Second stage: actual sourcing given disruptions. Shortage penalties apply for unmet demand. Minimize expected total cost.",
    "problem_type": "stochastic_program",
    "objective": "minimize",
    "objective_description": "Contract reservation costs plus expected sourcing and shortage costs across scenarios",
    "constraints": [
      {
        "description": "Sourcing limited by available fraction times contracted capacity"
      },
      {
        "description": "Total sourcing plus shortage meets demand in each scenario"
      }
    ],
    "decision_variables": [
      "contract[s,p]: contracted capacity from supplier s for product p (continuous >= 0)",
      "source[s,p,sc]: actual sourcing in scenario sc (continuous >= 0)",
      "shortage[p,sc]: unmet demand in scenario sc (continuous >= 0)"
    ],
    "parameters": [
      "contract_cost[s,p]: cost per unit contracted",
      "source_cost[s,p]: variable sourcing cost",
      "available_fraction[s,sc]: fraction of contracted capacity deliverable in scenario sc",
      "demand[p]: total demand to be fulfilled",
      "probability[sc]: scenario probability",
      "shortage_cost[p]: penalty per unit short"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "contract_costs": "contract_costs.csv",
      "source_costs": "source_costs.csv",
      "avail_fractions": "avail_fractions.csv",
      "demand": "demand.csv",
      "shortage_costs": "shortage_costs.csv",
      "scenarios": "scenarios.csv"
    }
  },
  "csv_schemas": {
