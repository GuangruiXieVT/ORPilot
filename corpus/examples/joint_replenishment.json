      },
      "sample": {
        "product_id": "pr1",
        "holding_rate": 0.5,
        "order_cost": 30.0,
        "max_order": 200.0
      },
      "optional": false,
      "distinct_values": {
        "product_id": [
          "pr1",
          "pr2",
          "pr3",
          "pr4"
        ]
      }
    },
    "params": {
      "columns": {
