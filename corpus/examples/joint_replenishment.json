      "optional": false,
      "distinct_values": {}
    }
  },
  "ir": {
    "problem_class": "JointReplenishment",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Periods": {
        "size": null,
