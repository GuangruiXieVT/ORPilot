{
  "problem": {
    "title": "Joint Replenishment Problem",
    "description": "A retailer orders multiple products from a common supplier over 6 weekly periods. A joint ordering cost is incurred whenever any product is ordered. Each product also has its own ordering cost and holding cost. Demand must be met and inventory balanced over time. Minimize total ordering and holding costs.",
    "problem_type": "mixed_integer_program",
    "objective": "minimize",
    "objective_description": "Total holding costs plus per-product ordering costs plus joint ordering cost",
    "constraints": [
      {
        "description": "Inventory balance: inventory[t] = inventory[t-1] + order[t] - demand[t]"
      },
      {
        "description": "Order quantity is zero if no order is placed (big-M linking)"
      },
      {
        "description": "Joint order flag is active if any product orders"
      }
    ],
    "decision_variables": [
      "order[p,t]: units ordered for product p in period t (continuous >= 0)",
      "inventory[p,t]: ending inventory for product p in period t (continuous >= 0)",
      "order_placed[p,t]: 1 if product p is ordered in period t (binary)",
      "joint_order[t]: 1 if any order placed in period t (binary)"
    ],
    "parameters": [
      "demand[p,t]: units demanded",
      "holding_rate[p]: holding cost per unit per period",
      "order_cost[p]: fixed cost when product p is ordered",
      "max_order[p]: maximum order quantity (big-M)",
      "joint_order_cost: shared ordering cost per joint order event"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand": "demand.csv",
      "products": "products.csv",
      "params": "params.csv"
    }
  },
  "ir_patterns": [
    "temporal lag",
    "init constraint",
    "binary big-M linking",
    "joint ordering cost"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "products",
        "element": "pr1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "products",
          "periods"
        ],
