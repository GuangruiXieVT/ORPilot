          "pr2",
          "pr3",
          "pr4",
          "wk1",
          "wk2",
          "wk3",
          "wk4",
          "wk5",
          "wk6"
        ]
      }
    },
    "demand": {
      "columns": {
        "product_id": "str",
        "period_id": "str",
        "demand": "float"
      },
      "sample": {
