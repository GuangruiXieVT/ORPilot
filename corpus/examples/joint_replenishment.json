              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "inventory",
            "indices": [
              "p",
              "Periods[0]"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "inventory_balance": {
        "domain": [
          "Products",
          "Periods"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "wk"
              ],
              "lag": -1
            },
            "right": {
              "type": "variable",
              "name": "order",
              "indices": [
                "p",
                "wk"
              ]
            }
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
                "wk"
              ]
            },
            "right": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "wk"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "order_if_placed": {
        "domain": [
          "Products",
          "Periods"
        ],
        "expression": {
