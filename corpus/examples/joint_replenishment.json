    "constraints": {
      "inventory_balance_init": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "subtract",
            "left": {
              "type": "variable",
              "name": "order",
              "indices": [
                "p",
                "Periods[0]"
              ]
            },
            "right": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
