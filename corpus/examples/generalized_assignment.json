  },
  "ir": {
    "problem_class": "GeneralizedAssignment",
    "model_type": "Mixed Integer Program",
    "sense": "maximize",
    "sets": {
      "Jobs": {
        "size": null,
        "index_symbol": "j",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "jobs",
        "ordered": false
      },
      "Machines": {
        "size": null,
        "index_symbol": "m",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "machines",
        "ordered": false
      }
    },
    "parameters": {
      "profit": {
        "domain": [
          "Jobs",
          "Machines"
        ],
        "type": "float",
        "source": "job_machine_data.csv",
        "column": "profit",
        "index_columns": [
          "job_id",
          "machine_id"
        ],
        "missing_default": "zero"
      },
      "resource_use": {
        "domain": [
          "Jobs",
          "Machines"
        ],
        "type": "float",
        "source": "job_machine_data.csv",
        "column": "resource_use",
        "index_columns": [
          "job_id",
          "machine_id"
        ],
        "missing_default": "zero"
      },
      "capacity": {
        "domain": [
          "Machines"
        ],
        "type": "float",
        "source": "machines.csv",
        "column": "capacity",
        "index_columns": [
          "id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "assign": {
        "description": "1 if job j is assigned to machine m, 0 otherwise",
        "label": "job_machine_assignments",
        "domain": [
          "Jobs",
          "Machines"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "one_machine_per_job": {
        "domain": [
          "Jobs"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Machines:m"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "j",
              "m"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "machine_capacity": {
        "domain": [
          "Machines"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Jobs:j"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "resource_use",
              "indices": [
                "j",
                "m"
              ]
            },
            "right": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "j",
                "m"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "capacity",
          "indices": [
            "m"
          ]
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Jobs:j",
          "Machines:m"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "profit",
            "indices": [
              "j",
              "m"
            ]
          },
          "right": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "j",
              "m"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
