{
  "problem": {
    "title": "Generalized Assignment: Jobs to Machines",
    "description": "A manufacturing plant has a set of jobs to schedule and a set of machines to run them on. Each job must be assigned to exactly one machine. Assigning a particular job to a particular machine yields a known profit and consumes a known amount of that machine's processing capacity (processing times differ by job-machine pair). Each machine has a fixed total capacity limit. Find the assignment of all jobs to machines that maximizes total profit while ensuring no machine's capacity is exceeded.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total profit earned from assigning all jobs to machines, summed over all job-machine assignment pairs",
    "constraints": [
      {
        "description": "Each job must be assigned to exactly one machine"
      },
      {
        "description": "For each machine, the total processing capacity consumed by all jobs assigned to it must not exceed the machine's capacity"
      }
    ],
    "decision_variables": [
      "assign[j,m]: 1 if job j is assigned to machine m, 0 otherwise (binary)"
    ],
    "parameters": [
      "profit[j,m]: profit earned if job j is assigned to machine m",
      "resource_use[j,m]: processing capacity consumed by job j when run on machine m",
      "capacity[m]: maximum processing capacity available on machine m"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "machines": "machines.csv",
      "job_machine_data": "job_machine_data.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "jobs",
        "element": "job_1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
