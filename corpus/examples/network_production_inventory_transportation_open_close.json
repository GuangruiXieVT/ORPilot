{
  "problem": {
    "title": "Multi-Period Production-Inventory-Distribution Network with Plant Opening, Closing, and Step Operating Costs",
    "description": "A manufacturer operates a three-tier distribution network — plants, warehouses, and retailers — over multiple time periods. Each plant starts the horizon in a known initial state (open or closed). In each period, each plant is either open or closed. A plant may be opened or closed any number of times within the horizon. Opening a plant (transitioning from closed to open) incurs a one-time opening cost in that period. Closing a plant (transitioning from open to closed) incurs a one-time closing cost in that period. When a plant is open it incurs a per-period step operating cost that depends on its production tier (low, medium, or high), each tier covering a range of output levels. When a plant is closed it incurs no operating cost and cannot produce. In each period, each open plant selects exactly one tier; closed plants select no tier. Within the selected tier, the actual production quantity can range freely between the tier's lower and upper bounds, and each unit also incurs a per-unit production cost. Produced goods enter plant inventory; a holding cost applies to every unit stored at a plant at period end. Goods are shipped from plants to warehouses and from warehouses to retailers over a sparse set of established arcs, each with a per-unit shipping cost and a per-period arc capacity. Warehouses hold inventory across periods at a holding cost and are limited by a storage capacity. Each retailer has a known demand per period that must be exactly met. The goal is to decide when to open and close each plant, which tier each open plant uses each period, how much to produce, and how to route goods to minimise total cost: plant opening costs, plant closing costs, step operating costs, per-unit production costs, plant and warehouse holding costs, and transportation costs.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost: one-time plant opening costs (charged each time a plant opens), one-time plant closing costs (charged each time a plant closes), per-period step operating costs based on the active production tier, per-unit production costs, inventory holding costs at plants and warehouses, and per-unit shipping costs across all arcs and periods",
    "constraints": [
      {
        "description": "For the first period: if a plant starts closed (initial_open=0) and is open in period t0, plant_opens must equal 1; ensured by plant_opens[i,t0] + initial_open[i] >= open_plant[i,t0]"
      },
      {
        "description": "For each subsequent period: if a plant was closed in t-1 and is open in t, plant_opens must equal 1; ensured by plant_opens[i,t] + open_plant[i,t-1] >= open_plant[i,t]"
      },
      {
        "description": "For the first period: if a plant starts open (initial_open=1) and is closed in period t0, plant_closes must equal 1; ensured by plant_closes[i,t0] + open_plant[i,t0] >= initial_open[i]"
      },
      {
        "description": "For each subsequent period: if a plant was open in t-1 and is closed in t, plant_closes must equal 1; ensured by plant_closes[i,t] + open_plant[i,t] >= open_plant[i,t-1]"
      },
      {
        "description": "For each plant and period, exactly one production tier must be active if the plant is open, and no tier may be active if it is closed (sum of tier indicators equals open status)"
      },
      {
        "description": "Production at each open plant in each period must be at least the lower bound of the active tier"
      },
      {
        "description": "Production at each open plant in each period must not exceed the upper bound of the active tier"
      },
      {
        "description": "Plant inventory balance for the first period: ending inventory equals initial inventory plus production minus total shipments to warehouses"
      },
      {
        "description": "Plant inventory balance for subsequent periods: ending inventory equals prior-period ending inventory plus production minus total shipments to warehouses"
      },
      {
        "description": "Warehouse inventory balance for the first period: ending inventory equals initial inventory plus total inflow from plants minus total outflow to retailers"
      },
      {
        "description": "Warehouse inventory balance for subsequent periods: ending inventory equals prior-period ending inventory plus inflow from plants minus outflow to retailers"
      },
      {
        "description": "Inventory held at each warehouse at end of each period must not exceed the warehouse storage capacity"
      },
      {
        "description": "For each retailer and period, total inflow from all connected warehouses must exactly equal the retailer's demand"
      },
      {
        "description": "Flow on each plant-to-warehouse arc in each period must not exceed that arc's per-period throughput capacity"
      },
      {
        "description": "Flow on each warehouse-to-retailer arc in each period must not exceed that arc's per-period throughput capacity"
      }
    ],
    "decision_variables": [
      "open_plant[i,t]: 1 if plant i is open in period t, 0 otherwise (binary); may change freely between periods",
      "plant_opens[i,t]: 1 if plant i opens at the start of period t (transitions from closed to open), 0 otherwise (binary)",
      "plant_closes[i,t]: 1 if plant i closes at the start of period t (transitions from open to closed), 0 otherwise (binary)",
      "use_tier[i,t,k]: 1 if plant i operates at production tier k in period t, 0 otherwise (binary); exactly one tier active per open plant per period",
      "produce[i,t]: units produced at plant i in period t (continuous, non-negative)",
      "inventory_plant[i,t]: inventory held at plant i at end of period t (continuous, non-negative)",
      "inventory_wh[w,t]: inventory held at warehouse w at end of period t (continuous, non-negative)",
      "flow_pw[i,w,t]: units shipped from plant i to warehouse w in period t (continuous, non-negative, defined only for valid arcs)",
      "flow_wr[w,r,t]: units shipped from warehouse w to retailer r in period t (continuous, non-negative, defined only for valid arcs)"
    ],
    "parameters": [
      "opening_cost[i]: one-time fixed cost incurred each time plant i is activated (transitions from closed to open)",
      "closing_cost[i]: one-time fixed cost incurred each time plant i is deactivated (transitions from open to closed)",
      "initial_open[i]: 1 if plant i is open at the start of the planning horizon, 0 if closed",
      "prod_cost[i]: variable production cost per unit produced at plant i",
      "hold_cost_plant[i]: inventory holding cost per unit per period at plant i",
      "initial_inv_plant[i]: inventory at plant i at the start of the planning horizon",
      "tier_lb[i,k]: minimum production quantity required when plant i operates at tier k",
      "tier_ub[i,k]: maximum production quantity allowed when plant i operates at tier k",
      "tier_op_cost[i,k]: fixed operating cost per period when plant i is in tier k",
      "hold_cost_wh[w]: inventory holding cost per unit per period at warehouse w",
      "wh_capacity[w]: maximum inventory that can be held at warehouse w at end of any period",
      "initial_inv_wh[w]: inventory at warehouse w at the start of the planning horizon",
      "demand[r,t]: units required by retailer r in period t",
      "cost_pw[i,w]: per-unit shipping cost from plant i to warehouse w (defined only for valid arcs)",
      "cost_wr[w,r]: per-unit shipping cost from warehouse w to retailer r (defined only for valid arcs)",
      "cap_pw[i,w]: per-period arc capacity from plant i to warehouse w (defined only for valid arcs)",
      "cap_wr[w,r]: per-period arc capacity from warehouse w to retailer r (defined only for valid arcs)"
    ],
    "additional_notes": "plant_opens[i,t] and plant_closes[i,t] are forced to 1 by linear inequalities whenever the open_plant variable transitions; because costs are minimised the optimizer will not set them to 1 unless forced. A plant may be opened and closed multiple times; each transition incurs the corresponding one-time cost. The step operating cost applies only in periods when a plant is open; closed plants pay neither operating nor production costs. Arc parameters are defined only for established shipping lanes. Plants all start with zero finished-goods inventory.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "plant_tiers": "plant_tiers.csv",
      "warehouses": "warehouses.csv",
      "demand_data": "demand_data.csv",
      "arc_costs_pw": "arc_costs_pw.csv",
      "arc_costs_wr": "arc_costs_wr.csv",
      "arc_caps_pw": "arc_caps_pw.csv",
      "arc_caps_wr": "arc_caps_wr.csv"
    }
  },
