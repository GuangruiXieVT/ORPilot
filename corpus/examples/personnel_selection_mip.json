{
  "problem": {
    "title": "Personnel Selection MIP: Minimize Salary with Skill and Experience Requirements",
    "description": "5 candidates F,G,H,I,J with salaries 12k,15k,18k,5k,10k. Budget ≤ 40k, max 4 employees. Need total skill ≥ 8, total experience ≥ 8. G and J have similar backgrounds so at most one can be hired. Minimize total salary.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total salary = sum(salary[c] * hire[c]) over all candidates",
    "constraints": [
      {
        "description": "Budget: sum(salary * hire) <= 40000"
      },
      {
        "description": "Max employees: sum(hire) <= 4"
      },
      {
        "description": "Skill requirement: sum(skill_level * hire) >= 8"
      },
      {
        "description": "Experience requirement: sum(experience * hire) >= 8"
      },
      {
        "description": "G and J mutual exclusion: hire[G] + hire[J] <= 1"
      }
    ],
    "decision_variables": [
      "hire[c]: binary, 1 if candidate c is hired"
    ],
    "parameters": [
      "salary[c]: annual salary requirement for candidate c",
      "skill_level[c]: skill level of candidate c",
      "experience[c]: years of project management experience for candidate c"
    ],
    "additional_notes": "Optimal: hire H+I+G = 18000+5000+15000=38000. Skill=4+1+3=8. Exp=2+5+2=9."
  },
