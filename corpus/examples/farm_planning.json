{
  "problem": {
    "title": "Farm Planning LP: Crops, Livestock, and External Labor",
    "description": "A farm has 100 hectares of land and 15,000 yuan capital. Labor available: 3,500 person-days in autumn/winter and 4,000 in spring/summer. Three crops (soybeans, corn, wheat) can be planted; dairy cows and chickens can be raised. Unused labor can be sold externally at 2.1 yuan/day (spring/summer) and 1.8 yuan/day (autumn/winter). Cows require 1.5 ha land and capital 400 yuan each; barn holds max 32 cows. Chickens require no land, capital 3 yuan each; coop holds max 3000 chickens. Maximize total annual net income.",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Total annual net income from crops, livestock, and externally sold labor",
    "constraints": [
      {
        "description": "Total land used by crops and cow feed (1.5 ha per cow) cannot exceed 100 hectares"
      },
      {
        "description": "Total capital investment in cows (400 yuan each) and chickens (3 yuan each) cannot exceed 15,000 yuan"
      },
      {
        "description": "Total spring/summer labor used by crops, cows (50 person-days), chickens (0.3 person-days) plus externally sold labor cannot exceed 4,000 person-days"
      },
      {
        "description": "Total autumn/winter labor used by crops, cows (100 person-days), chickens (0.6 person-days) plus externally sold labor cannot exceed 3,500 person-days"
      },
      {
        "description": "Number of cows cannot exceed barn capacity of 32"
      },
      {
        "description": "Number of chickens cannot exceed coop capacity of 3,000"
      }
    ],
    "decision_variables": [
      "plant[crop]: hectares of each crop to plant (continuous, non-negative)",
      "cows: number of dairy cows (continuous, non-negative)",
      "chickens: number of chickens (continuous, non-negative)",
      "ext_spring: person-days of labor sold externally in spring/summer (continuous, non-negative)",
      "ext_autumn: person-days of labor sold externally in autumn/winter (continuous, non-negative)"
    ],
    "parameters": [
      "spring_labor_per_ha[crop]: spring/summer person-days required per hectare of crop",
      "autumn_labor_per_ha[crop]: autumn/winter person-days required per hectare of crop",
      "income_per_ha[crop]: annual net income per hectare of crop"
    ],
    "additional_notes": "Scalar variables (domain=[]) for cows, chickens, ext_spring, ext_autumn. Constraints mix indexed_sum over Crops with scalar terms (multiply(constant, scalar_var)). Land constraint: indexed_sum(plant[c]) + 1.5*cows <= 100. Capital: 400*cows + 3*chickens <= 15000. Objective: indexed_sum(income_per_ha[c]*plant[c]) + 400*cows + 2*chickens + 2.1*ext_spring + 1.8*ext_autumn. Optimal obj=20241.8.",
    "csv_file_paths": {
      "crops": "crops.csv"
    }
  },
