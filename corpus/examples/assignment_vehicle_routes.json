{
  "problem": {
    "title": "Vehicle-to-Route Assignment",
    "description": "A logistics company must assign four vehicles to eight delivery routes. Each route has a known cargo load and distance. Each vehicle has a maximum cargo capacity and an operating cost per kilometer. Each route must be covered by exactly one vehicle. The total cargo load across all routes assigned to a vehicle must not exceed that vehicle's capacity. Multiple routes can be assigned to the same vehicle. Determine the minimum-cost assignment of vehicles to routes.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total operating cost: sum of (cost_per_km × distance × assign) across all vehicle-route pairs",
    "constraints": [
      {
        "description": "Each route must be assigned to exactly one vehicle"
      },
      {
        "description": "The total cargo load assigned to each vehicle must not exceed its capacity"
      }
    ],
    "decision_variables": [
      "assign[v,r]: 1 if vehicle v is assigned to route r, 0 otherwise (binary)"
    ],
    "parameters": [
      "route_load[r]: cargo load in tonnes for route r",
      "distance_km[r]: distance in kilometers for route r",
      "vehicle_capacity[v]: maximum cargo capacity in tonnes for vehicle v",
      "cost_per_km[v]: operating cost per kilometer for vehicle v"
    ],
    "additional_notes": "The total trip cost for vehicle v on route r is cost_per_km[v] * distance_km[r]. The model minimizes total operating cost across all assigned routes.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "routes": "routes.csv",
      "vehicles": "vehicles.csv"
    }
  },
  "csv_schemas": {
    "sets": {
