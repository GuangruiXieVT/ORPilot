{
  "problem": {
    "title": "Bill-of-Materials Production Planning with Alternative BOMs",
    "description": "A factory produces a set of finished products. Each finished product can be assembled using one or more alternative Bill of Materials (BOM) configurations. Producing one unit of product p using BOM b requires a known quantity of each component c as specified by that BOM. Different BOMs for the same product may use different components or different quantities, for example substituting one raw material for another. Each component has a limited available supply shared across all products and BOMs. Each product has a known market demand cap (maximum total units the market will absorb, regardless of which BOM is used). Each product has a per-unit profit that does not depend on which BOM is used. Decide how many units of each product to produce under each BOM to maximize total profit, subject to not exceeding component supply limits and market demand caps.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total profit from production, summed over all products and recipes weighted by units produced",
    "constraints": [
      {
        "description": "For each product, the total units produced across all recipes must not exceed that product's market demand cap"
      },
      {
        "description": "For each component, the total component consumption across all products and recipes (according to BOM quantities) must not exceed the available component supply"
      }
    ],
    "decision_variables": [
      "produce[p,b]: units of product p produced using BOM recipe b (continuous, non-negative)"
    ],
    "parameters": [
      "profit[p]: profit per unit of product p produced (independent of recipe)",
      "max_demand[p]: maximum total units of product p that the market will absorb across all recipes",
      "bom[c,p,b]: units of component c required to produce one unit of product p using recipe b",
      "component_supply[c]: total available supply of component c"
    ],
    "additional_notes": "The BOM table is sparse: only (component, product, recipe) triples with non-zero consumption need to appear. Missing entries default to zero consumption. The demand cap applies to the sum of production across all recipes for a given product.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "components": "components.csv",
      "bom": "bom.csv"
    }
  },
  "csv_schemas": {
