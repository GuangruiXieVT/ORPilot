  "ir": {
    "problem_class": "BOMProductionPlanningAlternative",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Components": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "components",
        "ordered": false
      },
      "BOMs": {
        "size": null,
        "index_symbol": "b",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "boms",
        "ordered": false
      }
    },
    "parameters": {
      "profit": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "profit_per_unit",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "max_demand": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "max_demand",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "bom": {
        "domain": [
          "Components",
          "Products",
          "BOMs"
        ],
        "type": "float",
        "source": "bom.csv",
        "column": "quantity",
        "index_columns": [
          "component_id",
          "product_id",
          "bom_id"
        ],
        "missing_default": "zero"
      },
      "component_supply": {
        "domain": [
          "Components"
        ],
        "type": "float",
        "source": "components.csv",
        "column": "available_supply",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "produce": {
        "description": "Units of product p produced using BOM recipe b",
        "label": "production_quantities",
        "domain": [
          "Products",
          "BOMs"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "demand_limit": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "BOMs:b"
          ],
          "body": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p",
              "b"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "max_demand",
          "indices": [
            "p"
          ]
        }
      },
      "bom_availability": {
        "domain": [
          "Components"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p",
            "BOMs:b"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "bom",
              "indices": [
                "c",
                "p",
                "b"
              ]
            },
            "right": {
              "type": "variable",
              "name": "produce",
              "indices": [
                "p",
                "b"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "component_supply",
          "indices": [
            "c"
          ]
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Products:p",
          "BOMs:b"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "profit",
            "indices": [
              "p"
            ]
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p",
              "b"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "BOM parameter"
  ]
