{
  "problem": {
    "title": "Multi-Type Worker Shift Planning",
    "description": "A company operates three daily shifts (morning, afternoon, night) seven days a week. Two categories of workers are available: full-time (ft) and part-time (pt), each with different per-shift costs. Each shift on each day has a minimum staffing requirement. Full-time workers are limited to 20 total shift assignments per week and part-time workers to 15. Determine how many workers of each type to assign to each shift-day combination to meet all coverage requirements at minimum total labor cost.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total labor cost summed over all worker-type, shift, day combinations",
    "constraints": [
      {
        "description": "For each shift on each day, the total number of workers (across all types) must meet or exceed the required staffing level"
      },
      {
        "description": "For each worker type, the total number of shift assignments across the week must not exceed the weekly capacity limit"
      }
    ],
    "decision_variables": [
      "workers[wt,s,d]: number of workers of type wt assigned to shift s on day d (non-negative integer)"
    ],
    "parameters": [
      "demand[s,d]: minimum number of workers required for shift s on day d",
      "cost_per_shift[wt,s]: cost of scheduling one worker of type wt for shift s",
      "weekly_capacity[wt]: maximum total shift assignments per week for worker type wt"
    ],
    "additional_notes": "Workers of both types are interchangeable for coverage purposes. The model optimizes the mix of worker types to minimize total cost while respecting all staffing and capacity constraints.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand": "demand.csv",
      "shift_costs": "shift_costs.csv",
      "weekly_capacity": "weekly_capacity.csv"
    }
  },
