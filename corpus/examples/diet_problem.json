{
  "problem": {
    "title": "Hospital Daily Meal Plan",
    "description": "A hospital nutritionist must design a daily meal plan from a set of available food items. Each food item has a cost per serving and provides known amounts of several nutrients per serving. The meal plan must satisfy minimum and maximum daily intake requirements for each nutrient. Determine how many servings of each food item to include in the daily meal plan to minimize total cost while meeting all nutritional requirements.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost of the daily meal plan across all food items and their serving quantities",
    "constraints": [
      {
        "description": "The total amount of each nutrient provided by all food servings must meet the minimum daily intake requirement for that nutrient"
      },
      {
        "description": "The total amount of each nutrient provided by all food servings must not exceed the maximum daily allowance for that nutrient"
      }
    ],
    "decision_variables": [
      "eat[f]: number of servings of food f to include in the daily meal plan (continuous, non-negative)"
    ],
    "parameters": [
      "cost_per_serving[f]: cost per serving of food item f",
      "nutrition[f, n]: amount of nutrient n provided by one serving of food item f",
      "min_req[n]: minimum daily intake requirement for nutrient n",
      "max_req[n]: maximum daily allowance for nutrient n"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "foods": "foods.csv",
      "nutrients": "nutrients.csv",
      "nutrition": "nutrition.csv",
      "nutrient_limits": "nutrient_limits.csv"
    }
  },
