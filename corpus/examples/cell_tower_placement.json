      "optional": false,
      "distinct_values": {}
    }
  },
  "ir": {
    "problem_class": "CoverageMaximization",
    "model_type": "Mixed Integer Program",
    "sense": "maximize",
    "sets": {
      "Sites": {
        "size": null,
        "index_symbol": "s",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "sites",
        "ordered": false
      },
      "Zones": {
        "size": null,
        "index_symbol": "z",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "zones",
        "ordered": false
      }
    },
    "parameters": {
      "covers": {
        "domain": [
          "Sites",
          "Zones"
        ],
        "type": "float",
        "source": "coverage.csv",
        "column": "covers",
        "index_columns": [
          "site_id",
          "zone_id"
        ],
        "missing_default": "zero"
      },
      "population": {
        "domain": [
