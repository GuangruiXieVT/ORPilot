{
  "problem": {
    "title": "Cell Tower Placement",
    "description": "Place cell towers at candidate sites to maximize population covered. Each tower covers several geographic zones. Budget limits total construction cost. Maximize total population covered.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total population covered by at least one tower",
    "constraints": [
      {
        "description": "Total build cost does not exceed budget"
      },
      {
        "description": "A zone is only covered if at least one tower covering it is built"
      }
    ],
    "decision_variables": [
      "build[s]: 1 if tower built at site s (binary)",
      "covered[z]: 1 if zone z is covered (binary)"
    ],
    "parameters": [
      "covers[s,z]: 1 if tower at site s covers zone z",
      "population[z]: population in zone z",
      "site_fee[s]: cost to build tower at site s",
      "budget: total budget"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "coverage": "coverage.csv",
      "population": "population.csv",
      "costs": "costs.csv",
      "params": "params.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "coverage linking",
    "sparse parameter",
    "scalar parameter"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "sites",
        "element": "s1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
