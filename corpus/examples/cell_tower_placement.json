        "column": "budget",
        "missing_default": "zero"
      },
      "site_fee": {
        "domain": [
          "Sites"
        ],
        "type": "float",
        "source": "costs.csv",
        "column": "construction_fee",
        "index_columns": [
          "site_id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "build": {
        "description": "1 if tower is built at site s",
        "label": "tower_builds",
        "domain": [
          "Sites"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "covered": {
        "description": "1 if zone z is covered by at least one tower",
        "label": "zone_coverage",
        "domain": [
          "Zones"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "budget_limit": {
        "domain": [],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Sites:s"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "site_fee",
                "indices": [
                  "s"
                ]
              },
              "right": {
                "type": "variable",
                "name": "build",
                "indices": [
                  "s"
                ]
              }
            }
          },
          "right": {
            "type": "parameter",
            "name": "budget",
            "indices": []
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "coverage_link": {
        "domain": [
          "Zones"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "covered",
            "indices": [
              "z"
            ]
          },
          "right": {
            "operation": "indexed_sum",
            "over": [
              "Sites:s"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "covers",
                "indices": [
                  "s",
                  "z"
                ]
              },
              "right": {
                "type": "variable",
                "name": "build",
                "indices": [
                  "s"
                ]
              }
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Zones:z"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "population",
            "indices": [
              "z"
            ]
          },
          "right": {
            "type": "variable",
            "name": "covered",
            "indices": [
              "z"
            ]
          }
        }
      }
    }
  }
