{
  "problem": {
    "title": "Minimax Workload Assignment",
    "description": "Assign tasks to workers such that every task is covered by exactly one worker and the maximum workload (total hours) across all workers is minimised. A scalar auxiliary variable max_load upper-bounds every worker's workload, and the objective minimises it directly.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Maximum workload (hours) across all workers",
    "constraints": [
      {
        "description": "Each task is assigned to exactly one worker"
      },
      {
        "description": "max_load is at least as large as each worker's total hours"
      }
    ],
    "decision_variables": [
      "assign[Workers,Tasks]: 1 if worker w is assigned task t, else 0 (binary)",
      "max_load: maximum workload across all workers (scalar continuous, non-negative)"
    ],
    "parameters": [
      "hours[Tasks]: hours required to complete each task"
    ],
    "additional_notes": "max_load has an empty domain (scalar variable). The objective is to minimise this single scalar variable. Optimal: workers w1,w2,w3 each receive 9 hours of tasks.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "tasks": "tasks.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "workers",
        "element": "w1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "workers",
          "tasks"
        ],
        "element": [
          "w1",
          "w2",
          "w3",
          "t1",
          "t2",
          "t3",
          "t4",
          "t5",
          "t6"
        ]
      }
    },
    "tasks": {
      "columns": {
        "id": "str",
        "hours": "float"
      },
      "sample": {
        "id": "t1",
        "hours": 4.0
      },
      "optional": false,
      "distinct_values": {
        "id": [
          "t1",
          "t2",
          "t3",
          "t4",
          "t5",
          "t6"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "MinimaxWorkload",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Workers": {
        "size": null,
        "index_symbol": "w",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "workers",
        "ordered": false
      },
      "Tasks": {
        "size": null,
        "index_symbol": "t",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "tasks",
        "ordered": false
      }
    },
    "parameters": {
      "hours": {
        "domain": [
          "Tasks"
        ],
        "type": "float",
        "source": "tasks.csv",
        "column": "hours",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "assign": {
        "description": "1 if worker w is assigned task t",
        "label": "task_assignments",
        "domain": [
          "Workers",
          "Tasks"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "max_load": {
        "description": "Maximum workload hours across all workers (scalar auxiliary)",
        "label": "max_workload",
        "domain": [],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "task_covered": {
        "domain": [
          "Tasks"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Workers:w"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "w",
              "t"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "workload_ub": {
        "domain": [
          "Workers"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "max_load",
            "indices": []
          },
          "right": {
            "operation": "indexed_sum",
            "over": [
              "Tasks:t"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "hours",
                "indices": [
                  "t"
                ]
              },
              "right": {
                "type": "variable",
                "name": "assign",
                "indices": [
                  "w",
                  "t"
                ]
              }
            }
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "type": "variable",
        "name": "max_load",
        "indices": []
      }
    }
  },
  "modeling_patterns": [
    "big-M linking",
    "binary variable",
    "scalar variable"
  ]
}