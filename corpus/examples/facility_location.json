        "demand": 80.0
      },
      "optional": false,
      "distinct_values": {
        "id": [
          "c1",
          "c2",
          "c3",
          "c4",
          "c5"
        ],
        "demand": [
          "50.0",
          "60.0",
          "70.0",
          "80.0",
          "90.0"
        ]
      }
    },
    "serve_costs": {
      "columns": {
        "facility_id": "str",
        "customer_id": "str",
        "cost_per_unit": "float"
      },
      "sample": {
        "facility_id": "f1",
        "customer_id": "c1",
        "cost_per_unit": 3.5
      },
      "optional": false,
      "distinct_values": {
        "facility_id": [
          "f1",
          "f2",
          "f3"
        ],
        "customer_id": [
          "c1",
          "c2",
          "c3",
          "c4",
          "c5"
        ],
        "cost_per_unit": [
          "2.0",
          "2.5",
          "3.0",
          "3.5",
          "4.0",
          "4.5",
          "5.0"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "FacilityLocation",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Facilities": {
        "size": null,
        "index_symbol": "f",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "facilities",
        "ordered": false
      },
      "Customers": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "customers",
        "ordered": false
      }
    },
    "parameters": {
      "fixed_cost": {
        "domain": [
          "Facilities"
        ],
        "type": "float",
        "source": "facilities.csv",
        "column": "fixed_cost",
        "index_columns": [
          "id"
        ],
        "missing_default": "inf"
      },
      "serve_cost": {
        "domain": [
          "Facilities",
          "Customers"
        ],
        "type": "float",
        "source": "serve_costs.csv",
        "column": "cost_per_unit",
        "index_columns": [
          "facility_id",
          "customer_id"
        ],
        "missing_default": "inf"
      },
      "demand": {
        "domain": [
          "Customers"
        ],
        "type": "float",
        "source": "customers.csv",
        "column": "demand",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "facility_capacity": {
        "domain": [
          "Facilities"
        ],
        "type": "float",
        "source": "facilities.csv",
        "column": "capacity",
        "index_columns": [
          "id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "open_fac": {
        "description": "1 if facility f is opened, 0 otherwise",
        "label": "open_facilities",
        "domain": [
          "Facilities"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "assign": {
        "description": "Units shipped from facility f to customer c",
        "label": "facility_customer_shipments",
        "domain": [
          "Facilities",
          "Customers"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "serve_cost"
      }
    },
    "constraints": {
      "demand_met": {
        "domain": [
          "Customers"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Facilities:f"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "f",
              "c"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "parameter",
          "name": "demand",
          "indices": [
            "c"
          ]
        }
      },
      "facility_throughput": {
        "domain": [
          "Facilities"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Customers:c"
            ],
            "body": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "f",
                "c"
              ]
            }
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "facility_capacity",
              "indices": [
                "f"
              ]
            },
            "right": {
              "type": "variable",
              "name": "open_fac",
              "indices": [
                "f"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "link_to_open": {
        "domain": [
          "Facilities",
          "Customers"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "f",
              "c"
            ]
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "c"
              ]
            },
            "right": {
              "type": "variable",
              "name": "open_fac",
              "indices": [
                "f"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Facilities:f"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "fixed_cost",
              "indices": [
                "f"
              ]
            },
            "right": {
              "type": "variable",
              "name": "open_fac",
              "indices": [
                "f"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "Facilities:f",
            "Customers:c"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "serve_cost",
              "indices": [
                "f",
                "c"
              ]
            },
            "right": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "f",
                "c"
              ]
            }
          }
        }
      }
    }
  }
