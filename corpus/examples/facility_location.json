        "id": "str",
        "fixed_cost": "float",
        "capacity": "float"
      },
      "sample": {
        "id": "f1",
        "fixed_cost": 500.0,
        "capacity": 300.0
      },
      "optional": false,
      "distinct_values": {
        "id": [
          "f1",
          "f2",
          "f3"
        ],
        "fixed_cost": [
          "400.0",
          "500.0",
          "600.0"
        ],
        "capacity": [
          "250.0",
          "300.0",
          "350.0"
        ]
      }
    },
    "customers": {
      "columns": {
        "id": "str",
        "demand": "float"
      },
