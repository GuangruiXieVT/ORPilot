{
  "problem": {
    "title": "Capacitated Facility Location",
    "description": "A retailer is deciding which distribution facilities to open in order to serve a set of customers. There are several candidate facility locations, each with a known fixed opening cost and a maximum throughput capacity. For each facility-customer pair there is a known per-unit shipping cost. Each customer has a known demand that must be fully served. A facility can only ship to customers if it is open, and its total shipments across all customers cannot exceed its throughput capacity. An open facility may serve any customer, but a closed facility may ship nothing. Choose which facilities to open and how much to ship from each to each customer to minimize total fixed opening costs plus variable shipping costs.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost = fixed opening costs for opened facilities plus per-unit shipping costs times quantities shipped, summed over all facility-customer pairs",
    "constraints": [
      {
        "description": "For each customer, total shipments received from all facilities must exactly equal the customer's demand"
      },
      {
        "description": "For each facility, total shipments to all customers must not exceed the facility's throughput capacity if it is open, or zero if it is closed (big-M linking)"
      },
      {
        "description": "For each facility-customer pair, the amount shipped cannot exceed the customer's demand times whether the facility is open (prevents any flow from a closed facility)"
      }
    ],
    "decision_variables": [
      "open_fac[f]: 1 if facility f is opened, 0 otherwise (binary)",
      "assign[f,c]: units shipped from facility f to customer c (continuous, non-negative)"
    ],
    "parameters": [
      "fixed_cost[f]: one-time fixed cost to open facility f",
      "facility_capacity[f]: maximum total units facility f can ship across all customers",
      "serve_cost[f,c]: per-unit shipping cost from facility f to customer c",
      "demand[c]: units demanded by customer c that must be exactly fulfilled"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "facilities": "facilities.csv",
      "customers": "customers.csv",
      "serve_costs": "serve_costs.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "big-M linking"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "facilities",
        "element": "f1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "facilities",
          "customers"
        ],
        "element": [
          "f1",
          "f2",
          "f3",
          "c1",
          "c2",
          "c3",
          "c4",
          "c5"
        ]
      }
    },
    "facilities": {
