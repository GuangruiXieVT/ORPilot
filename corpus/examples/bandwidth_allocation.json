{
  "problem": {
    "title": "Bandwidth Allocation for Network Sessions",
    "description": "A network operator allocates bandwidth to 4 competing sessions on a shared network with 5 links. Each session has a minimum and maximum bandwidth requirement and traverses a fixed set of links (routing matrix). Each link has a capacity that limits the total bandwidth of all sessions using it. Maximize total allocated bandwidth.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total allocated bandwidth = sum of bandwidth[s] over all sessions",
    "constraints": [
      {
        "description": "Minimum bandwidth: each session receives at least its minimum required rate"
      },
      {
        "description": "Maximum bandwidth: each session receives at most its maximum useful rate"
      },
      {
        "description": "Link capacity: total bandwidth of all sessions using each link must not exceed the link's capacity"
      }
    ],
    "decision_variables": [
      "bandwidth[s]: bandwidth allocated to session s in Mbps (continuous, non-negative)"
    ],
    "parameters": [
      "min_rate[s]: minimum required bandwidth for session s",
      "max_rate[s]: maximum useful bandwidth for session s",
      "link_cap[l]: total capacity of link l",
      "uses_link[s,l]: 1 if session s traverses link l, 0 otherwise (routing matrix)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "sessions": "sessions.csv",
      "links": "links.csv",
      "uses_link": "uses_link.csv"
    }
  },
