{
  "problem": {
    "title": "Capacitated Lot Sizing with Backlogging",
    "description": "A manufacturer produces multiple products on a shared machine over 5 periods, with demand backlogging allowed. Unmet demand is backlogged at a per-unit penalty cost and fulfilled in later periods. A binary setup variable controls whether production runs (incurring a fixed setup cost). Machine capacity is shared across all products. Minimize total production, holding, setup, and backlog penalty costs.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost = production + holding + backlog penalty + setup costs across all products and periods",
    "constraints": [
      {
        "description": "Inventory-backlog balance initialization: net position at first period = produce - demand (zero initial stock)"
      },
      {
        "description": "Inventory-backlog balance: net position change per period = produce - demand (temporal lag)"
      },
      {
        "description": "Setup link: production only occurs if machine is set up (big-M constraint)"
      },
      {
        "description": "Machine capacity: total production across all products per period cannot exceed machine capacity"
      }
    ],
    "decision_variables": [
      "produce[Products, Periods]: units produced (continuous, non-negative)",
      "inventory[Products, Periods]: positive stock at end of period (continuous, non-negative)",
      "backlog[Products, Periods]: unfulfilled demand at end of period (continuous, non-negative)",
      "setup[Products, Periods]: 1 if machine is set up for product p in period t (binary)"
    ],
    "parameters": [
      "demand[Products, Periods]: known demand per product per period",
      "production_cost[Products]: variable production cost per unit",
      "holding_cost[Products]: holding cost per unit per period",
      "backlog_cost[Products]: penalty cost per unit backordered per period",
      "setup_cost[Products]: fixed cost when machine is set up",
      "max_production[Products]: maximum units producible per period if set up (big-M)",
      "machine_capacity: total machine capacity per period (shared)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv",
      "params": "params.csv"
    }
  },
