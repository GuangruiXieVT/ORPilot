{
  "problem": {
    "title": "Battery Energy Storage Arbitrage",
    "description": "A battery storage operator charges and discharges a battery over 12 hourly periods to profit from electricity price differences. Charging consumes energy at the spot price; discharging earns revenue at the spot price. The battery has a maximum state of charge (capacity), maximum charge/discharge rates, and a charging efficiency. Maximize net profit over the 12 periods.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Net revenue = sum over periods of (price * discharge - price * charge)",
    "constraints": [
      {
        "description": "SOC update init: first-period SOC = initial_soc + efficiency*charge[h1] - discharge[h1]"
      },
      {
        "description": "SOC update: SOC[t] = SOC[t-1] + efficiency*charge[t] - discharge[t] (temporal lag)"
      },
      {
        "description": "Charge rate limit: charge[t] <= max_charge_rate"
      },
      {
        "description": "Discharge rate limit: discharge[t] <= max_discharge_rate"
      },
      {
        "description": "Capacity limit: SOC[t] <= capacity"
      }
    ],
    "decision_variables": [
      "charge[Periods]: MWh charged in period t (continuous, non-negative)",
      "discharge[Periods]: MWh discharged in period t (continuous, non-negative)",
      "soc[Periods]: state of charge at end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "price[Periods]: electricity spot price ($/MWh)",
      "max_charge_rate: maximum charge rate per period (MWh)",
      "max_discharge_rate: maximum discharge rate per period (MWh)",
      "capacity: battery energy capacity (MWh)",
      "efficiency: charging efficiency (fraction of energy stored)",
      "initial_soc: state of charge at start of first period"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "price": "price.csv",
      "params": "params.csv"
    }
  },
