{
  "problem": {
    "title": "Financial Cash Flow Management",
    "description": "A company plans borrowing and investment decisions over 8 months. Each month has a known net operating cash flow. The company can borrow short-term at an interest rate or invest surplus cash at a return rate. It must maintain a minimum cash balance each month and stay within a maximum loan limit. Minimize total net interest cost (borrowing cost minus investment return).",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total net interest cost = sum over months of (borrow_rate * loan_balance - invest_rate * invest_balance). Investment balance is capped at max_invest to keep the model bounded.",
    "constraints": [
      {
        "description": "loan_balance_update_init: first-month loan balance equals new borrowing minus repayment"
      },
      {
        "description": "loan_balance_update: each month's loan balance equals previous balance plus new borrowing minus repayment (temporal lag)"
      },
      {
        "description": "invest_balance_update_init: first-month investment balance equals new investment minus withdrawals"
      },
      {
        "description": "invest_balance_update: each month's investment balance equals previous balance plus new investment minus withdrawals (temporal lag)"
      },
      {
        "description": "cash_flow_balance: operating cash flow plus borrowing minus repayment plus withdrawals minus investment must meet minimum cash requirement"
      },
      {
        "description": "max_loan_limit: outstanding loan balance must not exceed maximum loan limit"
      },
      {
        "description": "max_invest_limit: investment portfolio balance must not exceed maximum investment limit"
      }
    ],
    "decision_variables": [
      "borrow[Months]: short-term borrowing in month t (continuous, non-negative)",
      "repay[Months]: loan repayment in month t (continuous, non-negative)",
      "invest[Months]: surplus investment in month t (continuous, non-negative)",
      "withdraw[Months]: investment withdrawal in month t (continuous, non-negative)",
      "loan_balance[Months]: outstanding loan at end of month t (continuous, non-negative)",
      "invest_balance[Months]: investment portfolio at end of month t (continuous, non-negative)"
    ],
    "parameters": [
      "net_cash[Months]: operating cash flow each month (can be negative)",
      "borrow_rate: monthly interest rate on loans (scalar)",
      "invest_rate: monthly return on investments (scalar)",
      "max_loan: maximum outstanding loan balance (scalar)",
      "min_cash: minimum required cash balance each month (scalar)",
      "max_invest: maximum investment portfolio balance each month (scalar)"
    ],
    "additional_notes": "Cash flows: [-50,-30,20,80,60,-40,30,50]. borrow_rate=0.015, invest_rate=0.008, max_loan=200, min_cash=10.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "cashflows": "cashflows.csv",
      "params": "params.csv"
    }
  },
