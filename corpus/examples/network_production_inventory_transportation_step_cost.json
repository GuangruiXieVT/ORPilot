{
  "problem": {
    "title": "Multi-Period Production-Inventory-Distribution Network with Plant Opening and Step Operating Costs",
    "description": "A manufacturer must decide when to activate plants and how to operate a three-tier distribution network over multiple time periods. A plant can be opened in any period; once opened, it remains open for the rest of the planning horizon and cannot be closed. Opening a plant incurs a one-time fixed cost charged in the period it first becomes active. Once a plant is open, it incurs a per-period step operating cost that depends on how much it produces: production is divided into tiers (low, medium, high), each tier covering a range of output levels and carrying a fixed operating cost per period. In each period, a plant operates in exactly one tier (or not at all if not yet opened). Within the selected tier, the actual production quantity can range freely between the tier's lower and upper bounds, and each unit produced also incurs a per-unit production cost. Produced goods are added to plant inventory; a holding cost applies to every unit stored at a plant at period end. Goods are shipped from plants to warehouses and from warehouses to retailers over a sparse set of established arcs, each with a per-unit shipping cost and a per-period arc capacity. Warehouses hold inventory across periods at a holding cost and are limited by a storage capacity. Each retailer has a known demand per period that must be exactly met. The goal is to choose when to open each plant, which production tier each open plant uses each period, how much to produce, and how to route goods through the network to minimize total cost: plant opening costs, step operating costs, per-unit production costs, plant and warehouse holding costs, and transportation costs.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost: one-time plant opening costs, per-period step operating costs based on production tier, per-unit production costs, inventory holding costs at plants and warehouses, and per-unit shipping costs across all arcs and periods",
    "constraints": [
      {
        "description": "For each plant and each subsequent period, the open status in period t must be at least as large as in period t-1: a plant that opens cannot close (monotone non-decreasing open status)"
      },
      {
        "description": "For each plant and period, exactly one production tier must be active if open_plant[i,t]=1, and no tier may be active if open_plant[i,t]=0 (tier selection equals current open status)"
      },
      {
        "description": "Production at plant i in period t must be at least the lower bound of the active tier (production cannot fall below the tier's minimum threshold)"
      },
      {
        "description": "Production at plant i in period t must not exceed the upper bound of the active tier (production cannot exceed the tier's maximum capacity)"
      },
      {
        "description": "Plant inventory balance for the first period: ending inventory at plant i equals initial inventory plus production minus total outgoing shipments to warehouses in period t0"
      },
      {
        "description": "Plant inventory balance for subsequent periods: ending inventory at plant i in period t equals ending inventory in the previous period plus production minus total outgoing shipments"
      },
      {
        "description": "Warehouse inventory balance for the first period: ending inventory at warehouse w equals initial inventory plus inflow from plants minus outflow to retailers in period t0"
      },
      {
        "description": "Warehouse inventory balance for subsequent periods: ending inventory at warehouse w in period t equals ending inventory in the previous period plus inflow from plants minus outflow to retailers"
      },
      {
        "description": "Inventory held at each warehouse at end of each period must not exceed the warehouse storage capacity"
      },
      {
        "description": "For each retailer and period, total inflow from all connected warehouses must exactly equal the retailer's demand"
      },
      {
        "description": "Flow on each plant-to-warehouse arc in each period must not exceed that arc's per-period throughput capacity"
      },
      {
        "description": "Flow on each warehouse-to-retailer arc in each period must not exceed that arc's per-period throughput capacity"
      }
    ],
    "decision_variables": [
      "open_plant[i,t]: 1 if plant i is open in period t, 0 otherwise (binary); once a plant opens it stays open for all subsequent periods; the one-time opening cost is charged in the first period the plant becomes active",
      "use_tier[i,t,k]: 1 if plant i operates at production tier k in period t, 0 otherwise (binary); exactly one tier active per open plant per period",
      "produce[i,t]: units produced at plant i in period t (continuous, non-negative)",
      "inventory_plant[i,t]: inventory held at plant i at end of period t (continuous, non-negative)",
      "inventory_wh[w,t]: inventory held at warehouse w at end of period t (continuous, non-negative)",
      "flow_pw[i,w,t]: units shipped from plant i to warehouse w in period t (continuous, non-negative, defined only for valid arcs)",
      "flow_wr[w,r,t]: units shipped from warehouse w to retailer r in period t (continuous, non-negative, defined only for valid arcs)"
    ],
    "parameters": [
      "opening_cost[i]: one-time fixed cost incurred when plant i is activated",
      "prod_cost[i]: variable production cost per unit produced at plant i",
      "hold_cost_plant[i]: inventory holding cost per unit per period at plant i",
      "initial_inv_plant[i]: inventory at plant i at the start of the planning horizon",
      "tier_lb[i,k]: minimum production quantity required when plant i operates at tier k",
      "tier_ub[i,k]: maximum production quantity allowed when plant i operates at tier k; the highest tier's upper bound is the plant's effective production capacity",
      "tier_op_cost[i,k]: fixed operating cost per period when plant i is in tier k",
      "hold_cost_wh[w]: inventory holding cost per unit per period at warehouse w",
      "wh_capacity[w]: maximum inventory that can be held at warehouse w at end of any period",
      "initial_inv_wh[w]: inventory at warehouse w at the start of the planning horizon",
      "demand[r,t]: units required by retailer r in period t, which must be exactly fulfilled",
      "cost_pw[i,w]: per-unit shipping cost from plant i to warehouse w (defined only for valid arcs)",
      "cost_wr[w,r]: per-unit shipping cost from warehouse w to retailer r (defined only for valid arcs)",
      "cap_pw[i,w]: per-period arc capacity from plant i to warehouse w (defined only for valid arcs)",
      "cap_wr[w,r]: per-period arc capacity from warehouse w to retailer r (defined only for valid arcs)"
    ],
    "additional_notes": "The step operating cost models economies of scale at plant level: a low-volume tier incurs a small fixed cost per period; a high-volume tier incurs a large fixed cost but permits higher output. Each unit also incurs a per-unit production cost on top of the tier's fixed cost. Plants with initial_inventory=0 cannot ship unless opened, since the inventory balance prevents flow without production. Arc parameters are defined only for established shipping lanes.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "plant_tiers": "plant_tiers.csv",
      "warehouses": "warehouses.csv",
      "demand_data": "demand_data.csv",
      "arc_costs_pw": "arc_costs_pw.csv",
      "arc_costs_wr": "arc_costs_wr.csv",
      "arc_caps_pw": "arc_caps_pw.csv",
      "arc_caps_wr": "arc_caps_wr.csv"
    }
  },
