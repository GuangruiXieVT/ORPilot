{
  "problem": {
    "title": "Multi-Customer Multi-Product Inventory with Safety Stock",
    "description": "A central warehouse stocks multiple products and serves multiple retail customers over a multi-period planning horizon. Each customer has a known per-period demand for each product that must be fully met from the warehouse. The warehouse places replenishment orders each period at a per-unit ordering cost. Inventory held at the end of each period incurs a per-unit holding cost. Each product has a minimum safety stock level that must be maintained at the end of every period as a buffer against uncertainty. The warehouse has a shared total storage capacity: the combined ending inventory of all products in any period cannot exceed this limit. Determine the ordering plan across all products and periods that minimizes total ordering and holding costs while meeting all customer demands, honoring safety stock requirements, and never violating the shared storage capacity.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of per-unit ordering costs times units ordered plus per-unit holding costs times ending inventory, summed across all products and periods",
    "constraints": [
      {
        "description": "For each product in the first period, ending inventory equals the product's initial inventory plus the order quantity minus total demand from all customers (inventory balance initialization)"
      },
      {
        "description": "For each product in each subsequent period, ending inventory equals the previous period's ending inventory plus the order quantity minus total demand from all customers (temporal lag inventory balance)"
      },
      {
        "description": "For each product in each period, the ending inventory must be at least the product's safety stock level"
      },
      {
        "description": "For each period, the total ending inventory across all products must not exceed the warehouse's shared storage capacity"
      }
    ],
    "decision_variables": [
      "order[p,t]: units of product p ordered at the start of period t (continuous, non-negative)",
      "inventory[p,t]: units of product p in inventory at the end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[c,p,t]: known demand of customer c for product p in period t",
      "order_cost[p]: per-unit ordering cost for product p",
      "holding_cost[p]: per-unit holding cost for product p carried between periods",
      "initial_inventory[p]: units of product p on hand at the start of the planning horizon",
      "safety_stock[p]: minimum ending inventory that must be maintained for product p in every period",
      "warehouse_capacity: maximum total units of all products that can be stored simultaneously"
    ],
    "additional_notes": "The inventory balance constraint sums demand across all customers to compute total outflow per product per period. The temporal lag links adjacent periods per product. The safety stock floor constraint adds a lower bound on inventory beyond the non-negativity bound, ensuring a buffer is always maintained.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv",
      "warehouse": "warehouse.csv"
    }
  },
  "ir_patterns": [
    "ordered set",
    "temporal lag",
    "init constraint",
    "scalar parameter"
  ],
