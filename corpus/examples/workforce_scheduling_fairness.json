{
  "problem": {
    "title": "Workforce Scheduling with Fairness",
    "description": "Schedule nurses across shifts and days with fairness. Coverage requirements must be met. Each nurse works at most one shift per day. Total shifts are counted; deviation from the target is penalized. Preferences are honored where possible. Minimize fairness penalty minus preference score.",
    "problem_type": "mixed_integer_program",
    "objective": "minimize",
    "objective_description": "Total deviation from target shifts minus total preference score",
    "constraints": [
      {
        "description": "Minimum nurses per shift-day must be met"
      },
      {
        "description": "Each nurse works at most one shift per day"
      },
      {
        "description": "Total shifts for each nurse are counted"
      },
      {
        "description": "Deviation variables capture excess/deficit from target"
      }
    ],
    "decision_variables": [
      "work[n,s,d]: 1 if nurse n works shift s on day d (binary)",
      "total_shifts[n]: total shifts worked this week",
      "excess[n]: shifts above target (continuous >= 0)",
      "deficit[n]: shifts below target (continuous >= 0)"
    ],
    "parameters": [
      "min_nurses[s,d]: minimum nurses needed per shift-day",
      "max_per_day[n]: max shifts per nurse per day (all 1)",
      "preference[n,s,d]: preference score (sparse)",
      "target_shifts: target weekly shifts per nurse"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "coverage": "coverage.csv",
      "nurses": "nurses.csv",
      "preferences": "preferences.csv",
      "params": "params.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "deviation variables",
    "fairness penalty",
    "sparse preference parameter"
  ],
