{
  "problem": {
    "title": "Empty Container Transport Cost Minimization (Italy)",
    "description": "An Italian transportation company moves empty containers from 6 warehouses to 5 ports using trucks. Each truck carries at most 2 containers and costs 30 EUR per km. Warehouse supply: Verona=10, Perugia=12, Rome=20, Pescara=24, Taranto=18, Lamezia=40 containers. Port demand: Genoa=20, Venice=15, Ancona=25, Naples=33, Bari=21. Minimize total truck cost.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total transport cost = sum over all warehouse-port pairs of 30*distance[w,p] * trucks[w,p]",
    "constraints": [
      {
        "description": "Total containers shipped from each warehouse cannot exceed its supply"
      },
      {
        "description": "Total containers received at each port must meet its demand"
      },
      {
        "description": "Number of trucks on each route covers the containers (at most 2 containers per truck): containers[w,p] <= 2 * trucks[w,p]"
      }
    ],
    "decision_variables": [
      "containers[w,p]: integer number of containers shipped from warehouse w to port p",
      "trucks[w,p]: integer number of trucks used from warehouse w to port p"
    ],
    "parameters": [
      "supply[w]: container supply at warehouse w",
      "demand[p]: container demand at port p",
      "truck_cost[w,p]: cost per truck from warehouse w to port p (= 30 * distance_km)"
    ],
    "additional_notes": "IP formulation: trucks are integer, each carries at most 2 containers. Objective uses truck_cost (30*distance) times number of trucks. Optimal: verona->venice 5 trucks (10 containers), taranto->bari 1 truck (2 containers), etc. Expected obj=468510.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "supply": "supply.csv",
      "demand": "demand.csv",
      "truck_cost": "truck_cost.csv"
    }
  },
