        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "before": {
        "description": "1 if job i is processed before job j on machine m",
        "label": "ordering_decisions",
        "domain": [
