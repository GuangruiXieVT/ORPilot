        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "deviation_balance": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "produce",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "shortfall",
              "indices": [
                "p"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "surplus",
            "indices": [
              "p"
