            "indices": [
              "p"
            ]
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Products:p"
        ],
        "body": {
          "operation": "sum",
          "left": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "over_penalty",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "surplus",
              "indices": [
                "p"
              ]
            }
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "under_penalty",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
