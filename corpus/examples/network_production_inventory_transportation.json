{
  "problem": {
    "title": "Multi-Period Production-Inventory-Distribution Network",
    "description": "A manufacturer operates a three-tier distribution network — plants, warehouses, and retailers — over multiple time periods. At each plant, a manager decides how many units to produce each period subject to a per-period production capacity. Produced goods add to plant inventory; a per-unit holding cost is charged for every unit stored at a plant at each period end. From each plant, goods are shipped to warehouses over established lanes (a sparse arc set), each with a per-unit shipping cost and a per-period throughput capacity. Warehouses carry inventory across periods at a per-unit holding cost and are limited by a storage capacity constraint. From each warehouse, goods are forwarded to retailers over another sparse set of established lanes, each with a per-unit shipping cost and a per-period arc capacity. Each retailer has a deterministic demand per period that must be exactly fulfilled. The goal is to choose production quantities, inter-tier shipments, and ending inventory levels at each plant and warehouse to minimize total cost: production costs, plant and warehouse holding costs, and transportation costs across all arcs and periods.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost: production costs at plants, inventory holding costs at plants and warehouses, and per-unit shipping costs on all plant-to-warehouse and warehouse-to-retailer arcs, summed across all valid arcs and periods",
    "constraints": [
      {
        "description": "Plant inventory balance for the first period: ending inventory at plant i equals initial inventory plus production minus total shipments out to warehouses in period t0"
      },
      {
        "description": "Plant inventory balance for subsequent periods: ending inventory at plant i in period t equals ending inventory in the previous period plus production minus total shipments out to warehouses"
      },
      {
        "description": "Warehouse inventory balance for the first period: ending inventory at warehouse w equals initial inventory plus total inflow from plants minus total outflow to retailers in period t0"
      },
      {
        "description": "Warehouse inventory balance for subsequent periods: ending inventory at warehouse w in period t equals ending inventory in the previous period plus total inflow from plants minus total outflow to retailers"
      },
      {
        "description": "Production at each plant in each period must not exceed the plant's per-period production capacity"
      },
      {
        "description": "Inventory held at each warehouse at the end of each period must not exceed the warehouse's storage capacity"
      },
      {
        "description": "For each retailer and period, total inflow from all connected warehouses must exactly equal the retailer's demand"
      },
      {
        "description": "Flow on each plant-to-warehouse arc in each period must not exceed that arc's per-period throughput capacity"
      },
      {
        "description": "Flow on each warehouse-to-retailer arc in each period must not exceed that arc's per-period throughput capacity"
      }
    ],
    "decision_variables": [
      "produce[i,t]: units produced at plant i in period t (continuous, non-negative)",
      "inventory_plant[i,t]: inventory held at plant i at end of period t (continuous, non-negative)",
      "inventory_wh[w,t]: inventory held at warehouse w at end of period t (continuous, non-negative)",
      "flow_pw[i,w,t]: units shipped from plant i to warehouse w in period t (continuous, non-negative, defined only for valid arcs)",
      "flow_wr[w,r,t]: units shipped from warehouse w to retailer r in period t (continuous, non-negative, defined only for valid arcs)"
    ],
    "parameters": [
      "prod_cost[i]: production cost per unit at plant i",
      "prod_capacity[i]: maximum units that can be produced at plant i in any single period",
      "hold_cost_plant[i]: inventory holding cost per unit per period at plant i",
      "initial_inv_plant[i]: inventory held at plant i at the start of the planning horizon (before period t0)",
      "hold_cost_wh[w]: inventory holding cost per unit per period at warehouse w",
      "wh_capacity[w]: maximum inventory units that can be stored at warehouse w at the end of any period",
      "initial_inv_wh[w]: inventory held at warehouse w at the start of the planning horizon",
      "demand[r,t]: units required by retailer r in period t, which must be exactly fulfilled",
      "cost_pw[i,w]: per-unit shipping cost from plant i to warehouse w (defined only for valid arcs)",
      "cost_wr[w,r]: per-unit shipping cost from warehouse w to retailer r (defined only for valid arcs)",
      "cap_pw[i,w]: maximum units shippable from plant i to warehouse w in a single period (defined only for valid arcs)",
      "cap_wr[w,r]: maximum units shippable from warehouse w to retailer r in a single period (defined only for valid arcs)"
    ],
    "additional_notes": "Arc parameters are defined only for established shipping lanes; missing entries indicate no arc between that pair. The inventory balance constraints link consecutive periods: the init variant handles t=t0 using the exogenous initial inventory as the prior-period state, and the lag variant handles t>t0 using the prior period's ending inventory variable.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "warehouses": "warehouses.csv",
      "demand_data": "demand_data.csv",
      "arc_costs_pw": "arc_costs_pw.csv",
      "arc_costs_wr": "arc_costs_wr.csv",
      "arc_caps_pw": "arc_caps_pw.csv",
      "arc_caps_wr": "arc_caps_wr.csv"
    }
  },
