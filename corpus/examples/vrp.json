{
  "problem": {
    "title": "Capacitated Vehicle Routing Problem (CVRP) with MTZ Subtour Elimination",
    "description": "A delivery company must route a fleet of vehicles from a central depot to serve a set of customers, then return to the depot. Each customer has a known demand. Each vehicle has a fixed load capacity — the total demand of all customers on a vehicle's route cannot exceed its capacity. The travel distance (cost) between every pair of locations (depot and customers) is known. Each customer must be visited exactly once by exactly one vehicle. Subtour elimination is enforced via Miller-Tucker-Zemlin (MTZ) constraints using integer position variables. Find the set of routes — one per vehicle — that minimizes total travel distance while serving all customers within vehicle capacity.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total travel distance across all activated arcs (vehicle routes), summed over all vehicle-arc combinations",
    "constraints": [
      {
        "description": "Each customer must be visited exactly once across all vehicles and all incoming arcs"
      },
      {
        "description": "For each location and vehicle, the number of arcs entering that location equals the number leaving (flow conservation)"
      },
      {
        "description": "Each vehicle departs the depot at most once (depot departure)"
      },
      {
        "description": "Each vehicle returns to the depot at most once (depot return)"
      },
      {
        "description": "For each vehicle, the total demand of all customers visited must not exceed the vehicle's load capacity"
      },
      {
        "description": "MTZ subtour elimination: for each pair of distinct customers and each vehicle, if vehicle v travels directly from customer c1 to c2, then the visit position of c2 must be at least one more than c1's position, preventing subtours"
      }
    ],
    "decision_variables": [
      "y[l1,l2,v]: 1 if vehicle v travels directly from location l1 to location l2, 0 otherwise (binary, self-loops excluded)",
      "u[c,v]: visit position of customer c in vehicle v's route, used for MTZ subtour elimination (integer, lower bound 1)"
    ],
    "parameters": [
      "distance[l1,l2]: travel distance from location l1 to location l2",
      "demand[c]: units of goods required by customer c",
      "vehicle_capacity: maximum load each vehicle can carry (uniform across all vehicles)"
    ],
    "additional_notes": "Locations includes the depot (first element) and all customers. Customers is a subset of Locations. depot_departure and depot_return use <= 1 (not = 1) to allow vehicles to remain unused.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "distances": "distances.csv",
      "customers": "customers.csv",
      "vehicles": "vehicles.csv"
    }
  },
