{
  "problem": {
    "title": "Mining Production Planning",
    "description": "A mine plans ore extraction over 5 periods. Different ore grades are available. Processing capacity limits total extraction per period. Extracted ore must meet minimum blended grade. Maximize total profit (revenue minus processing cost).",
    "problem_type": "linear_program",
    "objective": "maximize",
    "objective_description": "Total profit from ore extraction across all ore types and periods",
    "constraints": [
      {
        "description": "Extraction does not exceed available reserves per ore type and period"
      },
      {
        "description": "Total extraction does not exceed processing capacity per period"
      },
      {
        "description": "Blended ore meets minimum grade requirement per period"
      }
    ],
    "decision_variables": [
      "extract[ot,t]: tonnes of ore type ot extracted in period t (continuous >= 0)"
    ],
    "parameters": [
      "reserve[ot,t]: available tonnes per ore type per period",
      "grade[ot]: metal content fraction per ore type",
      "unit_process_cost[ot]: processing cost per tonne",
      "process_capacity[t]: max total extraction per period",
      "sell_price: revenue per tonne of blended ore",
      "min_grade: minimum acceptable metal content in blended ore"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "reserves": "reserves.csv",
      "grades": "grades.csv",
      "process_costs": "process_costs.csv",
      "capacity": "capacity.csv",
      "params": "params.csv"
    }
  },
  "ir_patterns": [
    "LP",
    "scalar parameter",
    "multiply(subtract(param, scalar_param), var) in objective",
    "grade blending constraint"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "ore_types",
        "element": "high_grade"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "ore_types",
          "periods"
        ],
        "element": [
          "high_grade",
          "mid_grade",
          "low_grade",
          "p1",
          "p2",
          "p3",
          "p4",
          "p5"
        ]
      }
    },
    "reserves": {
      "columns": {
        "ore_type": "str",
        "period_id": "str",
        "reserve": "float"
      },
      "sample": {
        "ore_type": "high_grade",
        "period_id": "p1",
        "reserve": 500.0
      },
      "optional": false,
      "distinct_values": {
        "ore_type": [
          "high_grade",
          "mid_grade",
          "low_grade"
        ],
        "period_id": [
          "p1",
          "p2",
          "p3",
          "p4",
          "p5"
        ]
      }
    },
    "grades": {
      "columns": {
        "ore_type": "str",
        "grade": "float"
      },
      "sample": {
        "ore_type": "high_grade",
        "grade": 0.7
      },
      "optional": false,
      "distinct_values": {
        "ore_type": [
          "high_grade",
          "mid_grade",
          "low_grade"
        ]
      }
    },
    "process_costs": {
      "columns": {
        "ore_type": "str",
        "unit_process_cost": "float"
      },
      "sample": {
        "ore_type": "high_grade",
        "unit_process_cost": 30.0
      },
      "optional": false,
      "distinct_values": {
        "ore_type": [
          "high_grade",
          "mid_grade",
          "low_grade"
        ]
      }
    },
    "capacity": {
      "columns": {
        "period_id": "str",
        "process_capacity": "float"
      },
      "sample": {
        "period_id": "p1",
        "process_capacity": 1500.0
      },
      "optional": false,
      "distinct_values": {
        "period_id": [
          "p1",
          "p2",
          "p3",
          "p4",
          "p5"
        ]
      }
    },
    "params": {
      "columns": {
        "sell_price": "float",
        "min_grade": "float"
      },
      "sample": {
        "sell_price": 100.0,
        "min_grade": 0.35
      },
      "optional": false,
      "distinct_values": {}
    }
  },
  "ir": {
    "problem_class": "MiningProductionPlanning",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "OreTypes": {
        "size": null,
        "index_symbol": "ot",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "ore_types",
        "ordered": false
      },
      "Periods": {
        "size": null,
        "index_symbol": "t",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "periods",
        "ordered": true
      }
    },
    "parameters": {
      "reserve": {
        "domain": [
          "OreTypes",
          "Periods"
        ],
        "type": "float",
        "source": "reserves.csv",
        "column": "reserve",
        "index_columns": [
          "ore_type",
          "period_id"
        ],
        "missing_default": "zero"
      },
      "grade": {
        "domain": [
          "OreTypes"
        ],
        "type": "float",
        "source": "grades.csv",
        "column": "grade",
        "index_columns": [
          "ore_type"
        ],
        "missing_default": "zero"
      },
      "unit_process_cost": {
        "domain": [
          "OreTypes"
        ],
        "type": "float",
        "source": "process_costs.csv",
        "column": "unit_process_cost",
        "index_columns": [
          "ore_type"
        ],
        "missing_default": "inf"
      },
      "process_capacity": {
        "domain": [
          "Periods"
        ],
        "type": "float",
        "source": "capacity.csv",
        "column": "process_capacity",
        "index_columns": [
          "period_id"
        ],
        "missing_default": "inf"
      },
      "sell_price": {
        "domain": [],
        "type": "float",
        "source": "params.csv",
        "column": "sell_price",
        "missing_default": "zero"
      },
      "min_grade": {
        "domain": [],
        "type": "float",
        "source": "params.csv",
        "column": "min_grade",
        "missing_default": "zero"
      }
    },
    "variables": {
      "extract": {
        "description": "Tonnes of ore type ot extracted in period t",
        "label": "ore_extraction",
        "domain": [
          "OreTypes",
          "Periods"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "reserve_limit": {
        "domain": [
          "OreTypes",
          "Periods"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "extract",
            "indices": [
              "ot",
              "t"
            ]
          },
          "right": {
            "type": "parameter",
            "name": "reserve",
            "indices": [
              "ot",
              "t"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "process_cap": {
        "domain": [
          "Periods"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "OreTypes:ot"
            ],
            "body": {
              "type": "variable",
              "name": "extract",
              "indices": [
                "ot",
                "t"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "process_capacity",
            "indices": [
              "t"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "grade_requirement": {
        "domain": [
          "Periods"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "OreTypes:ot"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "operation": "subtract",
              "left": {
                "type": "parameter",
                "name": "grade",
                "indices": [
                  "ot"
                ]
              },
              "right": {
                "type": "parameter",
                "name": "min_grade",
                "indices": []
              }
            },
            "right": {
              "type": "variable",
              "name": "extract",
              "indices": [
                "ot",
                "t"
              ]
            }
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "OreTypes:ot",
          "Periods:t"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "operation": "subtract",
            "left": {
              "type": "parameter",
              "name": "sell_price",
              "indices": []
            },
            "right": {
              "type": "parameter",
              "name": "unit_process_cost",
              "indices": [
                "ot"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "extract",
            "indices": [
              "ot",
              "t"
            ]
          }
        }
      }
    }
  }
}
