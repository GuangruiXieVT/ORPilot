{
  "problem": {
    "title": "Generation Expansion Planning",
    "description": "A utility decides when to build new generation capacity of three types (coal, gas, solar) over a 5-year planning horizon. Once built, capacity is permanent (it accumulates over time via a lag-based balance). Each year, total generation must meet energy demand. Minimize total investment plus operating costs.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of build_cost[g]*max_build[g]*build[g,y] (investment) + fuel_cost[g]*generate[g,y] (operating) over all generator types and years",
    "constraints": [
      {
        "description": "Capacity balance init: first-year capacity equals initial capacity plus new build in year 1"
      },
      {
        "description": "Capacity balance: each year's capacity equals previous year's capacity plus new build (temporal lag)"
      },
      {
        "description": "Generation limit: annual generation cannot exceed installed capacity"
      },
      {
        "description": "Demand met: total generation across all types meets annual demand"
      }
    ],
    "decision_variables": [
      "build[g,y]: 1 if new capacity of type g is built in year y (binary)",
      "capacity[g,y]: cumulative installed capacity (MW) of type g in year y (continuous)",
      "generate[g,y]: energy produced (MWh) by type g in year y (continuous)"
    ],
    "parameters": [
      "build_cost[g]: investment cost per unit of capacity built ($/MW)",
      "fuel_cost[g]: operating cost per unit of energy produced ($/MWh)",
      "max_build[g]: maximum capacity buildable in one year (MW)",
      "initial_capacity[g]: starting installed capacity before planning horizon (MW)",
      "demand[y]: annual energy demand that must be met (MWh)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "gen_types": "gen_types.csv",
      "demand": "demand.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "gen_types",
        "element": "coal"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "gen_types",
          "years"
        ],
        "element": [
          "coal",
          "gas",
          "solar",
          "y1",
          "y2",
          "y3",
          "y4",
          "y5"
        ]
      },
      "row_count": 8
    },
    "gen_types": {
      "columns": {
        "gen_type": "str",
        "build_cost": "float",
        "fuel_cost": "float",
        "max_build": "float",
        "initial_capacity": "float"
      },
      "sample": {
        "gen_type": "coal",
        "build_cost": 1500.0,
        "fuel_cost": 30.0,
        "max_build": 200.0,
        "initial_capacity": 500.0
      },
      "optional": false,
      "distinct_values": {
        "gen_type": [
          "coal",
