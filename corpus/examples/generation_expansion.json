          "solar"
        ],
        "build_cost": [
          "1500.0",
          "800.0",
          "600.0"
        ],
        "fuel_cost": [
          "30.0",
          "50.0",
          "0.0"
        ],
        "max_build": [
          "200.0",
          "150.0",
          "100.0"
        ],
        "initial_capacity": [
          "500.0",
          "300.0",
          "0.0"
        ]
      },
      "row_count": 3
    },
    "demand": {
      "columns": {
        "year": "str",
        "demand": "float"
      },
      "sample": {
        "year": "y1",
        "demand": 900.0
      },
      "optional": false,
      "distinct_values": {
        "year": [
          "y1",
          "y2",
          "y3",
          "y4",
          "y5"
        ],
        "demand": [
          "900.0",
          "1000.0",
          "1100.0",
