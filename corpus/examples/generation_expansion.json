          "1300.0"
        ]
      },
      "row_count": 5
    }
  },
  "ir": {
    "problem_class": "GenerationExpansion",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "GenTypes": {
        "size": null,
        "index_symbol": "g",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "gen_types",
        "ordered": false
      },
      "Years": {
        "size": null,
        "index_symbol": "y",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "years",
        "ordered": true
      }
    },
    "parameters": {
      "build_cost": {
        "domain": [
          "GenTypes"
        ],
        "type": "float",
        "source": "gen_types.csv",
        "column": "build_cost",
        "index_columns": [
          "gen_type"
        ],
        "missing_default": "inf"
      },
      "fuel_cost": {
        "domain": [
          "GenTypes"
        ],
        "type": "float",
        "source": "gen_types.csv",
        "column": "fuel_cost",
        "index_columns": [
          "gen_type"
        ],
        "missing_default": "inf"
      },
      "max_build": {
        "domain": [
          "GenTypes"
        ],
        "type": "float",
        "source": "gen_types.csv",
        "column": "max_build",
        "index_columns": [
          "gen_type"
        ],
        "missing_default": "zero"
      },
      "initial_capacity": {
        "domain": [
          "GenTypes"
        ],
        "type": "float",
        "source": "gen_types.csv",
        "column": "initial_capacity",
        "index_columns": [
          "gen_type"
        ],
        "missing_default": "inf"
      },
      "demand": {
        "domain": [
          "Years"
        ],
        "type": "float",
        "source": "demand.csv",
        "column": "demand",
        "index_columns": [
          "year"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "build": {
        "description": "1 if new capacity of type g is built in year y",
        "label": "build_decisions",
        "domain": [
          "GenTypes",
          "Years"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "capacity": {
        "description": "Cumulative installed capacity (MW) of type g in year y",
        "label": "installed_capacity",
        "domain": [
          "GenTypes",
          "Years"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "generate": {
        "description": "Energy produced by type g in year y",
        "label": "generation_output",
        "domain": [
          "GenTypes",
          "Years"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "capacity_balance_init": {
        "domain": [
          "GenTypes"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "capacity",
            "indices": [
              "g",
              "Years[0]"
            ]
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "initial_capacity",
              "indices": [
                "g"
              ]
            },
            "right": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "max_build",
                "indices": [
                  "g"
                ]
              },
              "right": {
                "type": "variable",
                "name": "build",
                "indices": [
                  "g",
                  "Years[0]"
                ]
              }
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "capacity_balance": {
        "domain": [
          "GenTypes",
          "Years"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "capacity",
            "indices": [
              "g",
              "y"
            ]
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "capacity",
              "indices": [
                "g",
                "y"
              ],
              "lag": -1
            },
            "right": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "max_build",
                "indices": [
                  "g"
                ]
              },
              "right": {
                "type": "variable",
                "name": "build",
                "indices": [
                  "g",
                  "y"
                ]
              }
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "generate_limit": {
        "domain": [
          "GenTypes",
          "Years"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "generate",
            "indices": [
              "g",
              "y"
            ]
          },
          "right": {
            "type": "variable",
            "name": "capacity",
            "indices": [
              "g",
              "y"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "demand_met": {
        "domain": [
          "Years"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "GenTypes:g"
            ],
            "body": {
              "type": "variable",
              "name": "generate",
              "indices": [
                "g",
                "y"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "demand",
            "indices": [
              "y"
            ]
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "GenTypes:g",
          "Years:y"
        ],
        "body": {
          "operation": "sum",
          "left": {
            "operation": "multiply",
            "left": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "build_cost",
                "indices": [
                  "g"
                ]
              },
              "right": {
                "type": "parameter",
                "name": "max_build",
                "indices": [
                  "g"
                ]
              }
            },
            "right": {
              "type": "variable",
              "name": "build",
              "indices": [
                "g",
                "y"
              ]
            }
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "fuel_cost",
              "indices": [
                "g"
              ]
            },
            "right": {
              "type": "variable",
              "name": "generate",
              "indices": [
                "g",
                "y"
              ]
            }
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "big-M linking",
    "binary variable",
    "init constraint",
    "temporal lag"
  ]
}