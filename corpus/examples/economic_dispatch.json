{
  "problem": {
    "title": "Economic Dispatch with Ramp Rate Constraints",
    "description": "All generators are online. Allocate generation output each period to meet power demand at minimum fuel cost. Ramp rate constraints limit how quickly each generator can change its output between consecutive periods. Minimize total fuel cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total fuel cost = sum of fuel_cost[g]*generate[g,t] over all generators and periods",
    "constraints": [
      {
        "description": "Power balance: total generation across all generators equals demand each period"
      },
      {
        "description": "Minimum generation: each generator produces at least min_output each period"
      },
      {
        "description": "Maximum generation: each generator produces at most max_output each period"
      },
      {
        "description": "Ramp up init: first-period output is bounded by min_output (no previous state constraint)"
      },
      {
        "description": "Ramp up: increase in output from previous period cannot exceed ramp_limit (temporal lag)"
      },
      {
        "description": "Ramp down: decrease in output from previous period cannot exceed ramp_limit (temporal lag)"
      }
    ],
    "decision_variables": [
      "generate[g,t]: MW output of generator g in period t (continuous, non-negative)"
    ],
    "parameters": [
      "fuel_cost[g]: cost per MWh for generator g",
      "min_output[g]: minimum MW output for generator g",
      "max_output[g]: maximum MW output for generator g",
      "ramp_limit[g]: maximum change in MW output per period for generator g",
      "demand[t]: MW demand in period t"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "generators": "generators.csv",
      "demand": "demand.csv"
    }
  },
  "ir_patterns": [
    "ordered set",
    "temporal lag",
    "init constraint"
  ],
  "csv_schemas": {
