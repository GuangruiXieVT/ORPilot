      }
    }
  },
  "ir": {
    "problem_class": "SingleSourceSupplierSelection",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Suppliers": {
        "size": null,
        "index_symbol": "s",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "suppliers",
        "ordered": false
      },
      "Factories": {
        "size": null,
        "index_symbol": "f",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "factories",
        "ordered": false
      }
    },
    "parameters": {
      "unit_cost": {
        "domain": [
          "Suppliers",
          "Factories"
        ],
        "type": "float",
        "source": "sourcing_costs.csv",
        "column": "cost_per_unit",
        "index_columns": [
          "supplier_id",
          "factory_id"
        ],
        "missing_default": "inf"
      },
      "demand": {
        "domain": [
          "Factories"
        ],
        "type": "float",
        "source": "factories.csv",
        "column": "demand",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "supply_capacity": {
        "domain": [
          "Suppliers"
        ],
        "type": "float",
        "source": "suppliers.csv",
        "column": "capacity",
        "index_columns": [
          "id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "source_from": {
        "description": "1 if factory f is assigned to source from supplier s, 0 otherwise",
        "label": "source_assignments",
        "domain": [
          "Suppliers",
          "Factories"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "flow": {
        "description": "Quantity of material shipped from supplier s to factory f",
        "label": "sourcing_flows",
        "domain": [
          "Suppliers",
          "Factories"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "unit_cost"
      }
    },
    "constraints": {
      "single_source": {
        "domain": [
          "Factories"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Suppliers:s"
          ],
          "body": {
            "type": "variable",
            "name": "source_from",
            "indices": [
              "s",
              "f"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "demand_met": {
        "domain": [
          "Factories"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Suppliers:s"
          ],
          "body": {
            "type": "variable",
            "name": "flow",
            "indices": [
              "s",
              "f"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "parameter",
          "name": "demand",
          "indices": [
            "f"
          ]
        }
      },
      "supplier_capacity": {
        "domain": [
          "Suppliers"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Factories:f"
          ],
          "body": {
            "type": "variable",
            "name": "flow",
            "indices": [
              "s",
              "f"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "supply_capacity",
          "indices": [
            "s"
          ]
        }
      },
      "flow_link_upper": {
        "domain": [
          "Suppliers",
          "Factories"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "flow",
            "indices": [
              "s",
              "f"
            ]
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "f"
              ]
            },
            "right": {
              "type": "variable",
              "name": "source_from",
              "indices": [
                "s",
                "f"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Suppliers:s",
          "Factories:f"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "unit_cost",
            "indices": [
              "s",
              "f"
            ]
          },
          "right": {
