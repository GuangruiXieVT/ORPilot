{
  "problem": {
    "title": "Single-Source Supplier Selection",
    "description": "A manufacturer must source raw materials for a set of factories from a set of approved suppliers. Due to a quality-control policy, each factory must source all of its material from exactly one supplier — split orders across multiple suppliers are not allowed. Each supplier has a total supply capacity that limits the total quantity it can ship to all factories. The unit sourcing cost from each supplier to each factory is known. Choose which supplier serves each factory and how much is shipped to minimize total sourcing cost, while satisfying all factory demands, respecting supplier capacities, and enforcing the single-source assignment rule.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total sourcing cost = sum of per-unit costs times quantities shipped, over all supplier-factory pairs",
    "constraints": [
      {
        "description": "Each factory must be assigned to exactly one supplier (single-source constraint)"
      },
      {
        "description": "For each factory, total material received from all suppliers must exactly equal the factory's demand"
      },
      {
        "description": "For each supplier, total quantity shipped to all factories must not exceed the supplier's capacity"
      },
      {
        "description": "For each supplier-factory pair, quantity shipped cannot exceed the factory's demand times whether that supplier is assigned to that factory (big-M flow linking: no flow from an unassigned supplier)"
      }
    ],
    "decision_variables": [
      "source_from[s,f]: 1 if factory f is assigned to source from supplier s, 0 otherwise (binary)",
      "flow[s,f]: quantity of material shipped from supplier s to factory f (continuous, non-negative)"
    ],
    "parameters": [
      "unit_cost[s,f]: per-unit sourcing cost from supplier s to factory f",
      "demand[f]: total material required by factory f",
      "supply_capacity[s]: maximum total quantity supplier s can ship to all factories"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "suppliers": "suppliers.csv",
      "factories": "factories.csv",
      "sourcing_costs": "sourcing_costs.csv"
    }
  },
  "csv_schemas": {
    "sets": {
