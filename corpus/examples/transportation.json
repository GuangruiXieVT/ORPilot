{
  "problem": {
    "title": "Multi-Product Multi-Period Regional Distribution",
    "description": "A regional distribution company ships two product types (Product A and Product B) from three warehouses to four retail customers over three time periods. Due to geographic constraints, only eight of the twelve possible warehouse-customer routes have established shipping lanes, and the same set of routes is used for all products and periods. Each route has a fixed per-unit shipping cost that does not vary by product or period. Each warehouse has a known supply capacity for each product in each period. Each customer has a fixed demand for each product in each period that must be exactly fulfilled. Determine how much of each product to ship along each available route in each period to fulfill all customer demands without exceeding warehouse supplies, at minimum total shipping cost.",
    "problem_type": "transportation",
    "objective": "minimize",
    "objective_description": "Total shipping cost summed over all valid routes, products, and periods, weighted by the amount shipped",
    "constraints": [
      {
        "description": "For each warehouse, product, and period, the total amount of that product shipped out across all valid routes must not exceed the warehouse's supply of that product in that period"
      },
      {
        "description": "For each customer, product, and period, the total amount of that product shipped in from any warehouse via valid routes must exactly equal the customer's demand for that product in that period"
      }
    ],
    "decision_variables": [
      "ship[w,c,p,t]: amount of product p shipped from warehouse w to customer c in period t (continuous, non-negative, defined only for valid warehouse-customer routes)"
    ],
    "parameters": [
      "transport_cost[w,c]: cost per unit shipped from warehouse w to customer c, shared across all products and periods (defined only for the subset of valid routes)",
      "supply[w,p,t]: supply of product p available at warehouse w in period t",
      "demand[c,p,t]: demand for product p required by customer c in period t, which must be exactly met"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "transport_links": "transport_links.csv",
      "supply_data": "supply_data.csv",
      "demand_data": "demand_data.csv"
    }
  },
