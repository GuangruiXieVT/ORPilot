  "ir": {
    "problem_class": "CrossDockingNetwork",
    "model_type": "Linear Program",
    "sense": "minimize",
    "sets": {
      "Plants": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "plants",
        "ordered": false
      },
      "DCs": {
        "size": null,
        "index_symbol": "d",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "dcs",
        "ordered": false
      },
      "Customers": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "customers",
        "ordered": false
      }
    },
    "parameters": {
      "plant_cap": {
        "domain": [
          "Plants"
        ],
        "type": "float",
        "source": "plants.csv",
        "column": "plant_cap",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "demand": {
        "domain": [
          "Customers"
        ],
        "type": "float",
        "source": "customers.csv",
        "column": "demand",
        "index_columns": [
          "id"
        ],
        "missing_default": "zero"
      },
      "cost_in": {
        "domain": [
          "Plants",
          "DCs"
        ],
        "type": "float",
        "source": "lane_in.csv",
        "column": "cost_in",
        "index_columns": [
          "plant_id",
          "dc_id"
        ],
        "missing_default": "inf"
      },
      "cost_out": {
        "domain": [
          "DCs",
          "Customers"
        ],
        "type": "float",
        "source": "lane_out.csv",
        "column": "cost_out",
        "index_columns": [
          "dc_id",
          "cust_id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "ship_in": {
        "description": "Units shipped from plant p to DC d",
        "label": "inbound_shipments",
        "domain": [
          "Plants",
          "DCs"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "ship_out": {
        "description": "Units shipped from DC d to customer c",
        "label": "outbound_shipments",
        "domain": [
          "DCs",
          "Customers"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "cross_dock_balance": {
        "domain": [
          "DCs"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Plants:p"
            ],
            "body": {
              "type": "variable",
              "name": "ship_in",
              "indices": [
                "p",
                "d"
              ]
            }
          },
          "right": {
            "operation": "indexed_sum",
            "over": [
              "Customers:c"
            ],
            "body": {
              "type": "variable",
              "name": "ship_out",
              "indices": [
                "d",
                "c"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "plant_capacity": {
        "domain": [
          "Plants"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "DCs:d"
          ],
          "body": {
            "type": "variable",
            "name": "ship_in",
            "indices": [
              "p",
              "d"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "plant_cap",
          "indices": [
            "p"
          ]
        }
      },
      "demand_coverage": {
        "domain": [
          "Customers"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "DCs:d"
          ],
          "body": {
            "type": "variable",
            "name": "ship_out",
            "indices": [
              "d",
              "c"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "parameter",
          "name": "demand",
          "indices": [
            "c"
          ]
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Plants:p",
            "DCs:d"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "cost_in",
              "indices": [
                "p",
                "d"
              ]
            },
            "right": {
              "type": "variable",
              "name": "ship_in",
              "indices": [
                "p",
                "d"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "DCs:d",
            "Customers:c"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "cost_out",
              "indices": [
                "d",
                "c"
              ]
            },
            "right": {
              "type": "variable",
              "name": "ship_out",
              "indices": [
                "d",
                "c"
              ]
            }
          }
        }
      }
    }
  },
