{
  "problem": {
    "title": "Cross-Docking Distribution Network",
    "description": "A distributor ships products from several plants to customers via distribution centers (DCs). Unlike a standard warehouse, each DC operates as a cross-dock: all units received must be immediately re-shipped to customers in the same period — no inventory is held at the DC. Plants have limited supply capacity. Customer demand must be met exactly. Determine the shipment volumes on each plant-to-DC and DC-to-customer lane to minimize total shipping cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total shipping cost = sum of per-unit costs on plant-to-DC and DC-to-customer lanes",
    "constraints": [
      {
        "description": "Cross-dock balance: total inbound flow to each DC equals total outbound flow (no storage)"
      },
      {
        "description": "Plant capacity: total outbound shipments from each plant cannot exceed its supply capacity"
      },
      {
        "description": "Demand coverage: total inbound shipments to each customer must exactly meet that customer's demand"
      }
    ],
    "decision_variables": [
      "ship_in[p,d]: units shipped from plant p to DC d (continuous, non-negative)",
      "ship_out[d,c]: units shipped from DC d to customer c (continuous, non-negative)"
    ],
    "parameters": [
      "plant_cap[p]: maximum units that can be shipped out from plant p",
      "demand[c]: demand at customer c",
      "cost_in[p,d]: cost per unit shipped from plant p to DC d",
      "cost_out[d,c]: cost per unit shipped from DC d to customer c"
    ],
    "additional_notes": "The cross-dock balance constraint (inflow = outflow at each DC) is the key feature distinguishing this from a standard two-echelon transportation model. It eliminates inventory holding decisions at the DC tier, pushing all stocking decisions to the plant or customer level.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "customers": "customers.csv",
      "lane_in": "lane_in.csv",
      "lane_out": "lane_out.csv"
    }
  },
  "csv_schemas": {
