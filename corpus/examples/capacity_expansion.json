{
  "problem": {
    "title": "Multi-Period Capacity Expansion",
    "description": "A manufacturer operates two plants and must decide in each period whether to invest in expanding a plant's capacity (binary decision). Capacity accumulates over time: once expanded, the added capacity persists. Production from each plant is limited by its current cumulative capacity. Total production must meet growing demand each period. Minimise total expansion and production costs.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total expansion investment plus production costs over all periods",
    "constraints": [
      {
        "description": "Capacity initialisation: first-period capacity = initial_cap + expansion if expanded in p1"
      },
      {
        "description": "Capacity update (temporal lag): each period's capacity = previous capacity + new expansion"
      },
      {
        "description": "Production upper bound: production cannot exceed current period capacity"
      },
      {
        "description": "Demand satisfaction: total production across plants meets demand each period"
      }
    ],
    "decision_variables": [
      "expand[Facilities,Periods]: 1 if plant f is expanded in period t (binary)",
      "capacity[Facilities,Periods]: cumulative production capacity of plant f in period t (continuous)",
      "produce[Facilities,Periods]: units produced at plant f in period t (continuous)"
    ],
    "parameters": [
      "initial_cap[Facilities]: starting capacity before any expansions",
      "expansion_size[Facilities]: capacity added per expansion event",
      "expansion_cost[Facilities]: capital cost per expansion",
      "demand[Periods]: total demand that must be met each period",
      "prod_cost[Facilities]: variable production cost per unit"
    ],
    "additional_notes": "plant_2 is cheaper to produce (prod_cost=5 vs 8) and cheaper to expand (300 vs 400). Demand first exceeds initial total capacity (160) in p3 (190). Optimal: expand plant_2 in p1 AND p2 (giving capacity=220), so plant_2 covers all demand alone from p2 onward without using expensive plant_1. Expansion cost=600, production cost=3400, total objective=4000. Two expansions beat one because the production savings (390) exceed the extra expansion cost (300).",
    "csv_file_paths": {
      "sets": "sets.csv",
      "facilities": "facilities.csv",
      "demand": "demand.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "facilities",
        "element": "plant_1"
      },
      "optional": false,
      "distinct_values": {
