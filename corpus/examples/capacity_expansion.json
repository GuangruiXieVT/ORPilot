        "expansion_cost": "float",
        "prod_cost": "float"
      },
      "sample": {
        "id": "plant_1",
        "initial_cap": 100.0,
        "expansion_size": 50.0,
        "expansion_cost": 400.0,
        "prod_cost": 8.0
      },
      "optional": false,
