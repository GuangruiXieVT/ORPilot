{
  "problem": {
    "title": "Furniture Factory Multi-Week Production Mix",
    "description": "A furniture factory produces chairs, tables, and shelves over a multi-week planning horizon. Each product type requires a certain number of labor-hours and board-feet of wood per unit. The factory has a fixed weekly supply of labor hours and wood. Products can only be produced in whole units — no fractional quantities. If the factory decides to include a product type in a given week's production run, it incurs a fixed setup cost and a variable per unit production cost, and the factory must produce at least a minimum batch size for that product type for this week. Each product type also has a maximum weekly production capacity due to machine constraints. Due to changeover constraints, at most two product types can be produced in any given week. Each product type has a revenue per unit produced. Determine which product types to include in the production plan each week and how many units of each to make to maximize total revenue minus total cost across all weeks.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total revenue from production minus total cost (fixed setup cost plus variable per unit production cost) summed across all weeks",
    "constraints": [
      {
        "description": "Total labor-hours consumed by all active product types in week w cannot exceed the factory's fixed weekly labor capacity"
      },
      {
        "description": "Total board-feet of wood consumed by all active product types in week w cannot exceed the factory's fixed weekly wood supply"
      },
      {
        "description": "If product type p is included in week w's production run, at least min_batch[p] units must be produced that week; if not included, production must be zero"
      },
      {
        "description": "Production of product type p in week w cannot exceed its maximum weekly machine capacity, and production can only be positive if product type p is active in that week"
      },
      {
        "description": "Due to changeover constraints, at most two product types can be active in any given week"
      }
    ],
    "decision_variables": [
      "produce[p,w]: integer number of units of product p to produce in week w",
      "active[p,w]: binary, 1 if product p is included in week w's production run, 0 otherwise"
    ],
    "parameters": [
      "revenue_per_unit[p]: revenue earned per unit of product p sold",
      "production_cost[p]: variable cost per unit of product p produced",
      "labor_hours[p]: labor-hours required to produce one unit of product p",
      "wood_board_feet[p]: board-feet of wood required to produce one unit of product p",
      "setup_cost[p]: fixed cost incurred if product p is included in a week's production run",
      "min_batch[p]: minimum number of units of product p that must be produced if active in a given week",
      "max_batch[p]: maximum number of units of product p that can be produced in a given week",
      "labor_capacity: total labor-hours available per week (shared across all products)",
      "wood_capacity: total board-feet of wood available per week (shared across all products)"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "weeks": "weeks.csv",
      "capacity": "capacity.csv"
    }
  },
