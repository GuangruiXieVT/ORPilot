{
  "problem": {
    "title": "Unit Commitment Problem",
    "description": "A power system operator schedules three generators over 8 hours. Each generator has minimum and maximum output limits, a fuel cost per MWh, and a startup cost when brought online. A binary commit variable determines if a generator is online each hour. Generation is only possible when committed (big-M linking). A binary startup variable captures when a generator transitions from off to on. Power balance must be met each hour. Minimize total fuel plus startup costs.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of fuel costs (fuel_cost[g]*generate[g,t]) plus startup costs (startup_cost[g]*startup[g,t]) over all generators and hours",
    "constraints": [
      {
        "description": "Power balance: total generation equals demand each hour"
      },
      {
        "description": "Minimum generation: when committed, generate at least min_output (big-M lower bound)"
      },
      {
        "description": "Maximum generation: when committed, generate at most max_output (big-M upper bound)"
      },
      {
        "description": "Startup link init: startup[g,h1] >= commit[g,h1] (first period, no previous state)"
      },
      {
        "description": "Startup link: startup[g,t] >= commit[g,t] - commit[g,t-1] for subsequent periods (temporal lag)"
      }
    ],
    "decision_variables": [
      "commit[g,t]: 1 if generator g is online in hour t (binary)",
      "generate[g,t]: MW output of generator g in hour t (continuous, non-negative)",
      "startup[g,t]: 1 if generator g starts up at hour t (binary)"
    ],
    "parameters": [
      "fuel_cost[g]: cost per MWh for generator g",
      "startup_cost[g]: fixed cost when generator g starts up",
      "min_output[g]: minimum MW output when generator g is online",
      "max_output[g]: maximum MW output when generator g is online",
      "demand[t]: MW demand in hour t"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "generators": "generators.csv",
      "demand": "demand.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "ordered set",
    "temporal lag",
    "init constraint",
    "big-M linking",
    "scalar parameter"
  ],
