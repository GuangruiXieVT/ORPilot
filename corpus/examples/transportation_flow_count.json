{
  "problem": {
    "title": "Multi-Product Multi-Period Transportation with Flow Capacity and Route Activation",
    "description": "A regional distribution company ships two product types (Product A and Product B) from three warehouses to four retail customers over three time periods. Only eight of the twelve possible warehouse-customer routes have established shipping lanes. Each route has a fixed per-unit shipping cost shared across all products and periods. Each route also has a maximum throughput capacity per product per period — the amount of a given product that can be shipped on a given route in a given period is bounded. A route may only carry shipments in a period if it is explicitly activated for that period; activating a route is a binary decision. Due to operational constraints, at most six routes may be simultaneously active in any given period. Each warehouse has a known supply capacity for each product in each period. Each customer has a fixed demand for each product in each period that must be exactly fulfilled. Determine which routes to activate each period and how much of each product to ship along each active route to fulfill all customer demands without exceeding warehouse supplies or route throughput capacities, while keeping active routes per period at most six, at minimum total shipping cost.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total shipping cost summed over all valid routes, products, and periods, weighted by the amount shipped",
    "constraints": [
      {
        "description": "For each warehouse, product, and period, the total amount of that product shipped out across all valid routes must not exceed the warehouse's supply of that product in that period"
      },
      {
        "description": "For each customer, product, and period, the total amount of that product shipped in from any warehouse via valid routes must exactly equal the customer's demand for that product in that period"
      },
      {
        "description": "For each valid route, product, and period, the amount shipped cannot exceed the route's throughput capacity for that product multiplied by whether the route is active in that period (big-M linking constraint)"
      },
      {
        "description": "For each period, the total number of active routes across all valid warehouse-customer pairs must not exceed six"
      }
    ],
    "decision_variables": [
      "ship[w,c,p,t]: amount of product p shipped from warehouse w to customer c in period t (continuous, non-negative, defined only for valid warehouse-customer routes)",
      "active_route[w,c,t]: 1 if the route from warehouse w to customer c is activated in period t, 0 otherwise (binary, defined only for valid routes)"
    ],
    "parameters": [
      "transport_cost[w,c]: cost per unit shipped from warehouse w to customer c, shared across all products and periods (defined only for the subset of valid routes)",
      "supply[w,p,t]: supply of product p available at warehouse w in period t",
      "demand[c,p,t]: demand for product p required by customer c in period t, which must be exactly met",
      "route_capacity[w,c,p]: maximum units of product p that can be shipped from warehouse w to customer c in any single period (defined only for valid routes)"
    ],
    "additional_notes": "The flow_capacity constraint simultaneously enforces the route throughput limit and serves as the big-M linking constraint: if active_route[w,c,t]=0 then ship[w,c,p,t] must be 0; if active_route[w,c,t]=1 then ship[w,c,p,t] <= route_capacity[w,c,p].",
    "csv_file_paths": {
      "sets": "sets.csv",
      "transport_links": "transport_links.csv",
      "supply_data": "supply_data.csv",
      "demand_data": "demand_data.csv",
      "route_capacity": "route_capacity.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "sparse filter",
    "big-M linking"
  ],
