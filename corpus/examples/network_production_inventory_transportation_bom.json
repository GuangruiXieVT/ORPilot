{
  "problem": {
    "title": "Multi-Period Production-Inventory-Distribution Network with Bill of Materials",
    "description": "A manufacturer operates a three-tier distribution network — plants, warehouses, and retailers — over multiple time periods. Multiple finished products are produced and distributed. At each plant, producing a unit of each finished product requires specific quantities of raw material components according to a Bill of Materials (BOM). Plants procure components from external suppliers each period at a per-unit component cost and hold component inventory between periods at a per-unit component holding cost. Each period, plants consume components according to BOM requirements to produce finished goods. Finished goods inventory at each plant incurs a per-unit holding cost per period. Total production across all products at each plant is bounded by the plant's per-period production capacity. From each plant, finished goods are shipped to warehouses over established lanes (a sparse arc set), each with a per-unit shipping cost and a per-period throughput capacity shared across all products. Warehouses hold finished goods inventory across periods at a per-unit holding cost and are limited by a shared storage capacity across all products. From each warehouse, goods are forwarded to retailers over another sparse set of established lanes, each with a per-unit shipping cost and a per-period arc capacity shared across all products. Each retailer has a known demand for each product each period that must be exactly fulfilled. The goal is to choose component procurement quantities, production quantities per product, inter-tier shipments, and inventory levels at each plant and warehouse to minimize total cost: component procurement costs, component and finished-goods holding costs at plants, warehouse holding costs, and transportation costs.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost: component procurement costs at plants, component holding costs at plants, finished-goods holding costs at plants and warehouses, and per-unit shipping costs on all plant-to-warehouse and warehouse-to-retailer arcs, summed across all products and periods",
    "constraints": [
      {
        "description": "Component inventory balance for the first period: ending component inventory at plant i equals initial component inventory plus components purchased minus components consumed in production (BOM quantity times units produced, summed over all finished products)"
      },
      {
        "description": "Component inventory balance for subsequent periods: ending component inventory at plant i in period t equals prior-period ending inventory plus components purchased minus components consumed"
      },
      {
        "description": "Finished-goods inventory balance for the first period: ending finished-goods inventory of product p at plant i equals initial inventory plus production minus total shipments out to warehouses"
      },
      {
        "description": "Finished-goods inventory balance for subsequent periods: ending finished-goods inventory of product p at plant i in period t equals prior-period ending inventory plus production minus total shipments out to warehouses"
      },
      {
        "description": "Warehouse inventory balance for the first period: ending inventory of product p at warehouse w equals initial inventory plus total inflow from plants minus total outflow to retailers"
      },
      {
        "description": "Warehouse inventory balance for subsequent periods: ending inventory of product p at warehouse w in period t equals prior-period ending inventory plus inflow from plants minus outflow to retailers"
      },
      {
        "description": "Total production across all products at each plant in each period must not exceed the plant's per-period production capacity"
      },
      {
        "description": "Total finished-goods inventory across all products at each warehouse at the end of each period must not exceed the warehouse's storage capacity"
      },
      {
        "description": "For each retailer, product, and period, total inflow from all connected warehouses must exactly equal the retailer's demand"
      },
      {
        "description": "For each plant-to-warehouse arc in each period, total flow across all products must not exceed the arc's per-period throughput capacity"
      },
      {
        "description": "For each warehouse-to-retailer arc in each period, total flow across all products must not exceed the arc's per-period throughput capacity"
      }
    ],
    "decision_variables": [
      "comp_purchase[i,c,t]: units of component c purchased at plant i in period t (continuous, non-negative)",
      "comp_inventory[i,c,t]: units of component c held at plant i at end of period t (continuous, non-negative)",
      "produce[i,p,t]: units of finished product p produced at plant i in period t (continuous, non-negative)",
      "inventory_plant[i,p,t]: units of finished product p held at plant i at end of period t (continuous, non-negative)",
      "inventory_wh[w,p,t]: units of finished product p held at warehouse w at end of period t (continuous, non-negative)",
      "flow_pw[i,w,p,t]: units of product p shipped from plant i to warehouse w in period t (continuous, non-negative, defined only for valid arcs)",
      "flow_wr[w,r,p,t]: units of product p shipped from warehouse w to retailer r in period t (continuous, non-negative, defined only for valid arcs)"
    ],
    "parameters": [
      "bom[c,p]: units of component c required to produce one unit of finished product p",
      "comp_cost[c]: per-unit procurement cost for component c",
      "comp_hold_cost[c]: per-unit holding cost per period for component c stored at any plant",
      "initial_comp_inv[i,c]: initial inventory of component c at plant i at the start of the planning horizon",
      "prod_capacity[i]: maximum total units (across all products) that can be produced at plant i in any single period",
      "hold_cost_plant[i]: per-unit holding cost per period for finished goods stored at plant i",
      "initial_inv_plant[i,p]: initial inventory of finished product p at plant i at the start of the planning horizon",
      "hold_cost_wh[w]: per-unit holding cost per period for finished goods stored at warehouse w",
      "wh_capacity[w]: maximum total units (across all products) that can be stored at warehouse w at the end of any period",
      "initial_inv_wh[w,p]: initial inventory of finished product p at warehouse w at the start of the planning horizon",
      "demand[r,p,t]: units of product p required by retailer r in period t, which must be exactly fulfilled",
      "cost_pw[i,w]: per-unit shipping cost from plant i to warehouse w, shared across all products (defined only for valid arcs)",
      "cost_wr[w,r]: per-unit shipping cost from warehouse w to retailer r, shared across all products (defined only for valid arcs)",
      "cap_pw[i,w]: maximum total units (across all products) shippable from plant i to warehouse w per period (defined only for valid arcs)",
      "cap_wr[w,r]: maximum total units (across all products) shippable from warehouse w to retailer r per period (defined only for valid arcs)"
    ],
    "additional_notes": "The BOM table is sparse: only component-product pairs with non-zero consumption need to appear; missing entries default to zero. Arc parameters are defined only for established shipping lanes. Arc capacities and warehouse capacities are shared across all products. Component procurement is unconstrained in quantity; the model optimises the timing and volume of purchases to minimise combined procurement, holding, and transportation costs.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "components": "components.csv",
      "bom": "bom.csv",
      "comp_init_inv": "comp_init_inv.csv",
      "plant_init_inv": "plant_init_inv.csv",
      "warehouses": "warehouses.csv",
      "wh_init_inv": "wh_init_inv.csv",
      "demand_data": "demand_data.csv",
      "arc_costs_pw": "arc_costs_pw.csv",
      "arc_costs_wr": "arc_costs_wr.csv",
      "arc_caps_pw": "arc_caps_pw.csv",
      "arc_caps_wr": "arc_caps_wr.csv"
    }
  },
