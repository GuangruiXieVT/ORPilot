{
  "problem": {
    "title": "Worker-Task Assignment Problem",
    "description": "A project manager must assign a set of workers to a set of tasks for an upcoming project. The number of workers equals the number of tasks. Each worker must be assigned to exactly one task, and each task must be handled by exactly one worker. The cost of assigning a particular worker to a particular task is known (reflecting skill fit, training requirements, or opportunity cost). Find the one-to-one assignment of workers to tasks that minimizes total assignment cost.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total assignment cost summed over all worker-task pairs that are assigned",
    "constraints": [
      {
        "description": "Each worker must be assigned to exactly one task"
      },
      {
        "description": "Each task must be assigned exactly one worker"
      }
    ],
    "decision_variables": [
      "assign[w,t]: 1 if worker w is assigned to task t, 0 otherwise (binary)"
    ],
    "parameters": [
      "assignment_cost[w,t]: cost of assigning worker w to task t"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "assignment_costs": "assignment_costs.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "workers",
        "element": "w1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "workers",
          "tasks"
        ],
        "element": [
