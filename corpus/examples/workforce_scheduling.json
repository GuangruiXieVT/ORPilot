{
  "problem": {
    "title": "Call Center Shift Scheduling",
    "description": "A call center must staff a set of daily shifts using a pool of available employees. Each shift requires a minimum number of workers on duty to handle expected call volume. Each employee has a known cost associated with working each particular shift — reflecting overtime rates, preferences, or seniority differentials. No employee should work more than a specified maximum number of shifts per week to comply with labor regulations. Determine the minimum-cost schedule that assigns employees to shifts such that all minimum staffing requirements are met and no employee exceeds their weekly shift limit.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total labor cost across all employee-shift assignments where an employee is scheduled to work",
    "constraints": [
      {
        "description": "For each shift, the total number of employees scheduled to work that shift must meet or exceed the minimum required staffing level"
      },
      {
        "description": "For each employee, the total number of shifts they are scheduled to work must not exceed the maximum allowed shifts per week"
      }
    ],
    "decision_variables": [
      "work[e,s]: 1 if employee e is scheduled to work shift s, 0 otherwise (binary)"
    ],
    "parameters": [
      "shift_cost[e,s]: cost of scheduling employee e to work shift s",
      "min_coverage[s]: minimum number of employees required on shift s",
      "max_shifts_per_employee: maximum number of shifts any employee may work per week"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "shifts": "shifts.csv",
      "shift_costs": "shift_costs.csv",
      "policy": "policy.csv"
    }
  },
