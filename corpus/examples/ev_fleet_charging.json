    }
  },
  "ir": {
    "problem_class": "EVChargingScheduling",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Vehicles": {
        "size": null,
        "index_symbol": "v",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "vehicles",
        "ordered": false
      },
      "Slots": {
        "size": null,
        "index_symbol": "s",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "slots",
        "ordered": false
      },
      "Stations": {
        "size": null,
        "index_symbol": "st",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "stations",
        "ordered": false
      }
    },
    "parameters": {
      "price": {
        "domain": [
          "Slots"
        ],
        "type": "float",
        "source": "prices.csv",
        "column": "price",
        "index_columns": [
          "slot_id"
        ],
        "missing_default": "zero"
      },
      "min_charge": {
        "domain": [
          "Vehicles"
        ],
        "type": "float",
        "source": "vehicles.csv",
        "column": "min_charge",
        "index_columns": [
          "vehicle_id"
        ],
        "missing_default": "zero"
      },
      "max_battery": {
        "domain": [
          "Vehicles"
        ],
        "type": "float",
        "source": "vehicles.csv",
        "column": "max_battery",
        "index_columns": [
          "vehicle_id"
        ],
        "missing_default": "inf"
      },
      "max_rate": {
        "domain": [
          "Stations"
        ],
        "type": "float",
        "source": "stations.csv",
        "column": "max_rate",
        "index_columns": [
          "station_id"
        ],
        "missing_default": "zero"
      },
      "grid_limit": {
        "domain": [],
        "type": "float",
        "source": "params.csv",
        "column": "grid_limit",
        "missing_default": "zero"
      }
    },
    "variables": {
      "charge_rate": {
        "description": "kW charged for vehicle v in slot s at station st",
        "label": "vehicle_charge_rates",
        "domain": [
          "Vehicles",
          "Slots",
          "Stations"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "connected": {
        "description": "1 if vehicle v is connected to station st in slot s",
        "label": "vehicle_station_connections",
        "domain": [
          "Vehicles",
          "Slots",
          "Stations"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "one_station_per_vehicle_slot": {
        "domain": [
          "Vehicles",
          "Slots"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Stations:st"
          ],
          "body": {
            "type": "variable",
            "name": "connected",
            "indices": [
              "v",
              "s",
              "st"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "rate_if_connected": {
        "domain": [
          "Vehicles",
          "Slots",
          "Stations"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "charge_rate",
            "indices": [
              "v",
              "s",
              "st"
            ]
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "max_rate",
              "indices": [
                "st"
              ]
            },
            "right": {
              "type": "variable",
              "name": "connected",
              "indices": [
                "v",
                "s",
                "st"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "station_one_vehicle": {
        "domain": [
          "Slots",
          "Stations"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Vehicles:v"
          ],
          "body": {
            "type": "variable",
            "name": "connected",
            "indices": [
              "v",
              "s",
              "st"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "min_charge_met": {
        "domain": [
          "Vehicles"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "parameter",
            "name": "min_charge",
            "indices": [
              "v"
            ]
          },
          "right": {
            "operation": "indexed_sum",
            "over": [
              "Slots:s",
              "Stations:st"
            ],
            "body": {
              "type": "variable",
              "name": "charge_rate",
              "indices": [
                "v",
                "s",
                "st"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "battery_limit": {
        "domain": [
          "Vehicles"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Slots:s",
              "Stations:st"
            ],
            "body": {
              "type": "variable",
              "name": "charge_rate",
              "indices": [
                "v",
                "s",
                "st"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "max_battery",
            "indices": [
              "v"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "grid_power": {
        "domain": [
          "Slots"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Vehicles:v",
              "Stations:st"
            ],
            "body": {
              "type": "variable",
              "name": "charge_rate",
              "indices": [
                "v",
                "s",
                "st"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "grid_limit",
            "indices": []
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Vehicles:v",
          "Slots:s",
          "Stations:st"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "price",
            "indices": [
              "s"
            ]
          },
          "right": {
            "type": "variable",
            "name": "charge_rate",
            "indices": [
              "v",
              "s",
              "st"
            ]
          }
        }
      }
    }
  },
