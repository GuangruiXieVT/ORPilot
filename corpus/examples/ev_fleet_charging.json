{
  "problem": {
    "title": "EV Fleet Charging Scheduling",
    "description": "A fleet operator schedules overnight charging for 8 electric vehicles across 6 time slots at a depot with 3 charging stations. Each vehicle needs a minimum charge and has a battery capacity. Grid power limits total simultaneous charging. Minimize total charging cost (prices vary by slot).",
    "problem_type": "mixed_integer_program",
    "objective": "minimize",
    "objective_description": "Total charging cost across all vehicles, slots, and stations",
    "constraints": [
      {
        "description": "Each vehicle uses at most one station per slot"
      },
      {
        "description": "Charge rate is bounded by max station rate when connected"
      },
      {
        "description": "Each station serves at most one vehicle per slot"
      },
      {
        "description": "Each vehicle reaches its minimum charge requirement"
      },
      {
        "description": "Total charging does not exceed battery capacity"
      },
      {
        "description": "Total power across all vehicles and stations does not exceed grid limit per slot"
      }
    ],
    "decision_variables": [
      "charge_rate[v,s,st]: kW charged per slot (continuous >= 0)",
      "connected[v,s,st]: 1 if vehicle v uses station st in slot s (binary)"
    ],
    "parameters": [
      "price[s]: cost per kWh by slot",
      "min_charge[v]: minimum total kWh required",
      "max_battery[v]: battery capacity in kWh",
      "max_rate[st]: max kW per station",
      "grid_limit: total grid power limit in kW"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "prices": "prices.csv",
      "vehicles": "vehicles.csv",
      "stations": "stations.csv",
      "params": "params.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "vehicles",
        "element": "v1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "vehicles",
          "slots",
          "stations"
        ],
        "element": [
          "v1",
          "v2",
          "v3",
          "v4",
          "v5",
          "v6",
          "v7",
          "v8",
          "s1",
          "s2",
          "s3",
          "s4",
          "s5",
          "s6",
          "st1",
          "st2",
          "st3"
        ]
      }
    },
    "prices": {
      "columns": {
        "slot_id": "str",
        "price": "float"
      },
      "sample": {
        "slot_id": "s1",
        "price": 0.08
      },
      "optional": false,
      "distinct_values": {
        "slot_id": [
          "s1",
          "s2",
          "s3",
          "s4",
          "s5",
          "s6"
        ]
      }
    },
    "vehicles": {
      "columns": {
        "vehicle_id": "str",
        "min_charge": "float",
        "max_battery": "float"
      },
      "sample": {
        "vehicle_id": "v1",
        "min_charge": 20.0,
        "max_battery": 60.0
      },
      "optional": false,
      "distinct_values": {
        "vehicle_id": [
          "v1",
          "v2",
          "v3",
          "v4",
          "v5",
          "v6",
          "v7",
          "v8"
        ]
      }
    },
    "stations": {
      "columns": {
        "station_id": "str",
        "max_rate": "float"
      },
      "sample": {
        "station_id": "st1",
        "max_rate": 10.0
      },
      "optional": false,
      "distinct_values": {
        "station_id": [
          "st1",
          "st2",
          "st3"
        ]
      }
    },
    "params": {
      "columns": {
