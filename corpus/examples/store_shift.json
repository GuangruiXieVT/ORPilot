{
  "problem": {
    "title": "24-Hour Convenience Store Shift Scheduling",
    "description": "A 24-hour convenience store has different staffing needs in each 4-hour time block. Workers start shifts at 2am, 6am, 10am, 2pm, 6pm, or 10pm and work 8 continuous hours (two consecutive 4-hour blocks). Minimize the total number of salespeople hired to cover all time periods.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total number of salespeople hired across all shift start times",
    "constraints": [
      {
        "description": "For each 4-hour period, the sum of workers from all shifts that cover that period must be at least the required staffing level"
      }
    ],
    "decision_variables": [
      "workers[s]: number of salespeople starting at shift s (non-negative integer)"
    ],
    "parameters": [
      "demand[p]: minimum salespeople required in period p",
      "coverage[p,s]: 1 if shift s covers period p, 0 otherwise"
    ],
    "additional_notes": "Periods p1..p6 correspond to 2-6, 6-10, 10-14, 14-18, 18-22, 22-2. Shifts s1..s6 start at 2am, 6am, 10am, 2pm, 6pm, 10pm. Each shift covers two consecutive periods (8 hours). Coverage is sparse (only 1s in CSV). Optimal: workers=[7,8,17,3,15,3], total=53.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand": "demand.csv",
      "coverage": "coverage.csv"
    }
  },
