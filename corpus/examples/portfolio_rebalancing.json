{
  "problem": {
    "title": "Portfolio Rebalancing with Transaction Costs",
    "description": "An investor holds a current portfolio and wants to rebalance toward target weights. Buying and selling incur transaction costs. The total portfolio value is fixed. Minimize total transaction costs while achieving target allocation within a tolerance band.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total transaction costs from buying and selling assets",
    "constraints": [
      {
        "description": "Balance: final holdings = current holdings + buy - sell"
      },
      {
        "description": "Budget: total portfolio value equals target"
      },
      {
        "description": "Weight upper bound: asset value <= (target_weight + max_deviation) * total_value"
      },
      {
        "description": "Weight lower bound: asset value >= (target_weight - max_deviation) * total_value"
      }
    ],
    "decision_variables": [
      "hold[Assets]: final units held (continuous, non-negative)",
      "buy[Assets]: units purchased (continuous, non-negative)",
      "sell[Assets]: units sold (continuous, non-negative)"
    ],
    "parameters": [
      "current_hold[Assets]: current holdings",
      "price[Assets]: current price per unit",
      "buy_cost[Assets]: transaction cost per unit bought",
      "sell_cost[Assets]: transaction cost per unit sold",
      "target_weight[Assets]: target portfolio fraction",
      "total_value: target total portfolio value",
      "max_deviation: maximum allowed deviation from target weight"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "assets": "assets.csv",
      "params": "params.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "assets",
