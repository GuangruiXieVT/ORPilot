          "120.0",
          "125.0",
          "130.0"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "CrewScheduling",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Crews": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "crews",
        "ordered": false
      },
      "Flights": {
        "size": null,
        "index_symbol": "f",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "flights",
        "ordered": false
      }
    },
    "parameters": {
      "assignment_cost": {
        "domain": [
          "Crews",
          "Flights"
        ],
        "type": "float",
        "source": "assignment_cost.csv",
        "column": "cost",
        "index_columns": [
          "crew_id",
          "flight_id"
        ],
        "missing_default": "inf"
      },
      "max_flights": {
        "domain": [
          "Crews"
        ],
        "type": "float",
        "source": "crew_params.csv",
        "column": "max_flights",
        "index_columns": [
          "crew_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "assign": {
        "description": "1 if crew c is assigned to flight f",
        "label": "crew_assignments",
        "domain": [
          "Crews",
          "Flights"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "assignment_cost"
      }
    },
    "constraints": {
      "flight_covered": {
        "domain": [
          "Flights"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Crews:c"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "c",
              "f"
            ]
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "crew_limit": {
        "domain": [
          "Crews"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Flights:f"
            ],
            "body": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "c",
                "f"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "max_flights",
            "indices": [
              "c"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Crews:c",
          "Flights:f"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "assignment_cost",
            "indices": [
              "c",
              "f"
            ]
          },
          "right": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "c",
              "f"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "binary variable",
    "domain filter",
    "sparse filter"
  ]
}