{
  "problem": {
    "title": "Airline Crew Scheduling",
    "description": "An airline must assign crews to flights. Each flight must be covered by at least one crew. Each crew can only fly on routes they are certified for (sparse eligibility). Each crew has a maximum number of flights per week. Minimize total assignment cost.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost of crew-to-flight assignments",
    "constraints": [
      {
        "description": "Each flight must be covered by at least one crew"
      },
      {
        "description": "Each crew's total assignments must not exceed their weekly flight limit"
      }
    ],
    "decision_variables": [
      "assign[Crews, Flights]: 1 if crew c is assigned to flight f (binary, sparse eligibility)"
    ],
    "parameters": [
      "assignment_cost[Crews, Flights]: cost to assign crew c to flight f (sparse)",
      "max_flights[Crews]: maximum number of flights crew c can fly per week"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "crew_params": "crew_params.csv",
      "assignment_cost": "assignment_cost.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
