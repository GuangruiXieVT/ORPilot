{
  "problem": {
    "title": "Golf Toy Production LP",
    "description": "A toy company produces three types of golf toys: high-end, mid-range, and low-end. Each type requires labor and inspection hours. The company has 1000 labor-hours and 500 inspection-hours available per week. Each type also has a maximum demand limit. Maximize total profit.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total weekly profit from all golf toy types produced",
    "constraints": [
      {
        "description": "Total labor hours across all toy types cannot exceed 1000 hours"
      },
      {
        "description": "Total inspection hours across all toy types cannot exceed 500 hours"
      },
      {
        "description": "Production of each toy type cannot exceed its maximum demand"
      }
    ],
    "decision_variables": [
      "produce[t]: number of golf toy type t to produce per week (continuous, non-negative)"
    ],
    "parameters": [
      "profit[t]: profit per unit of golf toy type t",
      "labor_hours[t]: labor hours required per unit of toy type t",
      "inspect_hours[t]: inspection hours required per unit of toy type t",
      "max_demand[t]: maximum demand per week for toy type t"
    ],
    "additional_notes": "Optimal: produce[high]=0, produce[mid]=80, produce[low]=90. Check: labor=10*80+2*90=980<=1000, inspect=4*80+2*90=500<=500, demand[mid]=80<=80, demand[low]=90<=150. Objective = 200*80+100*90 = 16000+9000 = 25000.",
    "csv_file_paths": {
      "toys": "toys.csv"
    }
  },
  "csv_schemas": {
