        "max_tasks": 2
      },
      "optional": false,
      "distinct_values": {
        "worker_id": [
          "w1",
          "w2",
          "w3",
          "w4",
          "w5",
          "w6",
          "w7",
          "w8"
        ],
        "max_tasks": [
          "2"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "AssignmentProblem",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Workers": {
        "size": null,
        "index_symbol": "w",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "workers",
        "ordered": false
      },
      "Tasks": {
        "size": null,
        "index_symbol": "t",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "tasks",
        "ordered": false
      }
    },
    "parameters": {
      "assignment_cost": {
        "domain": [
          "Workers",
          "Tasks"
        ],
        "type": "float",
        "source": "eligible_pairs.csv",
        "column": "assignment_cost",
        "index_columns": [
          "worker_id",
          "task_id"
        ],
        "missing_default": "inf"
      },
      "max_tasks": {
        "domain": [
          "Workers"
        ],
        "type": "float",
        "source": "workers.csv",
        "column": "max_tasks",
        "index_columns": [
          "worker_id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "assign": {
        "description": "1 if worker w is assigned to task t (eligible pairs only), 0 otherwise",
        "label": "assignments",
        "domain": [
          "Workers",
          "Tasks"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "assignment_cost"
      }
    },
    "constraints": {
      "task_covered": {
        "domain": [
          "Tasks"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Workers:w"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "w",
              "t"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "worker_load": {
        "domain": [
          "Workers"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Tasks:t"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "w",
              "t"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "max_tasks",
          "indices": [
            "w"
          ]
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Workers:w",
          "Tasks:t"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "assignment_cost",
            "indices": [
              "w",
              "t"
            ]
          },
          "right": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "w",
              "t"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "binary variable",
    "domain filter"
  ]
}