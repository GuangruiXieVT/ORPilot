{
  "problem": {
    "title": "Skill-Based Worker-Task Assignment",
    "description": "A project manager must assign eight workers to ten tasks. Workers have different skill sets, so only certain worker-task combinations are eligible (a worker can only perform tasks they are qualified for). Each eligible assignment has a known cost reflecting training requirements, efficiency, and worker preference. Each task must be assigned to exactly one eligible worker. Each worker may handle at most a maximum number of tasks. Find the minimum-cost assignment of workers to tasks that covers all tasks while respecting eligibility and workload constraints.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total assignment cost across all worker-task pairs assigned",
    "constraints": [
      {
        "description": "Each task must be assigned to exactly one eligible worker"
      },
      {
        "description": "Each worker may be assigned to at most their maximum allowed number of tasks"
      }
    ],
    "decision_variables": [
      "assign[w,t]: 1 if worker w is assigned to task t (only for eligible pairs), 0 otherwise (binary)"
    ],
    "parameters": [
      "assignment_cost[w,t]: cost of assigning worker w to task t (only defined for eligible pairs)",
      "max_tasks[w]: maximum number of tasks that worker w can handle"
    ],
    "additional_notes": "The assign variable uses domain filtering — only eligible (worker, task) pairs are included in the model. Ineligible assignments are structurally excluded, not just penalized.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "eligible_pairs": "eligible_pairs.csv",
      "workers": "workers.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "workers",
        "element": "w1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
