{
  "problem": {
    "title": "Weekly Nurse Rostering",
    "description": "A hospital must create a weekly schedule for five nurses across three shifts (morning, afternoon, night) and seven days. Each shift on each day has a minimum number of nurses required to provide adequate patient care. Each nurse has a shift-specific cost (reflecting overtime, seniority, and preference). No nurse may work more than a specified maximum number of shifts per week. Determine the minimum-cost weekly schedule that meets all coverage requirements without exceeding nurse working-hour limits.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total scheduling cost across all nurse-shift-day assignments",
    "constraints": [
      {
        "description": "For each shift on each day, the number of nurses assigned must meet or exceed the minimum required coverage"
      },
      {
        "description": "For each nurse, the total number of shift assignments across the week must not exceed their maximum allowed weekly shifts"
      }
    ],
    "decision_variables": [
      "assign[n,s,d]: 1 if nurse n is assigned to shift s on day d, 0 otherwise (binary)"
    ],
    "parameters": [
      "shift_cost[n,s]: cost of scheduling nurse n for shift s (per occurrence)",
      "min_nurses[s,d]: minimum number of nurses required for shift s on day d",
      "max_weekly_shifts[n]: maximum number of shifts nurse n can work per week"
    ],
    "additional_notes": "The assign variable is 3-dimensional (nurses × shifts × days). The coverage constraint sums over nurses for each (shift, day) pair. The weekly limit sums over both shifts and days for each nurse.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "min_coverage": "min_coverage.csv",
      "shift_costs": "shift_costs.csv",
      "nurses": "nurses.csv"
    }
  },
  "ir_patterns": [
    "binary variable"
  ],
  "csv_schemas": {
