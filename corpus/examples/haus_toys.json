{
  "problem": {
    "title": "Haus Toys Product Selection MIP",
    "description": "Haus Toys can manufacture trucks, airplanes, boats, and trains with wood and steel resources. To maximize profit, the company must decide which types of toys to manufacture and in what quantity, subject to three logical constraints: (1) Trucks and trains are mutually exclusive — if trucks are made, trains cannot be, and vice versa. (2) If boats are manufactured, airplanes must also be manufactured. (3) The number of boats cannot exceed the number of trains. 890 units of wood and 500 units of steel are available.",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Total profit from all toys manufactured",
    "constraints": [
      {
        "description": "Total wood used across all toy types cannot exceed 890 units"
      },
      {
        "description": "Total steel used across all toy types cannot exceed 500 units"
      },
      {
        "description": "If a toy type is manufactured (make=1), quantity can be positive; if not selected (make=0), quantity must be zero (big-M linking)"
      },
      {
        "description": "Trucks and trains are mutually exclusive: make[trucks] + make[trains] <= 1"
      },
      {
        "description": "Boats imply airplanes: make[boats] <= make[airplanes]"
      },
      {
        "description": "Boats quantity cannot exceed trains quantity: qty[boats] <= qty[trains]"
      }
    ],
    "decision_variables": [
      "qty[t]: quantity of toy type t to produce (continuous, non-negative)",
      "make[t]: 1 if toy type t is manufactured, 0 otherwise (binary)"
    ],
    "parameters": [
      "profit[t]: profit per unit of toy type t",
      "resource_use[t,r]: units of resource r required per toy of type t",
      "resource_limit[r]: total available units of resource r",
      "big_m[t]: big-M upper bound for linking make[t] to qty[t]"
    ],
    "additional_notes": "Logical constraints use scalar domain (domain=[]) with hardcoded toy IDs. mutual_exclusion: make['trucks'] + make['trains'] <= 1. boats_imply_airplanes: make['boats'] - make['airplanes'] <= 0. boats_leq_trains: qty['boats'] - qty['trains'] <= 0. Optimal: 89 trains, no other toys; obj=623.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "profit": "profit.csv",
      "resource_use": "resource_use.csv",
      "resource_limit": "resource_limit.csv",
      "big_m": "big_m.csv"
    }
  },
