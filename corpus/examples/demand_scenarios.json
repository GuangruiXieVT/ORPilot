{
  "problem": {
    "title": "Two-Stage Stochastic Production (Newsvendor)",
    "description": "A producer must commit to production quantities before demand is revealed (first stage). After the scenario is realised, surplus (over-production) incurs a disposal penalty and shortfall (under-production) incurs a lost-sales penalty (second stage). Three demand scenarios with known probabilities. Minimise expected total cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Production cost + expected recourse cost (probability-weighted overage and underage penalties)",
    "constraints": [
      {
        "description": "Overage definition: surplus >= produce - demand (per product per scenario)"
      },
      {
        "description": "Underage definition: shortfall >= demand - produce (per product per scenario)"
      }
    ],
    "decision_variables": [
      "produce[Products]: units produced before demand is known (first-stage, continuous)",
      "surplus[Products,Scenarios]: over-production in scenario s (second-stage, continuous)",
      "shortfall[Products,Scenarios]: under-production in scenario s (second-stage, continuous)"
    ],
    "parameters": [
      "prod_cost[Products]: per-unit production cost",
      "overage_cost[Products]: per-unit disposal penalty for surplus",
      "underage_cost[Products]: per-unit lost-sales penalty for shortfall",
      "probability[Scenarios]: scenario probabilities (sum to 1)",
      "demand_scen[Products,Scenarios]: demand under each scenario"
    ],
    "additional_notes": "Optimal: produce[A]=70 (breakeven between s_med and s_high), produce[B]=50 (breakeven between s_med and s_high). Objective = 1000 (production) + 157.5 (A recourse) + 60 (B recourse) = 1217.5.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "scenarios": "scenarios.csv",
      "demand_scenarios": "demand_scenarios.csv"
    }
  },
  "ir_patterns": [
    "scenario weighted sum",
    "deviation variables"
  ],
  "csv_schemas": {
