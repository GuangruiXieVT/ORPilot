{
  "problem": {
    "title": "Stochastic Facility Location",
    "description": "Two-stage stochastic facility location. First stage: decide which facilities to open. Second stage: after demand scenarios revealed, ship from open facilities to customers. Minimize expected total cost (fixed opening costs plus expected shipping costs).",
    "problem_type": "stochastic_mixed_integer_program",
    "objective": "minimize",
    "objective_description": "Fixed opening costs plus probability-weighted shipping costs across scenarios",
    "constraints": [
      {
        "description": "Total shipment from each facility in each scenario does not exceed capacity if open"
      },
      {
        "description": "Customer demand is met in each scenario"
      }
    ],
    "decision_variables": [
      "open[f]: 1 if facility f is opened (binary, first stage)",
      "ship[f,c,sc]: units shipped from facility f to customer c in scenario sc (continuous >= 0)"
    ],
    "parameters": [
      "fixed_cost[f]: one-time opening cost",
      "capacity[f]: maximum supply from open facility",
      "ship_cost[f,c]: per-unit shipping cost",
      "demand[c,sc]: customer demand in scenario sc",
      "probability[sc]: probability of scenario sc"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "facilities": "facilities.csv",
      "ship_costs": "ship_costs.csv",
      "demand": "demand.csv",
      "scenarios": "scenarios.csv"
    }
  },
  "ir_patterns": [
    "two-stage stochastic",
    "binary first-stage",
    "scenario indexed variable",
    "expected cost in objective"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "facilities",
        "element": "f1"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "facilities",
          "customers",
          "scenarios"
        ],
        "element": [
          "f1",
          "f2",
          "f3",
          "f4",
          "c1",
          "c2",
          "c3",
          "c4",
          "sc1",
          "sc2",
          "sc3"
        ]
      }
    },
    "facilities": {
      "columns": {
        "facility_id": "str",
        "fixed_cost": "float",
        "capacity": "float"
      },
      "sample": {
        "facility_id": "f1",
        "fixed_cost": 500.0,
        "capacity": 200.0
      },
      "optional": false,
      "distinct_values": {
        "facility_id": [
          "f1",
          "f2",
          "f3",
          "f4"
        ]
      }
    },
    "ship_costs": {
      "columns": {
        "facility_id": "str",
        "customer_id": "str",
        "ship_cost": "float"
      },
      "sample": {
        "facility_id": "f1",
        "customer_id": "c1",
        "ship_cost": 3.0
      },
      "optional": false,
      "distinct_values": {
        "facility_id": [
          "f1",
          "f2",
          "f3",
          "f4"
        ],
        "customer_id": [
          "c1",
          "c2",
          "c3",
          "c4"
        ]
      }
    },
    "demand": {
      "columns": {
        "customer_id": "str",
        "scenario_id": "str",
        "demand": "float"
      },
      "sample": {
        "customer_id": "c1",
        "scenario_id": "sc1",
        "demand": 60.0
      },
      "optional": false,
      "distinct_values": {
        "customer_id": [
          "c1",
          "c2",
          "c3",
          "c4"
        ],
        "scenario_id": [
          "sc1",
          "sc2",
          "sc3"
        ]
      }
    },
    "scenarios": {
      "columns": {
        "scenario_id": "str",
        "probability": "float"
      },
      "sample": {
        "scenario_id": "sc1",
        "probability": 0.3
      },
      "optional": false,
      "distinct_values": {
        "scenario_id": [
          "sc1",
          "sc2",
          "sc3"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "StochasticFacilityLocation",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Facilities": {
        "size": null,
        "index_symbol": "f",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "facilities",
        "ordered": false
      },
      "Customers": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "customers",
        "ordered": false
      },
      "Scenarios": {
        "size": null,
        "index_symbol": "sc",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "scenarios",
        "ordered": false
      }
    },
    "parameters": {
      "fixed_cost": {
        "domain": [
          "Facilities"
        ],
        "type": "float",
        "source": "facilities.csv",
        "column": "fixed_cost",
        "index_columns": [
          "facility_id"
        ],
        "missing_default": "inf"
      },
      "capacity": {
        "domain": [
          "Facilities"
        ],
        "type": "float",
        "source": "facilities.csv",
        "column": "capacity",
        "index_columns": [
          "facility_id"
        ],
        "missing_default": "inf"
      },
      "ship_cost": {
        "domain": [
          "Facilities",
          "Customers"
        ],
        "type": "float",
        "source": "ship_costs.csv",
        "column": "ship_cost",
        "index_columns": [
          "facility_id",
          "customer_id"
        ],
        "missing_default": "inf"
      },
      "demand": {
        "domain": [
          "Customers",
          "Scenarios"
        ],
        "type": "float",
        "source": "demand.csv",
        "column": "demand",
        "index_columns": [
          "customer_id",
          "scenario_id"
        ],
        "missing_default": "zero"
      },
      "probability": {
        "domain": [
          "Scenarios"
        ],
        "type": "float",
        "source": "scenarios.csv",
        "column": "probability",
        "index_columns": [
          "scenario_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "open": {
        "description": "1 if facility f is opened (first-stage decision)",
        "label": "facility_openings",
        "domain": [
          "Facilities"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "ship": {
        "description": "Units shipped from facility f to customer c in scenario sc",
        "label": "scenario_shipments",
        "domain": [
          "Facilities",
          "Customers",
          "Scenarios"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "capacity_limit": {
        "domain": [
          "Facilities",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Customers:c"
            ],
            "body": {
              "type": "variable",
              "name": "ship",
              "indices": [
                "f",
                "c",
                "sc"
              ]
            }
          },
          "right": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "capacity",
              "indices": [
                "f"
              ]
            },
            "right": {
              "type": "variable",
              "name": "open",
              "indices": [
                "f"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "demand_met": {
        "domain": [
          "Customers",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Facilities:f"
            ],
            "body": {
              "type": "variable",
              "name": "ship",
              "indices": [
                "f",
                "c",
                "sc"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "demand",
            "indices": [
              "c",
              "sc"
            ]
          }
        },
        "sense": ">=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Facilities:f"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "fixed_cost",
              "indices": [
                "f"
              ]
            },
            "right": {
              "type": "variable",
              "name": "open",
              "indices": [
                "f"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "Scenarios:sc"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "probability",
              "indices": [
                "sc"
              ]
            },
            "right": {
              "operation": "indexed_sum",
              "over": [
                "Facilities:f",
                "Customers:c"
              ],
              "body": {
                "operation": "multiply",
                "left": {
                  "type": "parameter",
                  "name": "ship_cost",
                  "indices": [
                    "f",
                    "c"
                  ]
                },
                "right": {
                  "type": "variable",
                  "name": "ship",
                  "indices": [
                    "f",
                    "c",
                    "sc"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
