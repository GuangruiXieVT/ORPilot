{
  "problem": {
    "title": "Retail Shelf Space Allocation",
    "description": "A retailer allocates shelf space (facings) to products across store sections. A binary carry variable determines if a product is stocked. If carried, the product must receive at least min_facing and at most max_facing total facings across all sections. Each section has limited capacity. At most max_products distinct products can be carried. Maximize total profit (profit per facing times total facings allocated).",
    "problem_type": "mixed_integer",
    "objective": "maximize",
    "objective_description": "Total profit = sum over products and sections of profit_per_space * allocate",
    "constraints": [
      {
        "description": "Section capacity: total facings in each section cannot exceed section capacity"
      },
      {
        "description": "Min facing: total facings per product >= min_facing if product is carried"
      },
      {
        "description": "Max facing: total facings per product <= max_facing * carry"
      },
      {
        "description": "Max products: at most max_products products can be carried"
      }
    ],
    "decision_variables": [
      "allocate[Products, Sections]: facing units allocated to product in section (continuous, non-negative)",
      "carry[Products]: 1 if product is stocked (binary)"
    ],
    "parameters": [
      "profit_per_space[Products]: profit per facing allocated",
      "min_facing[Products]: minimum total facings if product is carried",
      "max_facing[Products]: maximum useful total facings",
      "section_cap[Sections]: total facing capacity per section",
      "max_products: maximum number of distinct products to carry"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "sections": "sections.csv",
      "params": "params.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "big-M linking",
    "scalar parameter",
    "maximize profit"
  ],
  "csv_schemas": {
    "sets": {
      "columns": {
