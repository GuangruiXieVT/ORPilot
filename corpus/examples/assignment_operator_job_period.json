{
  "problem": {
    "title": "Operator-Job-Period Assignment with Eligibility",
    "description": "A production facility must assign six operators to eight jobs across four shifts. Operators are qualified for only certain jobs (based on their certifications and training), defining eligible (operator, job) pairs. Each (job, shift) pair that requires coverage must have exactly one operator assigned to it. An operator can handle at most a maximum number of jobs per shift. Each eligible (operator, job) pair has a known cost per shift. Minimize total assignment cost while covering all required job-shift slots and respecting operator qualifications and workload limits.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost of operator-job-period assignments",
    "constraints": [
      {
        "description": "For each (job, shift) pair that requires coverage, exactly one eligible operator must be assigned"
      },
      {
        "description": "For each operator in each shift, the total number of jobs assigned must not exceed their maximum jobs per shift"
      }
    ],
    "decision_variables": [
      "assign[o,j,p]: 1 if operator o is assigned to job j in period p (only for eligible operator-job pairs), 0 otherwise (binary)"
    ],
    "parameters": [
      "cost_per_shift[o,j]: cost per shift of assigning operator o to job j (only defined for eligible pairs)",
      "job_required[j,p]: 1 if job j needs coverage in period p, 0 otherwise",
      "max_jobs_per_shift[o]: maximum number of jobs operator o can handle in any single shift"
    ],
    "additional_notes": "The assign variable is 3-dimensional with domain filtering on the (operator, job) dimension — only certified (operator, job) pairs are included. The job_required parameter defines which (job, period) slots need to be covered.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "eligible_operators": "eligible_operators.csv",
      "operators": "operators.csv",
      "job_requirements": "job_requirements.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "sparse filter"
  ],
