            "indices": [
              "p"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "sell_limit_demand": {
        "domain": [
          "Products",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "type": "variable",
            "name": "sell",
            "indices": [
              "p",
              "s"
            ]
          },
          "right": {
            "type": "parameter",
            "name": "demand",
            "indices": [
              "p",
              "s"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "inventory_balance": {
        "domain": [
          "Products",
          "Scenarios"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "sell",
              "indices": [
                "p",
                "s"
              ]
            },
            "right": {
              "type": "variable",
