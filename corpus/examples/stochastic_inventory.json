{
  "problem": {
    "title": "Stochastic Newsvendor — Multi-Product",
    "description": "A retailer orders multiple products before the selling season. Demand for each product is uncertain with 3 equally likely scenarios. For each scenario the retailer sells min(order, demand) and salvages leftover units. Maximize expected profit (revenue from sales plus salvage value minus ordering cost).",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Expected profit = E[sell_price * sell + salvage_price * leftover - unit_cost * order]",
    "constraints": [
      {
        "description": "sell_limit_order: units sold cannot exceed the order quantity"
      },
      {
        "description": "sell_limit_demand: units sold cannot exceed the realised demand"
      },
      {
        "description": "inventory_balance: sell + leftover = order (balance split variables to order quantity)"
      }
    ],
    "decision_variables": [
      "order[Products]: first-stage order quantity before demand is known (continuous, non-negative)",
      "sell[Products,Scenarios]: units sold in scenario s (continuous, non-negative)",
      "leftover[Products,Scenarios]: unsold units in scenario s (continuous, non-negative)"
    ],
    "parameters": [
      "unit_cost[Products]: ordering cost per unit",
      "sell_price[Products]: revenue per unit sold",
      "salvage_price[Products]: salvage value per unsold unit",
      "demand[Products,Scenarios]: demand in each scenario",
      "probability[Scenarios]: scenario probability"
    ],
    "additional_notes": "Optimal orders: order the maximum demand (high scenario) since sell price exceeds salvage. Expected objective ~1906.2.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv",
      "scenarios": "scenarios.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "products",
