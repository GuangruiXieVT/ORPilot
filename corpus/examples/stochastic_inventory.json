        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "subtract",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Scenarios:s",
            "Products:p"
          ],
          "body": {
            "operation": "multiply",
            "left": {
