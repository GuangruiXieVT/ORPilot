{
  "problem": {
    "title": "Dog Food Production Profit Maximization",
    "description": "Healthy Pet Foods Company produces two types of dog food: Meaties and Yummies. Each pack of Meaties uses 2 lbs grain + 3 lbs meat; each Yummies pack uses 3 lbs grain + 1.5 lbs meat. Monthly limits: 400,000 lbs grain ($0.20/lb) and 300,000 lbs meat ($0.50/lb). Meaties have a special machine capacity of 90,000 packs/month. Variable (mixing/packaging) cost: $0.25/pack Meaties, $0.20/pack Yummies. Selling price: $2.80 Meaties, $2.00 Yummies. Maximize monthly profit.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Monthly profit = revenue minus raw material and variable production costs",
    "constraints": [
      {
        "description": "Total grain used across all products cannot exceed monthly grain supply"
      },
      {
        "description": "Total meat used across all products cannot exceed monthly meat supply"
      },
      {
        "description": "Meaties production cannot exceed the special machine monthly capacity of 90,000 packs"
      }
    ],
    "decision_variables": [
      "produce[p]: number of packs of product p to produce per month (continuous, non-negative)"
    ],
    "parameters": [
      "profit_per_pack[p]: net profit per pack after subtracting raw material and variable costs (meaties=0.65, yummies=0.45)",
      "resource_use[p,r]: lbs of resource r required per pack of product p",
      "resource_limit[r]: monthly supply limit in lbs for resource r",
      "machine_capacity[p]: monthly production cap for product p (sparse, only meaties has 90000)"
    ],
    "additional_notes": "Profit per pack computed as: price - grain_cost - meat_cost - variable_cost. Meaties: 2.80 - 0.40 - 1.50 - 0.25 = 0.65. Yummies: 2.00 - 0.60 - 0.75 - 0.20 = 0.45. Machine capacity stored as sparse parameter (only meaties row exists); constraint uses sparse_filter=true. Optimal: produce[meaties]=50000, produce[yummies]=100000, obj=77500.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "profit": "profit.csv",
      "resource_use": "resource_use.csv",
      "resource_limit": "resource_limit.csv",
      "machine_capacity": "machine_capacity.csv"
    }
  },
  "csv_schemas": {
    "sets": {
