      },
      "sample": {
        "product_id": "meaties",
        "profit": 0.65
      },
      "optional": false,
      "distinct_values": {
        "product_id": [
          "meaties",
          "yummies"
        ],
        "profit": [
          "0.45",
          "0.65"
        ]
      }
    },
