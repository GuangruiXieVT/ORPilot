    }
  },
  "ir": {
    "problem_class": "ProductionLP",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Resources": {
        "size": null,
        "index_symbol": "r",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "resources",
        "ordered": false
      }
    },
    "parameters": {
      "profit_per_pack": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "profit.csv",
        "column": "profit",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "zero"
      },
      "resource_use": {
        "domain": [
          "Products",
          "Resources"
        ],
        "type": "float",
        "source": "resource_use.csv",
        "column": "amount_per_pack",
        "index_columns": [
          "product_id",
          "resource_id"
        ],
        "missing_default": "zero"
      },
      "resource_limit": {
        "domain": [
          "Resources"
        ],
        "type": "float",
        "source": "resource_limit.csv",
        "column": "max_amount",
        "index_columns": [
          "resource_id"
        ],
        "missing_default": "inf"
      },
      "machine_capacity": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "machine_capacity.csv",
        "column": "capacity",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "produce": {
        "description": "Number of packs of product p to produce per month",
        "label": "produce",
        "domain": [
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "resource_limit_constr": {
        "domain": [
          "Resources"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "resource_use",
              "indices": [
                "p",
                "r"
              ]
            },
            "right": {
              "type": "variable",
              "name": "produce",
              "indices": [
                "p"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "resource_limit",
          "indices": [
            "r"
          ]
        }
      },
      "machine_cap_constr": {
        "domain": [
          "Products"
        ],
        "sparse_filter": "machine_capacity",
        "expression": {
          "type": "variable",
          "name": "produce",
          "indices": [
            "p"
          ]
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "machine_capacity",
          "indices": [
            "p"
          ]
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Products:p"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "profit_per_pack",
            "indices": [
              "p"
            ]
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "sparse filter"
  ]
}