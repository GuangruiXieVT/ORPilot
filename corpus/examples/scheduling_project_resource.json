          "Periods"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "schedule_cost"
      }
    },
    "constraints": {
      "each_activity_once": {
        "domain": [
