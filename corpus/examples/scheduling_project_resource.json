          ],
          "body": {
            "type": "variable",
            "name": "start",
            "indices": [
              "a",
              "w"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "resource_cap": {
        "domain": [
          "Resources",
          "Periods"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Activities:a"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "resource_req",
              "indices": [
                "a",
                "r"
              ]
            },
            "right": {
              "type": "variable",
              "name": "start",
              "indices": [
                "a",
                "w"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "resource_capacity",
          "indices": [
            "r",
            "w"
          ]
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Activities:a",
          "Periods:w"
        ],
        "body": {
