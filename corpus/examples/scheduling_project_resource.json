{
  "problem": {
    "title": "Resource-Constrained Project Scheduling",
    "description": "A construction project involves six activities, each requiring various amounts of three resources (labor, equipment, material). The project is planned over six weekly periods. Each activity must be executed in exactly one period, with eligible periods constrained by earliest and latest start times. Resource availability varies by period. In any period, the total resource consumption across all activities scheduled that period must not exceed the available capacity for each resource. Scheduling an activity in a later period typically costs more. Minimize total scheduling cost while satisfying all resource constraints and time windows.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost of scheduling all activities across their assigned periods",
    "constraints": [
      {
        "description": "Each activity must be scheduled in exactly one eligible period (within its time window)"
      },
      {
        "description": "For each resource in each period, the total resource consumption across all activities scheduled in that period must not exceed the available capacity"
      }
    ],
    "decision_variables": [
      "start[a,w]: 1 if activity a is scheduled in period w (only for eligible period windows), 0 otherwise (binary)"
    ],
    "parameters": [
      "schedule_cost[a,w]: cost of scheduling activity a in period w (only defined for eligible windows)",
      "resource_req[a,r]: units of resource r required by activity a",
      "resource_capacity[r,w]: available units of resource r in period w"
    ],
    "additional_notes": "The start variable is sparse: only (activity, period) pairs within the activity's time window are eligible. Resource requirements are also sparse (not every activity uses every resource). Both sparsities are handled via domain filtering.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "schedule_cost": "schedule_cost.csv",
      "resource_requirements": "resource_requirements.csv",
      "resource_capacity": "resource_capacity.csv"
    }
  },
