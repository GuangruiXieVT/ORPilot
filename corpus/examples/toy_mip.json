{
  "problem": {
    "title": "Toy Manufacturing MIP: Maximize Profit with Logical Production Rules",
    "description": "Factory makes robots ($15 profit), model cars ($8), building blocks ($12), dolls ($5). Resources: 1200 plastic units, 800 electronics units. Usage per unit: robot(30p,8e), car(10p,5e), block(20p,3e), doll(15p,2e). Rules: if robots produced → no dolls; if cars produced → blocks must also be produced; dolls ≤ cars count. Maximize profit.",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Profit = 15*x_robots + 8*x_cars + 12*x_blocks + 5*x_dolls",
    "constraints": [
      {
        "description": "Plastic: 30*robots + 10*cars + 20*blocks + 15*dolls <= 1200"
      },
      {
        "description": "Electronics: 8*robots + 5*cars + 3*blocks + 2*dolls <= 800"
      },
      {
        "description": "Dolls <= cars: x_dolls <= x_cars"
      },
      {
        "description": "Robots indicator: x_robots <= 10000 * z_robots"
      },
      {
        "description": "If robots, no dolls: x_dolls <= 10000 * (1 - z_robots)"
      },
      {
        "description": "Cars indicator: x_cars <= 10000 * z_cars"
      },
      {
        "description": "If cars, must produce blocks: x_blocks >= z_cars"
      }
    ],
    "decision_variables": [
      "x_robots, x_cars, x_blocks, x_dolls: continuous production amounts (>=0)",
      "z_robots, z_cars: binary indicators (1 if that product is manufactured)"
    ],
    "parameters": [],
    "additional_notes": "Optimal: x_cars=118, x_blocks=1. Profit=8*118+12*1=956."
  },
