{
  "problem": {
    "title": "Three-Tier Distribution Network Flow",
    "description": "A logistics company operates a three-tier distribution network: manufacturing plants ship goods to regional warehouses, which then forward them to end retailers. Each plant has a maximum supply capacity. Each retailer has a fixed demand that must be exactly met. Arcs between tiers have both a per-unit shipping cost and a throughput capacity limit. Not all plant-warehouse and warehouse-retailer pairs have established shipping lanes — only arcs present in the cost tables are valid. Flow must be conserved at each warehouse: total inflow from plants must equal total outflow to retailers. Find the minimum-cost flow plan that satisfies all retailer demands without violating any arc or plant capacity.",
    "problem_type": "network_flow",
    "objective": "minimize",
    "objective_description": "Total shipping cost across all plant-to-warehouse and warehouse-to-retailer arcs, weighted by flow volume on each arc",
    "constraints": [
      {
        "description": "Total flow shipped out of each plant across all outgoing arcs must not exceed that plant's supply capacity"
      },
      {
        "description": "Total flow received by each retailer across all incoming arcs must exactly equal that retailer's demand"
      },
      {
        "description": "For each warehouse, total flow arriving from all plants must equal total flow departing to all retailers (flow conservation)"
      },
      {
        "description": "Flow on each plant-to-warehouse arc must not exceed that arc's capacity"
      },
      {
        "description": "Flow on each warehouse-to-retailer arc must not exceed that arc's capacity"
      }
    ],
    "decision_variables": [
      "flow_pw[i,w]: units shipped from plant i to warehouse w (continuous, non-negative, defined only for valid arcs)",
      "flow_wr[w,r]: units shipped from warehouse w to retailer r (continuous, non-negative, defined only for valid arcs)"
    ],
    "parameters": [
      "supply[i]: maximum supply available at plant i",
      "demand[r]: demand that must be exactly fulfilled at retailer r",
      "cost_pw[i,w]: per-unit shipping cost from plant i to warehouse w (defined only for valid arcs)",
      "cost_wr[w,r]: per-unit shipping cost from warehouse w to retailer r (defined only for valid arcs)",
      "cap_pw[i,w]: maximum throughput capacity on the arc from plant i to warehouse w (defined only for valid arcs)",
      "cap_wr[w,r]: maximum throughput capacity on the arc from warehouse w to retailer r (defined only for valid arcs)"
    ],
    "additional_notes": "Arc parameters are defined only for valid lanes. Missing entries imply no established arc between that pair.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "plants": "plants.csv",
      "retailers": "retailers.csv",
      "arc_costs_pw": "arc_costs_pw.csv",
      "arc_costs_wr": "arc_costs_wr.csv",
      "arc_caps_pw": "arc_caps_pw.csv",
      "arc_caps_wr": "arc_caps_wr.csv"
    }
  },
