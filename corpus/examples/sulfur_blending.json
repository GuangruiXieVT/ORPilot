  },
  "ir": {
    "problem_class": "SulfurBlendingLP",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "RawMaterials": {
        "size": null,
        "index_symbol": "r",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "raw_materials",
        "ordered": false
      },
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      }
    },
    "parameters": {
      "sulfur_excess": {
        "domain": [
          "RawMaterials",
          "Products"
        ],
        "type": "float",
        "source": "blend_params.csv",
        "column": "sulfur_excess",
        "index_columns": [
          "raw_id",
          "product_id"
        ],
        "missing_default": "zero"
      },
      "net_value": {
        "domain": [
          "RawMaterials",
          "Products"
        ],
        "type": "float",
        "source": "blend_params.csv",
        "column": "net_value",
        "index_columns": [
          "raw_id",
          "product_id"
        ],
        "missing_default": "zero"
      },
      "demand": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "demand.csv",
        "column": "demand",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "use": {
        "description": "Tons of raw material r used to produce product p",
        "label": "use",
        "domain": [
          "RawMaterials",
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "demand_limit": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "RawMaterials:r"
            ],
            "body": {
              "type": "variable",
              "name": "use",
              "indices": [
                "r",
                "p"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "demand",
            "indices": [
              "p"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "sulfur_constr": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "RawMaterials:r"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "sulfur_excess",
              "indices": [
                "r",
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "use",
              "indices": [
                "r",
                "p"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "d_supply": {
        "domain": [],
        "expression": {
          "operation": "sum",
          "left": {
            "type": "variable",
            "name": "use",
            "indices": [
              "D",
              "PA"
            ]
          },
          "right": {
            "type": "variable",
            "name": "use",
            "indices": [
              "D",
              "PB"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 50
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "RawMaterials:r",
          "Products:p"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "net_value",
            "indices": [
              "r",
              "p"
            ]
          },
          "right": {
            "type": "variable",
            "name": "use",
            "indices": [
              "r",
              "p"
            ]
          }
        }
      }
    }
  },
