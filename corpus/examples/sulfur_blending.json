{
  "problem": {
    "title": "Sulfur Blending LP: Maximize Profit from Two Petroleum Products",
    "description": "Blend 4 raw materials (A, B, C, D) to produce 2 petroleum products (PA, PB). Raw material sulfur contents: A=3%, B=1%, C=2%, D=1%. Prices (thousand yuan/ton): A=6, B=16, C=10, D=15. D supply limit: 50 tons. Both products sell at 9.15 thousand yuan/ton. PA: sulfur ≤ 2.5%, max demand 100 tons. PB: sulfur ≤ 1.5%, max demand 200 tons. Maximize profit = total revenue - total raw material cost.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total profit (thousand yuan) = sum over all raw-product pairs of net_value[r,p] * use[r,p]",
    "constraints": [
      {
        "description": "Demand limit: total use of raw materials for product p does not exceed max demand for p"
      },
      {
        "description": "Sulfur constraint: sum of sulfur contributions for product p does not exceed sulfur limit for p times total production of p"
      },
      {
        "description": "D supply limit: total D used across both products <= 50 tons"
      }
    ],
    "decision_variables": [
      "use[r,p]: tons of raw material r used to produce product p (continuous, non-negative)"
    ],
    "parameters": [
      "sulfur_excess[r,p]: sulfur_content[r] - sulfur_limit[p], precomputed coefficient for sulfur constraint",
      "net_value[r,p]: sell_price[p] - raw_cost[r], precomputed per-unit profit contribution",
      "demand[p]: maximum market demand for product p"
    ],
    "additional_notes": "Two sets: RawMaterials={A,B,C,D} and Products={PA,PB}. Both products sell at 9.15 thousand yuan/ton. Optimal: produce only PA (100 tons) since PB is unprofitable at 9.15/ton with expensive B/D needed for low sulfur. use[A,PA]=50, use[C,PA]=50. Revenue=9.15*100=915k. Cost=6*50+10*50=800k. Profit=115k yuan. Obj=115.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "blend_params": "blend_params.csv",
      "demand": "demand.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "raw_materials",
        "element": "A"
      },
