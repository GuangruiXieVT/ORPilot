{
  "problem": {
    "title": "Transport MIP: XOR Vehicle Exclusion with Pollution Minimization",
    "description": "Transport 1800+ units using four vehicle types: truck (cap=100/trip, poll=100), van (cap=80, poll=50), motorcycle (cap=40, poll=10), EV (cap=60, poll=0). Due to energy constraints, van and EV cannot both be used (XOR). At least 10 truck trips required. Total pollution ≤ 2000. Minimize total pollution.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total pollution = 100*n_truck + 50*n_van + 10*n_moto + 0*n_ev",
    "constraints": [
      {
        "description": "Deliver at least 1800 units: 100*n_truck + 80*n_van + 40*n_moto + 60*n_ev >= 1800"
      },
      {
        "description": "Pollution cap: 100*n_truck + 50*n_van + 10*n_moto <= 2000"
      },
      {
        "description": "Minimum truck trips: n_truck >= 10"
      },
      {
        "description": "Van XOR EV: z_van + z_ev <= 1 (at most one of van or EV used)"
      },
      {
        "description": "Van trips require z_van=1: n_van <= M*z_van"
      },
      {
        "description": "EV trips require z_ev=1: n_ev <= M*z_ev"
      }
    ],
    "decision_variables": [
      "n_truck, n_van, n_moto, n_ev: integer trip counts (>=0)",
      "z_van, z_ev: binary, 1 if that vehicle type is used"
    ],
    "parameters": [],
    "additional_notes": "All scalar variables, no CSV data. Optimal: 10 truck trips + 100 EV trips. Pollution = 1000."
  },
