{
  "problem": {
    "title": "Machine Selection MIP: Minimize Cost with Fixed Setup and Variable Production",
    "description": "2000 units of a product must be produced on one or more of four devices (A,B,C,D). Each device has a fixed preparation/setup cost plus a per-unit production cost and a maximum capacity. Minimize total cost = sum of (setup_cost[d]*open[d] + unit_cost[d]*produce[d]) where open[d] is binary.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum(setup_cost[d]*open[d] + unit_cost[d]*produce[d]) over all devices",
    "constraints": [
      {
        "description": "Total production must meet demand: sum(produce[d]) >= 2000"
      },
      {
        "description": "Production per device cannot exceed its capacity: produce[d] <= max_capacity[d] * open[d]"
      }
    ],
    "decision_variables": [
      "open[d]: binary, 1 if device d is activated (setup cost paid)",
      "produce[d]: units produced on device d (continuous, >=0)"
    ],
    "parameters": [
      "setup_cost[d]: fixed setup/preparation cost for device d",
      "unit_cost[d]: variable production cost per unit on device d",
      "max_capacity[d]: maximum units device d can produce"
    ],
    "additional_notes": "Optimal: use A (produce=800) + C (produce=1200). Setup: 1000+800=1800. Variable: 20*800+16*1200=16000+19200=35200. Total=37000."
  },
  "csv_schemas": {
    "devices": {
      "columns": {
        "device_id": "str",
        "setup_cost": "float",
        "unit_cost": "float",
        "max_capacity": "float"
      },
      "sample": {
        "device_id": "A",
        "setup_cost": 1000,
        "unit_cost": 20,
        "max_capacity": 900
      },
      "optional": false,
      "distinct_values": {
