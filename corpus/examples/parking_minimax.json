{
  "problem": {
    "title": "Car Parking Minimax: Minimize Maximum Side Length",
    "description": "15 cars must be parked on either side A or side B of a street. Each car has a known length. The total occupied street length on each side is the sum of lengths of cars parked there. Minimize the maximum occupied length across both sides, so that the total street block required is as short as possible. All 15 cars must be parked (each on exactly one side).",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Maximum total occupied length across the two sides of the street",
    "constraints": [
      {
        "description": "The total length of cars on side A must not exceed the minimax variable max_len"
      },
      {
        "description": "The total length of cars on side B (total_length - side_A) must not exceed max_len"
      }
    ],
    "decision_variables": [
      "side[c]: 1 if car c parks on side A, 0 if on side B (binary)",
      "max_len: maximum occupied length across both sides (scalar continuous, non-negative)"
    ],
    "parameters": [
      "car_length[c]: length of car c in meters"
    ],
    "additional_notes": "Total length of all cars = 57.1 m. Side A = sum(length[c]*side[c]). Side B = 57.1 - side A. max_len >= side A and max_len >= side B. Uses scalar variable pattern (domain=[]) for max_len, and two scalar constraints for the minimax bounds. Objective minimizes max_len directly. Optimal: max_len = 28.6 (side A = 28.5, side B = 28.6).",
    "csv_file_paths": {
      "cars": "cars.csv"
    }
  },
