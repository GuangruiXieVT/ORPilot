{
  "problem": {
    "title": "Single-Product Inventory Planning with Demand Backlogging",
    "description": "A retailer manages a single product over a multi-period planning horizon. In each period the retailer may place an order (up to a maximum order size) to replenish stock. Demand is known but may exceed the available supply in some periods; unmet demand is backlogged at a per-unit penalty cost and carried forward to be satisfied in a later period. On-hand inventory earns a holding cost. The goal is to determine order quantities that minimize total ordering, holding, and backlog penalty costs while respecting the order size limit.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = ordering cost per unit ordered + holding cost per unit of on-hand inventory + backlog penalty per unit of unmet demand, summed across all periods",
    "constraints": [
      {
        "description": "Inventory-backlog balance initialization: first-period on-hand inventory minus backlog equals initial inventory plus order minus demand"
      },
      {
        "description": "Inventory-backlog balance: change in (inventory minus backlog) equals order minus demand in each subsequent period (temporal lag)"
      },
      {
        "description": "Order quantity in each period must not exceed the maximum order size"
      }
    ],
    "decision_variables": [
      "order[t]: units ordered at the start of period t (continuous, non-negative)",
      "inventory[t]: on-hand inventory at end of period t (continuous, non-negative)",
      "backlog[t]: unmet cumulative demand at end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[t]: known demand in period t",
      "initial_inventory: on-hand inventory at the start of the planning horizon",
      "order_cost: per-unit ordering cost",
      "holding_cost: per-unit per-period inventory holding cost",
      "backlog_penalty: per-unit per-period penalty for unfilled demand",
      "max_order: maximum units that can be ordered in any single period"
    ],
    "additional_notes": "The net inventory position (inventory - backlog) follows a balance equation with a temporal lag. The inventory and backlog variables split the signed net position into non-negative components, allowing the model to capture both surplus and shortage in each period.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "periods": "periods.csv",
      "cost_params": "cost_params.csv"
    }
  },
  "ir_patterns": [
    "ordered set",
    "temporal lag",
    "init constraint",
    "scalar parameter",
    "deviation variables"
  ],
