{
  "problem": {
    "title": "Single-Product Multi-Period Inventory Planning",
    "description": "A retailer stocks a single product over a planning horizon of several periods. At the start of each period the retailer may place an order to replenish stock, subject to a maximum order size per period. Known demand in each period must be fully met from available inventory. Unsold stock carries over to the next period as ending inventory, incurring a per-unit holding cost. Each unit ordered incurs a per-unit ordering cost. There is a known initial inventory level at the start of the planning horizon. Determine the order quantities in each period to minimize total ordering plus holding costs while meeting all period demands. The inventory balance equation links inventory levels across adjacent periods via a temporal lag.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of per-unit ordering costs times units ordered plus per-unit holding costs times ending inventory, summed across all periods",
    "constraints": [
      {
        "description": "In the first period, ending inventory equals initial inventory plus the order quantity minus demand (inventory balance initialization)"
      },
      {
        "description": "In each subsequent period, ending inventory equals previous period's ending inventory plus the order quantity minus demand (temporal lag inventory balance)"
      },
      {
        "description": "Order quantity in each period must not exceed the maximum order size"
      }
    ],
    "decision_variables": [
      "order[t]: units ordered at the start of period t (continuous, non-negative)",
      "inventory[t]: units of inventory held at the end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[t]: known demand for the product in period t",
      "order_cost: per-unit ordering cost (same for all periods)",
      "holding_cost: per-unit holding cost for inventory carried between periods (same for all periods)",
      "initial_inventory: units of inventory on hand at the start of the planning horizon",
      "max_order: maximum units that can be ordered in any single period"
    ],
    "additional_notes": "The inventory balance constraint uses a temporal lag (inventory[t-1]) to link adjacent periods. The initialization constraint handles the first period separately using initial_inventory.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "periods": "periods.csv",
      "cost_params": "cost_params.csv"
    }
  },
  "ir_patterns": [
    "ordered set",
    "temporal lag",
    "init constraint",
    "scalar parameter"
  ],
