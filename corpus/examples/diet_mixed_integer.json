{
  "problem": {
    "title": "Mixed-Integer Diet Problem with Binary Vegetable Selection",
    "description": "Mary wants to maximize protein intake for dinner. She can buy proteins (chicken, salmon, tofu) in any continuous quantity (100g units) and vegetables (broccoli, carrots, spinach, bell pepper, mushrooms) in integer packs of 100g. She must select at least 3 different vegetable types (binary selection variable). A linking constraint ensures zero packs are bought for unselected vegetables. Total budget is $20 and total weight must not exceed 800g (8 units of 100g each).",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Total protein intake in grams from all selected proteins and vegetables",
    "constraints": [
      {
        "description": "Budget: total cost of all proteins and vegetables does not exceed $20"
      },
      {
        "description": "Weight: total weight (sum of all units) does not exceed 8 units (800g)"
      },
      {
        "description": "Minimum variety: at least 3 different vegetable types must be selected (sum of veg_selected >= 3)"
      },
      {
        "description": "Vegetable upper link: packs bought are zero if not selected (eat_veg[v] <= big_m * veg_selected[v])"
      },
      {
        "description": "Vegetable lower link: if vegetable is selected at least 1 pack must be bought (veg_selected[v] <= eat_veg[v])"
      }
    ],
    "decision_variables": [
      "eat_protein[p]: quantity of protein p in 100g units (continuous, non-negative)",
      "eat_veg[v]: integer packs of vegetable v to buy (integer, non-negative)",
      "veg_selected[v]: binary, 1 if any packs of vegetable v are bought"
    ],
    "parameters": [
      "protein_per_100g[p]: grams of protein per 100g unit of protein food p",
      "cost_per_100g[p]: cost per 100g unit of protein food p",
      "protein_per_pack[v]: grams of protein per 100g pack of vegetable v",
      "cost_per_pack[v]: cost per 100g pack of vegetable v",
      "budget: total spending budget ($20)",
      "max_weight_units: maximum total units of food (8 units = 800g)",
      "min_veg_types: minimum number of different vegetable types to select (3)",
      "big_m: big-M upper bound for linking constraint (equal to max_weight_units)"
    ],
    "additional_notes": "Key patterns: (1) Two separate item types with different variable types: Proteins (continuous) and Vegetables (integer). Both sets come from the same sets.csv using filter_column. (2) Binary veg_selected variable with TWO linking constraints: upper (eat_veg <= big_m*veg_selected forces zero if unselected) AND lower (veg_selected <= eat_veg forces at least 1 pack if selected). Both directions are required. (3) A single budget constraint spans both Proteins and Vegetables sets, requiring a sum of two indexed_sums. (4) min_veg_types is a scalar parameter from parameters.csv (wide format, single row). (5) big_m = max_weight_units ensures eat_veg is bounded above.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "proteins": "proteins.csv",
      "vegetables": "vegetables.csv",
      "parameters": "parameters.csv"
    }
  },
