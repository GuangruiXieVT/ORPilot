{
  "problem": {
    "title": "Child Selection MIP: Minimize Trip Cost with Logical Constraints",
    "description": "Family with 6 children: Harry ($1200), Hermione ($1650), Ron ($750), Fred ($800), George ($800), Ginny ($1500). Take 3-4 children on trip. Ginny must go. Rules: Harry→not Fred, Harry→not George, George→Fred, George→Hermione. Minimize total cost.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of child costs for selected children",
    "constraints": [
      {
        "description": "Ginny must be taken: z_ginny = 1"
      },
      {
        "description": "At most 4 children: sum(z) <= 4"
      },
      {
        "description": "At least 3 children: sum(z) >= 3"
      },
      {
        "description": "Harry and Fred cannot both go: z_harry + z_fred <= 1"
      },
      {
        "description": "Harry and George cannot both go: z_harry + z_george <= 1"
      },
      {
        "description": "If George goes, Fred must go: z_george <= z_fred"
      },
      {
        "description": "If George goes, Hermione must go: z_george <= z_hermione"
      }
    ],
    "decision_variables": [
      "z_harry, z_hermione, z_ron, z_fred, z_george, z_ginny: binary, 1 if child is taken"
    ],
    "parameters": [],
    "additional_notes": "All scalar binary variables, no CSV. Optimal: take Ginny+Ron+Fred = 1500+750+800 = 3050."
  },
