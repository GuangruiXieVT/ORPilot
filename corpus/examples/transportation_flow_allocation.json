{
  "problem": {
    "title": "Multi-Product Multi-Period Transportation with Route-Level and Site-Level Flow Allocation",
    "description": "A regional distribution company ships two product types (Product A and Product B) from three warehouses to four retail customers over three time periods. Only eight of the twelve possible warehouse-customer routes have established shipping lanes. Each route has a fixed per-unit shipping cost shared across all products and periods. Each warehouse has a known supply capacity for each product in each period. Each customer has a fixed demand for each product in each period that must be exactly fulfilled. Additionally, certain routes are subject to flow allocation constraints: the total flow on a given route from a warehouse (summed over products) must be at least a specified percentage of the total flow on another route from the same warehouse. Similarly, certain warehouse pairs are subject to site-level flow allocation constraints: the total flow through one warehouse (summed over all routes, products, and in each period) must be at least a specified percentage of the total flow through another warehouse in that period. Determine how much of each product to ship along each valid route in each period to fulfill all customer demands without exceeding warehouse supplies, while satisfying all route-level and site-level flow allocation requirements, at minimum total shipping cost.",
    "problem_type": "linear",
    "objective": "minimize",
    "objective_description": "Total shipping cost summed over all valid routes, products, and periods, weighted by the amount shipped",
    "constraints": [
      {
        "description": "For each warehouse, product, and period, the total amount of that product shipped out across all valid routes must not exceed the warehouse's supply of that product in that period"
      },
      {
        "description": "For each customer, product, and period, the total amount of that product shipped in from any warehouse via valid routes must exactly equal the customer's demand for that product in that period"
      },
      {
        "description": "For each (warehouse, primary-customer, reference-customer, period) tuple listed in the route allocation table, the total flow (summed over products) shipped from the warehouse to the primary customer must be at least a specified percentage of the total flow shipped from the same warehouse to the reference customer in that period; trivially satisfied (0 >= 0) for all other combinations"
      },
      {
        "description": "For each (warehouse1, warehouse2, period) tuple listed in the site allocation table, the total flow (summed over all customers and products) shipped out of warehouse1 must be at least a specified percentage of the total flow shipped out of warehouse2 in that period; trivially satisfied for all other combinations"
      }
    ],
    "decision_variables": [
      "ship[w,c,p,t]: amount of product p shipped from warehouse w to customer c in period t (continuous, non-negative, defined only for valid warehouse-customer routes)"
    ],
    "parameters": [
      "transport_cost[w,c]: cost per unit shipped from warehouse w to customer c, shared across all products and periods (defined only for the subset of valid routes)",
      "supply[w,p,t]: supply of product p available at warehouse w in period t",
      "demand[c,p,t]: demand for product p required by customer c in period t, which must be exactly met",
      "min_route_share_pct[w,c1,c2]: minimum fraction such that total flow from warehouse w to customer c1 must be at least this fraction of total flow from warehouse w to customer c2 (sparse: defined only for constrained route pairs)",
      "min_site_share_pct[w1,w2]: minimum fraction such that total flow through warehouse w1 must be at least this fraction of total flow through warehouse w2 per period (sparse: defined only for constrained warehouse pairs)"
    ],
    "additional_notes": "The route-level and site-level allocation constraints enforce proportional flow relationships that model business rules such as minimum channel commitments, balanced utilization across warehouses, or contractual minimum shipment obligations. Both constraint types use sparse parameter tables — combinations absent from the table impose no allocation requirement (equivalent to a zero minimum share). The diagonal guard (i1==i2 or j1==j2) is automatically skipped by the compiler since a node compared to itself is always feasible.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "transport_links": "transport_links.csv",
      "supply_data": "supply_data.csv",
      "demand_data": "demand_data.csv",
      "min_route_share_pct": "min_route_share_pct.csv",
      "min_site_share_pct": "min_site_share_pct.csv"
    }
  },
  "ir_patterns": [
