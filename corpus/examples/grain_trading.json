{
  "problem": {
    "title": "Grain Trading Profit Maximization over 3 Months",
    "description": "A trading company buys and sells grain over 3 months to maximize profit. Warehouse capacity: 5000 dan. Initial inventory: 1000 dan. Initial cash: 20000 yuan. End-of-quarter inventory must be >= 2000 dan. Grain bought in month t can only be sold from month t+1 onward (initial stock can be sold in month 1). Cash cannot go negative at any point. Buy/sell prices vary by month.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total profit = sum over months of (sell_price[t]*sell[t] - buy_price[t]*buy[t])",
    "constraints": [
      {
        "description": "Inventory balance for month 1 (initial inventory = 1000): inv[m1] = 1000 + buy[m1] - sell[m1]"
      },
      {
        "description": "Inventory balance for months 2-3: inv[t] = inv[t-1] + buy[t] - sell[t]"
      },
      {
        "description": "Sell limit month 1: sell[m1] <= 1000 (can only sell initial stock, not m1 purchases)"
      },
      {
        "description": "Sell limit months 2-3: sell[t] <= inv[t-1] (can only sell stock from previous month)"
      },
      {
        "description": "Warehouse capacity: inv[t] <= 5000 for each month"
      },
      {
        "description": "End-of-quarter inventory: inv[m3] >= 2000"
      },
      {
        "description": "Cash balance for month 1 (initial cash = 20000): cash[m1] = 20000 + sell_price[m1]*sell[m1] - buy_price[m1]*buy[m1]"
      },
      {
        "description": "Cash balance for months 2-3: cash[t] = cash[t-1] + sell_price[t]*sell[t] - buy_price[t]*buy[t]"
      },
      {
        "description": "Cash non-negativity: cash[t] >= 0 (enforced via lower_bound on cash variable)"
      }
    ],
    "decision_variables": [
      "buy[t]: dan of grain purchased in month t (continuous, non-negative)",
      "sell[t]: dan of grain sold in month t (continuous, non-negative)",
      "inv[t]: dan of grain in warehouse at end of month t (continuous, non-negative)",
      "cash[t]: cash balance at end of month t (continuous, non-negative)"
    ],
    "parameters": [
      "buy_price[t]: purchase price per dan in month t (yuan)",
      "sell_price[t]: selling price per dan in month t (yuan)"
    ],
    "additional_notes": "Optimal: buy=[5000,0,2000], sell=[1000,5000,0], inv=[5000,0,2000], cash=[8850,25100,19300]. Profit = 19300-20000 = -700 yuan (company loses money due to forced end-inventory requirement). Month prices: m1=(2.85,3.10), m2=(3.05,3.25), m3=(2.90,2.95).",
    "csv_file_paths": {
      "months": "months.csv"
    }
  },
  "csv_schemas": {
    "months": {
      "columns": {
        "month_id": "str",
        "buy_price": "float",
        "sell_price": "float"
      },
