{
  "problem": {
    "title": "Operating Room Scheduling",
    "description": "A hospital schedules surgeries to operating rooms and surgeons. Each surgery can only be performed by eligible surgeons (sparse). Each surgery takes a known number of time blocks. ORs and surgeons have capacity limits. Surgeries are scheduled at most once (some may not be performed if capacity is insufficient). Maximize total priority-weighted surgeries performed.",
    "problem_type": "mixed_integer",
    "objective": "maximize",
    "objective_description": "Total priority = sum over all assignments of priority[surgery] * assign[surgery, or, surgeon]",
    "constraints": [
      {
        "description": "Each surgery is performed at most once (across all ORs and surgeons)"
      },
      {
        "description": "OR capacity: total duration of assigned surgeries per OR cannot exceed OR capacity"
      },
      {
        "description": "Surgeon workload: total duration of assigned surgeries per surgeon cannot exceed surgeon capacity"
      }
    ],
    "decision_variables": [
      "assign[Surgeries, ORs, Surgeons]: 1 if surgery s is assigned to OR o with surgeon sg (binary, sparse by eligibility)"
    ],
    "parameters": [
      "eligible[Surgeries, Surgeons]: 1 if surgeon sg is eligible for surgery s (sparse)",
      "duration[Surgeries]: time blocks required by surgery s",
      "or_capacity[ORs]: total time blocks available in OR o",
      "surgeon_capacity[Surgeons]: total time blocks surgeon sg can work",
      "priority[Surgeries]: urgency score of surgery s"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "eligibility": "eligibility.csv",
      "surgeries": "surgeries.csv",
      "ors": "ors.csv",
      "surgeons": "surgeons.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "3D variable",
    "multiply parameter in sum",
    "maximize priority"
  ],
  "csv_schemas": {
