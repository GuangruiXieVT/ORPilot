    },
    "variables": {
      "assign": {
        "description": "1 if surgery s is assigned to OR o with surgeon sg",
        "label": "surgery_assignments",
        "domain": [
          "Surgeries",
          "ORs",
          "Surgeons"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "eligible"
      }
    },
    "constraints": {
      "surgery_once": {
        "domain": [
          "Surgeries"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "ORs:o",
            "Surgeons:sg"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "s",
              "o",
              "sg"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "or_cap_limit": {
        "domain": [
          "ORs"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Surgeries:s",
              "Surgeons:sg"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "duration",
                "indices": [
                  "s"
                ]
              },
              "right": {
                "type": "variable",
                "name": "assign",
                "indices": [
                  "s",
                  "o",
                  "sg"
                ]
              }
            }
          },
          "right": {
            "type": "parameter",
            "name": "or_capacity",
            "indices": [
              "o"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "surgeon_workload": {
        "domain": [
          "Surgeons"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Surgeries:s",
              "ORs:o"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "duration",
                "indices": [
                  "s"
                ]
              },
              "right": {
                "type": "variable",
                "name": "assign",
                "indices": [
                  "s",
                  "o",
                  "sg"
                ]
              }
            }
          },
          "right": {
            "type": "parameter",
            "name": "surgeon_capacity",
            "indices": [
              "sg"
            ]
          }
