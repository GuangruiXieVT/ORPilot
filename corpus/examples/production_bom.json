{
  "problem": {
    "title": "Bill-of-Materials Production Planning",
    "description": "A factory produces a set of finished products. Each finished product is assembled from components according to a Bill of Materials (BOM): producing one unit of product p requires a known quantity of each component c. Each component has a limited available supply. Each product has a known market demand cap (maximum units the market will absorb) and a profit per unit produced. Decide how many units of each product to produce to maximize total profit, subject to not exceeding component supply limits and market demand caps.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total profit from production, summed over all products weighted by units produced",
    "constraints": [
      {
        "description": "Production of each product must not exceed that product's market demand cap"
      },
      {
        "description": "For each component, the total component consumption across all products (according to BOM recipes) must not exceed the available component supply"
      }
    ],
    "decision_variables": [
      "produce[p]: units of product p to produce (continuous, non-negative)"
    ],
    "parameters": [
      "profit[p]: profit per unit of product p produced",
      "max_demand[p]: maximum units of product p that the market will absorb",
      "bom[c,p]: units of component c required to produce one unit of product p",
      "component_supply[c]: total available supply of component c"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "components": "components.csv",
      "bom": "bom.csv"
    }
  },
