        "description": "1 if match m is scheduled in round r, 0 otherwise",
        "label": "match_round_schedule",
        "domain": [
          "Matches",
          "Rounds"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "each_match_once": {
        "domain": [
          "Matches"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Rounds:r"
          ],
          "body": {
            "type": "variable",
            "name": "schedule",
            "indices": [
              "m",
              "r"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "team_one_per_round": {
        "domain": [
          "Teams",
          "Rounds"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Matches:m"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "involves",
              "indices": [
                "t",
                "m"
              ]
            },
            "right": {
              "type": "variable",
              "name": "schedule",
              "indices": [
                "m",
                "r"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Matches:m",
          "Rounds:r"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "appeal",
              "indices": [
                "m"
              ]
            },
            "right": {
              "type": "parameter",
              "name": "round_weight",
              "indices": [
                "r"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "schedule",
            "indices": [
              "m",
              "r"
            ]
          }
        }
      }
    }
