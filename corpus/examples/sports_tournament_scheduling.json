{
  "problem": {
    "title": "Sports Tournament Scheduling",
    "description": "Schedule a round-robin tournament for 6 teams across 15 matches (C(6,2)) and 5 rounds. Each match is scheduled in exactly one round. Each team plays in at most one match per round (3 matches per round). Maximize the total weighted appeal: high-appeal matches scheduled in early rounds score more.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Sum of appeal * round_weight for all scheduled matches",
    "constraints": [
      {
        "description": "Each match is scheduled in exactly one round"
      },
      {
        "description": "Each team plays in at most one match per round"
      }
    ],
    "decision_variables": [
      "schedule[m,r]: 1 if match m is scheduled in round r, 0 otherwise (binary)"
    ],
    "parameters": [
      "appeal[m]: attractiveness of match m",
      "involves[t,m]: 1 if team t participates in match m",
      "round_weight[r]: weight for scheduling in this round (earlier=higher)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "matches": "matches.csv",
      "involves": "involves.csv",
      "round_weights": "round_weights.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "sparse parameter",
    "domain filter free (dense matchup)"
  ],
