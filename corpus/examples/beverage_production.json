{
  "problem": {
    "title": "Beverage Factory 4-Week Production Planning",
    "description": "A beverage factory plans production over 4 weeks to meet demand at minimum cost. Each week has a demand (1000 boxes), production capacity (1000 boxes), and production cost (1000 yuan per 1000 boxes). Storage cost is 0.2 thousand yuan per 1000 boxes per week. Initial inventory is 0. Minimize total production and storage cost.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum over all weeks of (prod_cost[t] * produce[t] + 0.2 * inventory[t])",
    "constraints": [
      {
        "description": "Inventory balance for week 1 (initial inventory = 0): inventory[w1] = produce[w1] - demand[w1]"
      },
      {
        "description": "Inventory balance for weeks 2-4: inventory[t] = inventory[t-1] + produce[t] - demand[t]"
      },
      {
        "description": "Production capacity: produce[t] <= capacity[t] for each week"
      }
    ],
    "decision_variables": [
      "produce[t]: units (1000 boxes) produced in week t (continuous, non-negative)",
      "inventory[t]: units (1000 boxes) held in inventory at end of week t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[t]: units (1000 boxes) required in week t",
      "capacity[t]: maximum production units (1000 boxes) in week t",
      "prod_cost[t]: production cost per 1000 boxes in week t (thousand yuan)"
    ],
    "additional_notes": "Optimal solution: produce=[15,40,25,20], inventory=[0,15,5,0]. Total = 5.0*15+5.1*40+5.4*25+5.5*20 + 0.2*(0+15+5+0) = 524 + 4 = 528.",
    "csv_file_paths": {
      "weeks": "weeks.csv"
    }
  },
  "csv_schemas": {
    "weeks": {
      "columns": {
        "week_id": "str",
        "demand": "float",
        "capacity": "float",
        "prod_cost": "float"
      },
      "sample": {
        "week_id": "w1",
        "demand": 15.0,
        "capacity": 30.0,
        "prod_cost": 5.0
      },
      "optional": false,
      "distinct_values": {
        "week_id": [
          "w1",
          "w2",
          "w3",
          "w4"
        ],
        "demand": [
          "15.0",
          "25.0",
          "35.0",
          "25.0"
        ],
        "capacity": [
          "30.0",
          "40.0",
          "45.0",
          "20.0"
        ],
        "prod_cost": [
          "5.0",
          "5.1",
          "5.4",
          "5.5"
        ]
      }
    }
  },
  "ir": {
