      },
      "warehouse_capacity": {
        "domain": [],
        "type": "float",
        "source": "warehouse.csv",
        "column": "capacity",
        "index_columns": null,
        "missing_default": "zero"
      }
    },
    "variables": {
      "order": {
        "description": "Units of product p ordered at the start of period t",
        "label": "order_quantities",
        "domain": [
          "Products",
          "Periods"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "inventory": {
        "description": "Units of product p in inventory at the end of period t",
        "label": "inventory_levels",
        "domain": [
          "Products",
          "Periods"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "inv_balance_init": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "initial_inventory",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "order",
              "indices": [
                "p",
                "Periods[0]"
              ]
            }
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
                "Periods[0]"
              ]
            },
            "right": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "Periods[0]"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "inv_balance": {
        "domain": [
          "Products",
          "Periods"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "t"
              ],
              "lag": -1
            },
            "right": {
              "type": "variable",
              "name": "order",
              "indices": [
                "p",
                "t"
              ]
            }
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
                "t"
              ]
            },
            "right": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "t"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "warehouse_capacity_limit": {
        "domain": [
          "Periods"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p"
          ],
          "body": {
            "type": "variable",
            "name": "inventory",
            "indices": [
              "p",
              "t"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "warehouse_capacity",
          "indices": []
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Products:p",
            "Periods:t"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "order_cost",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "order",
              "indices": [
                "p",
                "t"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "Products:p",
            "Periods:t"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "holding_cost",
              "indices": [
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "inventory",
              "indices": [
                "p",
                "t"
              ]
            }
          }
        }
      }
    }
