{
  "problem": {
    "title": "Multi-Product Multi-Period Inventory Planning",
    "description": "A warehouse stocks multiple products over a multi-period planning horizon. Each product has a known per-period demand that must be fully met. Each product has a per-unit ordering cost and a per-unit holding cost for inventory carried between periods. Each product has a known initial inventory level at the start of the horizon. The warehouse has a shared total storage capacity: the combined ending inventory of all products in any period cannot exceed this limit. Determine the ordering plan across all products and periods that minimizes total ordering and holding costs while meeting all demands and never violating the shared storage capacity.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of per-unit ordering costs times units ordered plus per-unit holding costs times ending inventory, summed across all products and periods",
    "constraints": [
      {
        "description": "For each product in the first period, ending inventory equals the product's initial inventory plus the order quantity minus demand (inventory balance initialization)"
      },
      {
        "description": "For each product in each subsequent period, ending inventory equals the previous period's ending inventory plus the order quantity minus demand (temporal lag inventory balance)"
      },
      {
        "description": "For each period, the total ending inventory across all products must not exceed the warehouse's shared storage capacity"
      }
    ],
    "decision_variables": [
      "order[p,t]: units of product p ordered at the start of period t (continuous, non-negative)",
      "inventory[p,t]: units of product p in inventory at the end of period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[p,t]: known demand for product p in period t",
      "order_cost[p]: per-unit ordering cost for product p",
      "holding_cost[p]: per-unit holding cost for product p carried between periods",
      "initial_inventory[p]: units of product p on hand at the start of the planning horizon",
      "warehouse_capacity: maximum total units of all products that can be stored simultaneously"
    ],
    "additional_notes": "The inventory balance constraint uses a temporal lag (inventory[p,t-1]) to link adjacent periods per product. The initialization constraint handles the first period separately using initial_inventory[p].",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv",
      "warehouse": "warehouse.csv"
    }
  },
  "csv_schemas": {
