  "ir": {
    "problem_class": "MultiProductInventory",
    "model_type": "Linear Program",
    "sense": "minimize",
    "sets": {
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Periods": {
        "size": null,
        "index_symbol": "t",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "periods",
        "ordered": true
      }
    },
    "parameters": {
      "demand": {
        "domain": [
          "Products",
          "Periods"
        ],
        "type": "float",
        "source": "demand.csv",
        "column": "demand",
        "index_columns": [
          "product_id",
          "period_id"
        ],
        "missing_default": "zero"
      },
      "order_cost": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "order_cost",
        "index_columns": [
          "id"
        ],
        "missing_default": "inf"
      },
      "holding_cost": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "holding_cost",
        "index_columns": [
          "id"
        ],
