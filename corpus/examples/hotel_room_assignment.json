{
  "problem": {
    "title": "Hotel Room Assignment",
    "description": "Assign hotel guests to rooms for a two-night weekend. Each room can host one guest per night. Guests only want certain room types (captured by rate table). Guests only stay on specific nights. Maximize total revenue.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total revenue from guest-room-night assignments",
    "constraints": [
      {
        "description": "Each room hosts at most one guest per night"
      },
      {
        "description": "Each guest occupies at most one room per night (and only on nights they are staying)"
      }
    ],
    "decision_variables": [
      "assign[g,r,n]: 1 if guest g is in room r on night n (binary, only for preferred guest-room pairs)"
    ],
    "parameters": [
      "rate[g,r]: nightly rate guest g pays for room r (sparse)",
      "stay_nights[g,n]: 1 if guest g stays on night n",
      "room_capacity[r]: max guests per room per night (all 1)"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "rates": "rates.csv",
      "stay": "stay.csv",
      "capacity": "capacity.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "domain filter",
    "3D variable",
    "revenue maximization"
  ],
