          "Rooms",
          "Nights"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "rate"
      }
    },
    "constraints": {
