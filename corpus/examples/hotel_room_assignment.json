        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Guests:g"
            ],
            "body": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "g",
                "r",
                "n"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "room_capacity",
            "indices": [
              "r"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "guest_one_room_per_night": {
        "domain": [
          "Guests",
          "Nights"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Rooms:r"
            ],
            "body": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "g",
                "r",
                "n"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "stay_nights",
            "indices": [
              "g",
              "n"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Guests:g",
          "Rooms:r",
          "Nights:n"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "rate",
            "indices": [
              "g",
              "r"
            ]
          },
          "right": {
            "type": "variable",
            "name": "assign",
            "indices": [
