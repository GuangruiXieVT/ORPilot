{
  "problem": {
    "title": "Method Selection MIP: Minimize Weekly Labor Cost with Worker Policy Constraints",
    "description": "A factory must complete 3 tasks (T1, T2, T3), each with two possible methods (A or B). Exactly one method must be chosen per task. Workers are hired at 100 yuan/week (skilled) or 80 yuan/week (laborers). Constraints: total skilled workers <= 400, total laborers <= 800, skilled workers <= 60% of laborers (policy). Additionally, methods T1-B and T3-A cannot both be selected. Minimize total weekly labor cost.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total weekly labor cost = sum over tasks and methods of method_cost[t,m] * method[t,m]",
    "constraints": [
      {
        "description": "One method per task: sum over Methods of method[t,m] = 1 for each task"
      },
      {
        "description": "Max 400 skilled workers: sum(skilled_req[t,m]*method[t,m]) <= 400"
      },
      {
        "description": "Max 800 laborers: sum(laborer_req[t,m]*method[t,m]) <= 800"
      },
      {
        "description": "Skilled <= 60% of laborers: sum(skilled_req*method) - 0.6*sum(laborer_req*method) <= 0"
      },
      {
        "description": "Mutual exclusion: method[T1,B] + method[T3,A] <= 1"
      }
    ],
    "decision_variables": [
      "method[t,m]: binary, 1 if task t is executed using method m, 0 otherwise"
    ],
    "parameters": [
      "method_cost[t,m]: total weekly labor cost if task t uses method m",
      "skilled_req[t,m]: number of skilled workers required if task t uses method m",
      "laborer_req[t,m]: number of laborers required if task t uses method m"
    ],
    "additional_notes": "Expected obj=84000 (T1-A: 20000, T2-B: 24000, T3-A: 40000). Mutual exclusion constraint uses hardcoded indices method['T1','B'] + method['T3','A'] <= 1 with domain=[]. skilled_policy is a scalar constraint (domain=[]) using two nested indexed_sums over Tasks x Methods.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "task_methods": "task_methods.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "tasks",
        "element": "T1"
      },
