              "indices": [
                "t",
                "m"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 800
        }
      },
      "skilled_policy": {
        "domain": [],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Tasks:t",
              "Methods:m"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "skilled_req",
                "indices": [
                  "t",
                  "m"
                ]
              },
              "right": {
                "type": "variable",
