        ]
      }
    }
  },
  "ir": {
    "problem_class": "MethodSelectionMIP",
    "model_type": "Mixed Integer Program",
    "sense": "minimize",
    "sets": {
      "Tasks": {
        "size": null,
        "index_symbol": "t",
        "source": "sets.csv",
        "column": "element",
