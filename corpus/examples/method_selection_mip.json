              "value": 0.6
            },
            "right": {
              "operation": "indexed_sum",
              "over": [
                "Tasks:t",
                "Methods:m"
              ],
              "body": {
                "operation": "multiply",
                "left": {
                  "type": "parameter",
                  "name": "laborer_req",
                  "indices": [
                    "t",
                    "m"
                  ]
                },
                "right": {
                  "type": "variable",
                  "name": "method",
                  "indices": [
