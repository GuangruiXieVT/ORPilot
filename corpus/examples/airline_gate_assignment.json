{
  "problem": {
    "title": "Airline Gate Assignment",
    "description": "Assign arriving flights to airport gates. Two flights with overlapping time windows cannot share a gate. Each flight gets exactly one gate. Maximize total preference score (airlines prefer certain gates).",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total preference score for flight-gate assignments",
    "constraints": [
      {
        "description": "Each flight is assigned exactly one gate"
      },
      {
        "description": "Two flights with overlapping windows cannot share the same gate"
      }
    ],
    "decision_variables": [
      "assign[f,g]: 1 if flight f is assigned to gate g (binary)"
    ],
    "parameters": [
      "preference[f,g]: preference score for assigning flight f to gate g",
      "overlaps[f_i,f_j]: 1 if flight i and j have overlapping time windows"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "preferences": "preferences.csv",
      "conflicts": "conflicts.csv"
    }
  },
  "csv_schemas": {
