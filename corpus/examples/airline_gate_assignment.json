        ]
      }
    }
  },
  "ir": {
    "problem_class": "GateAssignment",
    "model_type": "Mixed Integer Program",
    "sense": "maximize",
    "sets": {
      "Flights": {
        "size": null,
        "index_symbol": "f",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "flights",
        "ordered": false
      },
      "Gates": {
        "size": null,
        "index_symbol": "g",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "gates",
        "ordered": false
      }
    },
    "parameters": {
      "preference": {
        "domain": [
          "Flights",
          "Gates"
        ],
        "type": "float",
        "source": "preferences.csv",
        "column": "preference",
        "index_columns": [
          "flight_id",
          "gate_id"
        ],
        "missing_default": "zero"
      },
      "overlaps": {
        "domain": [
          "Flights",
          "Flights"
        ],
        "type": "float",
        "source": "conflicts.csv",
        "column": "overlaps",
        "index_columns": [
          "flight_i",
          "flight_j"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "assign": {
        "description": "1 if flight f is assigned to gate g",
        "label": "flight_gate_assignments",
        "domain": [
          "Flights",
          "Gates"
        ],
        "type": "binary",
        "lower_bound": 0,
        "upper_bound": 1,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "each_flight_assigned": {
        "domain": [
          "Flights"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Gates:g"
          ],
          "body": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "f",
              "g"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 1
        }
      },
      "no_overlap": {
        "domain": [
          "Flights:f1",
          "Flights:f2",
          "Gates"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "f1",
                "g"
              ]
            },
            "right": {
              "type": "variable",
              "name": "assign",
              "indices": [
                "f2",
                "g"
              ]
            }
          },
          "right": {
            "type": "constant",
            "value": 1
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        },
        "sparse_filter": "overlaps"
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Flights:f",
          "Gates:g"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "type": "parameter",
            "name": "preference",
            "indices": [
              "f",
              "g"
            ]
          },
          "right": {
            "type": "variable",
            "name": "assign",
            "indices": [
              "f",
              "g"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "binary variable",
    "duplicate set",
    "sparse filter"
  ]
