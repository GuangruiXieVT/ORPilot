{
  "problem": {
    "title": "Make-or-Buy Sourcing Decision",
    "description": "A manufacturer must decide, for each product, whether to produce it in-house or purchase it from an external supplier. Producing a product in-house incurs a fixed setup cost plus a variable cost per unit; outsourcing incurs only a per-unit purchase price. All demand must be met. In-house production consumes shared labor capacity, so the total production volume across all products cannot exceed the available labor hours. Determine which products to make in-house and how much of each to produce or buy to minimize total cost.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = sum of (fixed setup cost × make decision + variable production cost × produced units + purchase cost × bought units) over all products",
    "constraints": [
      {
        "description": "Demand met: produced plus purchased quantity must equal demand for each product"
      },
      {
        "description": "Make-link: production quantity is zero unless the product is made in-house (big-M linking constraint using prod_cap as upper bound)"
      },
      {
        "description": "Labor capacity: total production across all products must not exceed available labor capacity"
      }
    ],
    "decision_variables": [
      "produce[p]: units of product p produced in-house (continuous, non-negative)",
      "buy[p]: units of product p purchased externally (continuous, non-negative)",
      "make[p]: 1 if product p is produced in-house, else 0 (binary)"
    ],
    "parameters": [
      "demand[p]: total demand for product p",
      "prod_cost[p]: variable in-house production cost per unit of product p",
      "fixed_cost[p]: fixed setup cost for producing product p in-house",
      "buy_cost[p]: cost per unit of product p purchased externally",
      "prod_cap[p]: maximum in-house production quantity for product p (also serves as big-M for make-link)",
      "labor_cap: total labor capacity available for in-house production (shared across all products)"
    ],
    "additional_notes": "The make-link constraint (produce[p] ≤ prod_cap[p] × make[p]) ensures in-house production can only occur when make[p] = 1. The fixed_cost is only incurred when make[p] = 1. The optimizer balances fixed setup costs against per-unit savings from in-house production, subject to the shared labor capacity constraint.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "capacity": "capacity.csv"
    }
  },
  "ir_patterns": [
    "binary variable",
    "scalar parameter",
    "big-M linking"
  ],
