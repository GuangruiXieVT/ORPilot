{
  "problem": {
    "title": "24-Hour Restaurant Shift Scheduling",
    "description": "A restaurant operates around the clock. In each 4-hour block of the day the minimum number of waiters required is given. Waiters start shifts at 2am, 6am, 10am, 2pm, 6pm, or 10pm and work continuously for 8 hours (two consecutive 4-hour blocks). Find the minimum total number of waiters that satisfies all staffing requirements.",
    "problem_type": "integer_programming",
    "objective": "minimize",
    "objective_description": "Total number of waiters hired across all shift start times",
    "constraints": [
      {
        "description": "For each 4-hour period, the total workers whose shift covers that period must be at least the required demand"
      }
    ],
    "decision_variables": [
      "workers[s]: number of workers starting shift s (non-negative integer)"
    ],
    "parameters": [
      "demand[p]: minimum waiters needed in period p",
      "coverage[p,s]: 1 if shift s covers period p, 0 otherwise (sparse, only 1s stored)"
    ],
    "additional_notes": "6 shifts (s1=2am, s2=6am, s3=10am, s4=2pm, s5=6pm, s6=10pm) and 6 periods (p1=2-6, p2=6-10, p3=10-14, p4=14-18, p5=18-22, p6=22-2). Each shift covers exactly two consecutive periods. Coverage is stored as a sparse binary parameter with missing_default zero. The constraint multiplies coverage[p,s] by workers[s] and sums over shifts. Optimal: workers=[4,4,6,1,11,0], total=26.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand": "demand.csv",
      "coverage": "coverage.csv"
    }
  },
