                  "p"
                ]
              },
              "right": {
                "type": "variable",
                "name": "produce",
                "indices": [
                  "p"
                ]
              }
            }
          }
        },
        "right": {
          "operation": "sum",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "MachinesA:mA",
              "Products:p"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "operation": "multiply",
                "left": {
                  "type": "parameter",
                  "name": "cost_per_hour_A",
                  "indices": [
                    "mA"
                  ]
                },
                "right": {
                  "type": "parameter",
                  "name": "processing_time_A",
                  "indices": [
                    "mA",
                    "p"
                  ]
                }
              },
              "right": {
                "type": "variable",
