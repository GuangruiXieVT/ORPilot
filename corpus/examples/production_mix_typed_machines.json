          "type": "constant",
          "value": 0
        }
      },
      "A_machine_capacity": {
        "domain": [
          "MachinesA"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "processing_time_A",
              "indices": [
                "mA",
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "process_A",
              "indices": [
                "mA",
                "p"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "effective_hours_A",
          "indices": [
            "mA"
          ]
        }
      },
      "B_machine_capacity": {
        "domain": [
          "MachinesB"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "processing_time_B",
              "indices": [
                "mB",
                "p"
              ]
            },
            "right": {
              "type": "variable",
              "name": "process_B",
              "indices": [
                "mB",
                "p"
              ]
            }
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "parameter",
          "name": "effective_hours_B",
          "indices": [
            "mB"
          ]
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "subtract",
        "left": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Products:p"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
