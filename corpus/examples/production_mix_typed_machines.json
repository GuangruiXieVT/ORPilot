  "ir": {
    "problem_class": "ProductionPlanning",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "MachinesA": {
        "size": null,
        "index_symbol": "mA",
        "source": "machines.csv",
        "column": "machine_id",
        "filter_column": "machine_type",
        "filter_value": "A",
        "ordered": false
      },
      "MachinesB": {
        "size": null,
        "index_symbol": "mB",
        "source": "machines.csv",
        "column": "machine_id",
        "filter_column": "machine_type",
        "filter_value": "B",
        "ordered": false
      },
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "products.csv",
        "column": "product_id",
        "ordered": false
      }
    },
    "parameters": {
      "unit_price": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "unit_price",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "inf"
      },
      "raw_material_cost": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "products.csv",
        "column": "raw_material_cost",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "inf"
      },
      "effective_hours_A": {
        "domain": [
          "MachinesA"
        ],
        "type": "float",
        "source": "machines.csv",
        "column": "effective_hours",
        "index_columns": [
          "machine_id"
        ],
        "missing_default": "zero"
      },
      "effective_hours_B": {
        "domain": [
          "MachinesB"
        ],
        "type": "float",
        "source": "machines.csv",
        "column": "effective_hours",
        "index_columns": [
          "machine_id"
        ],
        "missing_default": "zero"
      },
      "cost_per_hour_A": {
        "domain": [
          "MachinesA"
        ],
        "type": "float",
        "source": "machines.csv",
        "column": "cost_per_hour",
        "index_columns": [
          "machine_id"
        ],
        "missing_default": "inf"
      },
      "cost_per_hour_B": {
        "domain": [
          "MachinesB"
        ],
        "type": "float",
        "source": "machines.csv",
        "column": "cost_per_hour",
        "index_columns": [
          "machine_id"
        ],
        "missing_default": "inf"
      },
      "processing_time_A": {
        "domain": [
          "MachinesA",
          "Products"
        ],
        "type": "float",
        "source": "processing_times.csv",
        "column": "processing_time",
        "index_columns": [
          "from_id",
          "to_id"
        ],
        "missing_default": "inf"
      },
      "processing_time_B": {
        "domain": [
          "MachinesB",
          "Products"
        ],
        "type": "float",
        "source": "processing_times.csv",
        "column": "processing_time",
        "index_columns": [
          "from_id",
          "to_id"
        ],
        "missing_default": "inf"
      }
    },
    "variables": {
      "process_A": {
        "description": "Units of product p processed on A-machine mA",
        "label": "a_machine_assignments",
        "domain": [
          "MachinesA",
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "processing_time_A"
      },
      "process_B": {
        "description": "Units of product p processed on B-machine mB",
        "label": "b_machine_assignments",
        "domain": [
          "MachinesB",
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "processing_time_B"
      },
      "produce": {
        "description": "Total units of product p produced",
        "label": "production_quantities",
        "domain": [
          "Products"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "A_stage_balance": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "MachinesA:mA"
            ],
            "body": {
              "type": "variable",
              "name": "process_A",
              "indices": [
                "mA",
                "p"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "B_stage_balance": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "MachinesB:mB"
            ],
            "body": {
              "type": "variable",
              "name": "process_B",
              "indices": [
                "mB",
                "p"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p"
            ]
          }
        },
        "sense": "=",
