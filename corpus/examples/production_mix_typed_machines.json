{
  "problem": {
    "title": "Multi-Stage Production Mix with Typed Machine Sets",
    "description": "A factory produces three products (I, II, III). Each product must pass through two sequential processing stages: stage A and stage B. Two A-type machines (A1, A2) and three B-type machines (B1, B2, B3) are available. Processing times differ by machine-product pair; not all machine-product combinations are feasible (sparse). Each unit of a product must be processed on exactly one A-machine and exactly one B-machine. Maximize total profit = revenue - raw material cost - machine operating cost.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total profit: revenue from all products minus raw material costs and machine operating costs (cost_per_hour * processing_time * units processed)",
    "constraints": [
      {
        "description": "A-stage balance: total units processed on all A-machines for product p equals total units produced of p"
      },
      {
        "description": "B-stage balance: total units processed on all B-machines for product p equals total units produced of p"
      },
      {
        "description": "A-machine capacity: total processing time on each A-machine does not exceed effective available hours"
      },
      {
        "description": "B-machine capacity: total processing time on each B-machine does not exceed effective available hours"
      }
    ],
    "decision_variables": [
      "process_A[mA, p]: units of product p processed on A-machine mA (continuous, non-negative; only feasible machine-product pairs)",
      "process_B[mB, p]: units of product p processed on B-machine mB (continuous, non-negative; only feasible machine-product pairs)",
      "produce[p]: total units of product p produced (continuous, non-negative)"
    ],
    "parameters": [
      "unit_price[p]: selling price per unit of product p",
      "raw_material_cost[p]: raw material cost per unit of product p",
      "effective_hours_A[mA]: available processing hours on A-machine mA",
      "effective_hours_B[mB]: available processing hours on B-machine mB",
      "cost_per_hour_A[mA]: processing cost per hour on A-machine mA",
      "cost_per_hour_B[mB]: processing cost per hour on B-machine mB",
      "processing_time_A[mA, p]: hours to process one unit of p on A-machine mA (sparse: not all pairs defined)",
      "processing_time_B[mB, p]: hours to process one unit of p on B-machine mB (sparse: not all pairs defined)"
    ],
    "additional_notes": "Key pattern: machines.csv contains all machines with a machine_type column (A or B). Use filter_column='machine_type', filter_value='A' to create MachinesA set and filter_value='B' for MachinesB set. Both set and parameter data come from shared CSV files. Processing times are sparse (missing pairs are infeasible). Use domain_filter on process_A and process_B variables to restrict to feasible pairs only.",
    "csv_file_paths": {
      "products": "products.csv",
      "machines": "machines.csv",
      "processing_times": "processing_times.csv"
    }
  },
  "csv_schemas": {
