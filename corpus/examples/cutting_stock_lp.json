{
  "problem": {
    "title": "Cutting Stock LP: Minimize Paper Waste from Multiple Roll Widths",
    "description": "A paper mill has three orders: 1000m of 0.5m-wide strips, 3000m of 0.7m strips, 2000m of 0.9m strips. Standard roll widths: 1m and 2m (unlimited length). 10 cutting patterns are pre-enumerated (P1-P3 from 1m rolls, Q1-Q7 from 2m rolls). Variable x[p] = total length (meters) of rolls cut using pattern p. Minimize total waste area.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total waste area (m²) = sum(waste_rate[p] * x[p]) over all patterns",
    "constraints": [
      {
        "description": "Order fulfillment: sum(strips_per_unit[p,s]*x[p] over Patterns) >= demand[s] for each order type s"
      }
    ],
    "decision_variables": [
      "x[p]: total length (meters) of rolls cut using pattern p (continuous, >=0)"
    ],
    "parameters": [
      "waste_rate[p]: waste width per unit length for pattern p (= roll_width - sum of strip widths cut)",
      "strips_per_unit[p,s]: number of strips of type s yielded per unit length of pattern p",
      "demand_m[s]: required total length of strip type s in meters"
    ],
    "additional_notes": "Patterns: P1=(2,0,0) from 1m, P2=(0,1,0), P3=(0,0,1), Q1=(4,0,0) from 2m, Q2=(0,2,0), Q3=(0,0,2), Q4=(2,1,0), Q5=(0,1,1), Q6=(2,0,1), Q7=(1,2,0). Optimal: x_P2=1000, x_P3=2000, x_Q7=1000. Waste=300+200+100=600m²."
  },
