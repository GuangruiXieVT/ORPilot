          "Dec"
        ],
        "demand": [
          "30000.0",
          "15000.0",
          "100000.0",
          "50000.0"
        ]
      }
    },
    "prod_cost": {
      "columns": {
        "product_id": "str",
        "month_id": "str",
        "prod_cost": "float"
      },
      "sample": {
