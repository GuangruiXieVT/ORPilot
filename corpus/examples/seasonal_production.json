{
  "problem": {
    "title": "Seasonal Production Planning with Own and Rented Warehouse Storage",
    "description": "A manufacturer plans production of two products (I and II) over 6 months (July through December) to minimize total production and storage cost. Monthly demand is low in Jul-Sep and high in Oct-Dec. Combined production capacity is 120,000 units/month. Product I requires 0.2 m3/unit volume and costs 4.5 yuan/unit to produce. Product II requires 0.4 m3/unit and costs 7 yuan/unit. Storage: the company owns a warehouse of 15,000 m3 (cost 1 yuan/m3/month); extra space can be rented at 1.5 yuan/m3/month. Initial inventory is zero.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = prod_cost[p,m]*produce[p,m] + 1*own_vol[m] + 1.5*ext_vol[m], summed over all products and months",
    "constraints": [
      {
        "description": "Inventory balance init (July): inv[p,Jul] = produce[p,Jul] - demand[p,Jul], with zero initial inventory"
      },
      {
        "description": "Inventory balance (Aug-Dec): inv[p,m] = inv[p,m-1] + produce[p,m] - demand[p,m]"
      },
      {
        "description": "Monthly production capacity: sum over products of produce[p,m] <= 120000"
      },
      {
        "description": "Warehouse volume: total volume stored = own_vol[m] + ext_vol[m]"
      },
      {
        "description": "Own warehouse capacity: own_vol[m] <= 15000"
      }
    ],
    "decision_variables": [
      "produce[p,m]: units of product p produced in month m (continuous, non-negative)",
      "inv[p,m]: units of product p in inventory at end of month m (continuous, non-negative)",
      "own_vol[m]: m3 stored in own warehouse at end of month m (continuous, non-negative)",
      "ext_vol[m]: m3 stored in rented extra warehouse at end of month m (continuous, non-negative)"
    ],
    "parameters": [
      "demand[p,m]: units of product p demanded in month m",
      "prod_cost[p,m]: production cost per unit of product p in month m",
      "vol[p]: volume per unit of product p (m3/unit)"
    ],
    "additional_notes": "Optimal obj=3160500. balance_init domain=[Products], uses Months[0] for July. balance domain=[Products,Months] with lag:-1 on inv. warehouse constraint domain=[Months]: indexed_sum(vol[p]*inv[p,m] over Products) - own_vol[m] - ext_vol[m] = 0. own_warehouse_cap domain=[Months]: own_vol[m] <= 15000. capacity domain=[Months]: indexed_sum(produce[p,m] over Products) <= 120000.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "demand": "demand.csv",
      "prod_cost": "prod_cost.csv",
      "vol": "vol.csv"
    }
  },
  "csv_schemas": {
    "sets": {
