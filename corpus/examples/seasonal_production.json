        ]
      }
    }
  },
  "ir": {
    "problem_class": "SeasonalProductionWarehouseLP",
    "model_type": "Linear Program",
    "sense": "minimize",
    "sets": {
      "Products": {
        "size": null,
        "index_symbol": "p",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "products",
        "ordered": false
      },
      "Months": {
        "size": null,
        "index_symbol": "m",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "months",
        "ordered": true
      }
    },
    "parameters": {
      "demand": {
        "domain": [
          "Products",
          "Months"
        ],
        "type": "float",
        "source": "demand.csv",
        "column": "demand",
        "index_columns": [
          "product_id",
          "month_id"
        ],
        "missing_default": "zero"
      },
      "prod_cost": {
        "domain": [
          "Products",
          "Months"
        ],
        "type": "float",
        "source": "prod_cost.csv",
        "column": "prod_cost",
        "index_columns": [
          "product_id",
          "month_id"
        ],
        "missing_default": "inf"
      },
      "vol": {
        "domain": [
          "Products"
        ],
        "type": "float",
        "source": "vol.csv",
        "column": "vol",
        "index_columns": [
          "product_id"
        ],
        "missing_default": "zero"
      }
    },
    "variables": {
      "produce": {
        "description": "Units of product p produced in month m",
        "label": "produce",
        "domain": [
          "Products",
          "Months"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "inv": {
        "description": "Units of product p in inventory at end of month m",
        "label": "inv",
        "domain": [
          "Products",
          "Months"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "own_vol": {
        "description": "Volume (m3) stored in own warehouse at end of month m",
        "label": "own_vol",
        "domain": [
          "Months"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      },
      "ext_vol": {
        "description": "Volume (m3) stored in rented extra warehouse at end of month m",
        "label": "ext_vol",
        "domain": [
          "Months"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false
      }
    },
    "constraints": {
      "inv_balance_init": {
        "domain": [
          "Products"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "inv",
              "indices": [
                "p",
                "Months[0]"
              ]
            },
            "right": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
                "Months[0]"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p",
              "Months[0]"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "inv_balance": {
        "domain": [
          "Products",
          "Months"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "sum",
            "left": {
              "operation": "subtract",
              "left": {
                "type": "variable",
                "name": "inv",
                "indices": [
                  "p",
                  "m"
                ]
              },
              "right": {
                "type": "variable",
                "name": "inv",
                "indices": [
                  "p",
                  "m"
                ],
                "lag": -1
              }
            },
            "right": {
              "type": "parameter",
              "name": "demand",
              "indices": [
                "p",
                "m"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p",
              "m"
            ]
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "capacity": {
        "domain": [
          "Months"
        ],
        "expression": {
          "operation": "indexed_sum",
          "over": [
            "Products:p"
          ],
          "body": {
            "type": "variable",
            "name": "produce",
            "indices": [
              "p",
              "m"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 120000
        }
      },
      "warehouse_vol": {
        "domain": [
          "Months"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Products:p"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "vol",
                "indices": [
                  "p"
                ]
              },
              "right": {
                "type": "variable",
                "name": "inv",
                "indices": [
                  "p",
                  "m"
                ]
              }
            }
          },
          "right": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "own_vol",
              "indices": [
                "m"
              ]
            },
            "right": {
              "type": "variable",
              "name": "ext_vol",
              "indices": [
                "m"
              ]
            }
          }
        },
        "sense": "=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "own_cap": {
        "domain": [
          "Months"
        ],
        "expression": {
          "type": "variable",
          "name": "own_vol",
          "indices": [
            "m"
          ]
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 15000
        }
      }
    },
    "objective": {
      "sense": "minimize",
      "expression": {
        "operation": "sum",
        "left": {
          "operation": "indexed_sum",
          "over": [
            "Products:p",
            "Months:m"
          ],
          "body": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "prod_cost",
              "indices": [
                "p",
                "m"
              ]
            },
            "right": {
              "type": "variable",
              "name": "produce",
              "indices": [
                "p",
                "m"
              ]
            }
          }
        },
        "right": {
          "operation": "indexed_sum",
          "over": [
            "Months:m"
          ],
          "body": {
            "operation": "sum",
            "left": {
              "type": "variable",
              "name": "own_vol",
              "indices": [
                "m"
              ]
            },
            "right": {
              "operation": "multiply",
              "left": {
                "type": "constant",
                "value": 1.5
              },
              "right": {
                "type": "variable",
                "name": "ext_vol",
                "indices": [
                  "m"
                ]
              }
            }
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "balance constraint",
    "init constraint",
    "step cost",
    "temporal lag"
  ]
}