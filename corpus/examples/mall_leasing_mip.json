{
  "problem": {
    "title": "Mall Leasing MIP: Maximize Rental Income with Piecewise Profit per Store Count",
    "description": "Shopping mall has 5000m² to lease across 5 store types: Jewelry (min 1, max 3 shops, 250m²/shop), Shoes&Hats (min 1, max 2, 350m²), General Merchandise (min 1, max 3, 800m²), Bookstore (min 0, max 2, 400m²), Catering (min 1, max 3, 500m²). Profit per store varies with total count of that type (tiered). Rent = 20% of profit. Each valid (type, count) combination is an 'option'. Exactly one option must be chosen per store type. Maximize total rental income.",
    "problem_type": "mixed_integer_programming",
    "objective": "maximize",
    "objective_description": "Total rental = sum(annual_rental[o] * y[o]) for all options",
    "constraints": [
      {
        "description": "For each store type, exactly one count-level option is chosen: sum(type_match[o,s]*y[o] over Options) = 1 for each StoreType s"
      },
      {
        "description": "Total area: sum(area_used[o]*y[o]) <= 5000"
      }
    ],
    "decision_variables": [
      "y[o]: binary, 1 if option o (a specific type+count combination) is chosen"
    ],
    "parameters": [
      "annual_rental[o]: rental income for option o = 0.2 * per_store_profit * count",
      "area_used[o]: total floor area consumed by option o = area_per_shop * count",
      "type_match[o,s]: 1 if option o belongs to store type s, else 0"
    ],
    "additional_notes": "Options: J1/J2/J3=1,2,3 jewelry; SH1/SH2=1,2 shoes; GM1/GM2/GM3=1,2,3 general; BK0/BK1/BK2=0,1,2 bookstore; CT1/CT2/CT3=1,2,3 catering. Profits per store: J=9,8,7; SH=10,9; GM=27,21,20; BK=16,10; CT=17,15,12. Rental=20%*total_profit. Optimal: J2+SH2+GM3+BK1+CT2 → 16+18+60+16+30=140 total profit → 0.2*140=28."
  },
