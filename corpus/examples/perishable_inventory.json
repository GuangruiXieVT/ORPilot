{
  "problem": {
    "title": "Perishable Inventory Planning with Expiry Waste",
    "description": "A retailer manages several perishable products (e.g., fresh food) over a daily planning horizon. Purchased goods can be held for at most one period before they expire; any unsold inventory from the previous period must be wasted. Demand must be satisfied each day. The retailer incurs a purchase cost per unit bought, a holding cost per unit carried overnight (end-of-period inventory), and a waste penalty per unit discarded. Determine daily purchase quantities to minimize total cost while ensuring demand is met and no inventory is held past its shelf life.",
    "problem_type": "linear_programming",
    "objective": "minimize",
    "objective_description": "Total cost = purchase cost + holding cost for overnight inventory + waste penalty for expired units, summed over all products and periods",
    "constraints": [
      {
        "description": "Balance initialization: first-period inventory plus waste plus demand equals initial inventory plus purchases"
      },
      {
        "description": "Balance: current inventory plus waste plus demand equals previous inventory plus purchases (temporal lag)"
      },
      {
        "description": "Expiry (shelf-life = 1 period): end-of-period inventory cannot exceed units purchased in that period — forcing old stock to be wasted"
      },
      {
        "description": "Storage capacity: end-of-period inventory for each product must not exceed the storage limit"
      }
    ],
    "decision_variables": [
      "purchase[p,t]: units of product p purchased in period t (continuous, non-negative)",
      "inventory[p,t]: units of product p in storage at end of period t (continuous, non-negative)",
      "waste[p,t]: units of product p expired/wasted in period t (continuous, non-negative)"
    ],
    "parameters": [
      "demand[p,t]: demand for product p in period t",
      "purchase_cost[p]: cost per unit purchased for product p",
      "holding_cost[p]: cost per unit held overnight for product p",
      "waste_penalty[p]: penalty per unit wasted/expired for product p",
      "initial_inventory[p]: units of product p on hand at the start of the planning horizon (age 1, will expire in period 1 if not used)",
      "storage_cap[p]: maximum units of product p that can be stored overnight"
    ],
    "additional_notes": "The expiry constraint (inventory[p,t] <= purchase[p,t]) encodes 1-period shelf life: end-of-period stock can only consist of goods purchased that same day. Any old stock not consumed in the current period is captured by the waste variable in the material balance equation. Initial inventory is treated as old stock that can satisfy demand in period 1 but expires at the end of period 1.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "products": "products.csv",
      "demand": "demand.csv"
    }
  },
  "csv_schemas": {
