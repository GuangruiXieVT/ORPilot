        ],
        "water_avail": [
          "600.0",
          "700.0",
          "800.0"
        ]
      }
    },
    "params": {
      "columns": {
        "total_land": "float"
      },
      "sample": {
        "total_land": 500.0
      },
      "optional": false,
      "distinct_values": {
        "total_land": [
          "500.0"
        ]
      }
    }
  },
  "ir": {
    "problem_class": "CropPlanning",
    "model_type": "Linear Program",
    "sense": "maximize",
    "sets": {
      "Crops": {
        "size": null,
        "index_symbol": "c",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "crops",
        "ordered": false
      },
      "Seasons": {
        "size": null,
        "index_symbol": "s",
        "source": "sets.csv",
        "column": "element",
        "filter_column": "set_name",
        "filter_value": "seasons",
        "ordered": false
      }
    },
    "parameters": {
      "yield_per_acre": {
        "domain": [
          "Crops",
          "Seasons"
        ],
        "type": "float",
        "source": "yields.csv",
        "column": "yield_per_acre",
        "index_columns": [
          "crop",
          "season"
        ],
        "missing_default": "zero"
      },
      "water_req": {
        "domain": [
          "Crops",
          "Seasons"
        ],
        "type": "float",
        "source": "water_reqs.csv",
        "column": "water_req",
        "index_columns": [
          "crop",
          "season"
        ],
        "missing_default": "zero"
      },
      "sell_price": {
        "domain": [
          "Crops"
        ],
        "type": "float",
        "source": "sell_price.csv",
        "column": "sell_price",
        "index_columns": [
          "crop"
        ],
        "missing_default": "zero"
      },
      "water_avail": {
        "domain": [
          "Seasons"
        ],
        "type": "float",
        "source": "water.csv",
        "column": "water_avail",
        "index_columns": [
          "season"
        ],
        "missing_default": "zero"
      },
      "total_land": {
        "domain": [],
        "type": "float",
        "source": "params.csv",
        "column": "total_land",
        "index_columns": null,
        "missing_default": "zero"
      }
    },
    "variables": {
      "plant": {
        "description": "Acres planted for crop c in season s",
        "label": "planting_acres",
        "domain": [
          "Crops",
          "Seasons"
        ],
        "type": "continuous",
        "lower_bound": 0,
        "upper_bound": null,
        "upper_bound_set": null,
        "exclude_diagonal": false,
        "domain_filter": "yield_per_acre"
      }
    },
    "constraints": {
      "land_limit": {
        "domain": [
          "Seasons"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Crops:c"
            ],
            "body": {
              "type": "variable",
              "name": "plant",
              "indices": [
                "c",
                "s"
              ]
            }
          },
          "right": {
            "type": "parameter",
            "name": "total_land",
            "indices": []
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      },
      "water_limit": {
        "domain": [
          "Seasons"
        ],
        "expression": {
          "operation": "subtract",
          "left": {
            "operation": "indexed_sum",
            "over": [
              "Crops:c"
            ],
            "body": {
              "operation": "multiply",
              "left": {
                "type": "parameter",
                "name": "water_req",
                "indices": [
                  "c",
                  "s"
                ]
              },
              "right": {
                "type": "variable",
                "name": "plant",
                "indices": [
                  "c",
                  "s"
                ]
              }
            }
          },
          "right": {
            "type": "parameter",
            "name": "water_avail",
            "indices": [
              "s"
            ]
          }
        },
        "sense": "<=",
        "rhs": {
          "type": "constant",
          "value": 0
        }
      }
    },
    "objective": {
      "sense": "maximize",
      "expression": {
        "operation": "indexed_sum",
        "over": [
          "Crops:c",
          "Seasons:s"
        ],
        "body": {
          "operation": "multiply",
          "left": {
            "operation": "multiply",
            "left": {
              "type": "parameter",
              "name": "yield_per_acre",
              "indices": [
                "c",
                "s"
              ]
            },
            "right": {
              "type": "parameter",
              "name": "sell_price",
              "indices": [
                "c"
              ]
            }
          },
          "right": {
            "type": "variable",
            "name": "plant",
            "indices": [
              "c",
              "s"
            ]
          }
        }
      }
    }
  },
  "modeling_patterns": [
    "domain filter",
    "sparse filter"
  ]
}