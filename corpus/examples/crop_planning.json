{
  "problem": {
    "title": "Farm Crop Planning",
    "description": "A farm allocates land to different crops across 3 growing seasons (spring, summer, fall). Each crop-season combination has a known yield and water requirement (sparse - not all crops can be planted each season). Water is limited each season. Total land used each season cannot exceed the farm's capacity. Maximize total revenue.",
    "problem_type": "linear_programming",
    "objective": "maximize",
    "objective_description": "Total revenue = sum over crops and seasons of yield_per_acre * sell_price * plant",
    "constraints": [
      {
        "description": "Land limit: total acres planted each season cannot exceed total_land"
      },
      {
        "description": "Water limit: total water usage each season cannot exceed water availability"
      }
    ],
    "decision_variables": [
      "plant[Crops, Seasons]: acres planted for each crop in each season (continuous, non-negative, sparse)"
    ],
    "parameters": [
      "yield_per_acre[Crops, Seasons]: yield per acre (sparse - not all crop-season pairs valid)",
      "water_req[Crops, Seasons]: water units per acre (sparse)",
      "sell_price[Crops]: revenue per unit yield",
      "water_avail[Seasons]: total water available per season",
      "total_land: total farmland available per season"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "yields": "yields.csv",
      "water_reqs": "water_reqs.csv",
      "sell_price": "sell_price.csv",
      "water": "water.csv",
      "params": "params.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
        "set_name": "crops",
        "element": "wheat"
      },
      "optional": false,
      "distinct_values": {
        "set_name": [
          "crops",
          "seasons"
        ],
        "element": [
          "wheat",
          "corn",
          "soy",
          "cotton",
          "sp",
          "su",
          "fa"
        ]
      }
    },
    "yields": {
      "columns": {
        "crop": "str",
        "season": "str",
        "yield_per_acre": "float"
      },
      "sample": {
        "crop": "wheat",
        "season": "sp",
        "yield_per_acre": 3.5
      },
      "optional": false,
      "distinct_values": {
        "crop": [
          "wheat",
          "corn",
          "soy",
          "cotton"
        ],
        "season": [
          "sp",
          "su",
          "fa"
        ]
      }
    },
    "water_reqs": {
      "columns": {
        "crop": "str",
        "season": "str",
        "water_req": "float"
      },
      "sample": {
        "crop": "wheat",
        "season": "sp",
        "water_req": 2.0
      },
      "optional": false,
      "distinct_values": {
        "crop": [
          "wheat",
          "corn",
          "soy",
          "cotton"
        ],
        "season": [
          "sp",
          "su",
          "fa"
        ]
      }
    },
    "sell_price": {
      "columns": {
        "crop": "str",
        "sell_price": "float"
      },
      "sample": {
        "crop": "wheat",
        "sell_price": 150.0
      },
      "optional": false,
      "distinct_values": {
        "crop": [
          "wheat",
          "corn",
          "soy",
          "cotton"
        ],
        "sell_price": [
          "120.0",
          "150.0",
          "180.0",
          "200.0"
        ]
      }
    },
