{
  "problem": {
    "title": "Hiker's Backpack Knapsack",
    "description": "A hiker is planning a multi-day wilderness trip and must pack a backpack. There is a list of candidate items to bring, each with a known weight and a utility value that reflects how useful it would be on the trip. The backpack has a fixed weight limit — carrying too much is not possible. Each item is either packed or left behind; no partial items are allowed. Determine which items to include in the backpack to maximize total utility without exceeding the weight capacity.",
    "problem_type": "integer_programming",
    "objective": "maximize",
    "objective_description": "Total utility value of all items selected for the backpack",
    "constraints": [
      {
        "description": "The total weight of all selected items must not exceed the backpack's weight capacity"
      }
    ],
    "decision_variables": [
      "select[i]: 1 if item i is packed in the backpack, 0 otherwise (binary)"
    ],
    "parameters": [
      "value[i]: utility value of item i if included",
      "weight[i]: weight of item i",
      "capacity: maximum total weight the backpack can carry"
    ],
    "additional_notes": "",
    "csv_file_paths": {
      "sets": "sets.csv",
      "items": "items.csv",
      "capacity": "capacity.csv"
    }
  },
