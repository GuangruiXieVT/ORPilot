{
  "problem": {
    "title": "Data Center Workload Assignment",
    "description": "Assign computing workloads to servers to minimize energy cost. Each workload runs on exactly one server. Servers are activated only if needed (binary). Activated servers incur a fixed power cost. Running a workload on a server incurs a compute cost. CPU and memory capacity limits must be respected.",
    "problem_type": "mixed_integer",
    "objective": "minimize",
    "objective_description": "Total cost = sum of server activation costs + sum of workload compute costs",
    "constraints": [
      {
        "description": "Each workload is assigned to exactly one server"
      },
      {
        "description": "CPU capacity: total CPU requirements of workloads on a server cannot exceed CPU capacity * active"
      },
      {
        "description": "Memory capacity: total memory requirements of workloads on a server cannot exceed memory capacity * active"
      },
      {
        "description": "Activation link: if a workload runs on a server, the server must be active"
      }
    ],
    "decision_variables": [
      "run[Workloads, Servers]: 1 if workload w runs on server sv (binary)",
      "active[Servers]: 1 if server sv is powered on (binary)"
    ],
    "parameters": [
      "cpu_req[Workloads]: CPU cores needed by each workload",
      "mem_req[Workloads]: GB memory needed by each workload",
      "cpu_cap[Servers]: CPU cores available per server",
      "mem_cap[Servers]: GB memory available per server",
      "server_cost[Servers]: fixed power cost when server is active",
      "run_cost[Workloads, Servers]: compute cost to run workload w on server sv"
    ],
    "csv_file_paths": {
      "sets": "sets.csv",
      "workloads": "workloads.csv",
      "servers": "servers.csv",
      "run_cost": "run_cost.csv"
    }
  },
  "csv_schemas": {
    "sets": {
      "columns": {
        "set_name": "str",
        "element": "str"
      },
      "sample": {
