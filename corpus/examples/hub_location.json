{
  "problem": {
    "title": "Hub-and-Spoke Network Location",
    "description": "A logistics company routes shipments from origins to destinations through a hub-and-spoke network. It must decide which of 3 candidate hubs to open (fixed cost). Shipments from each origin are consolidated at one hub, then possibly transferred to another hub before being delivered to destinations. Each hub has a throughput capacity. Minimize total fixed plus transportation costs.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total cost = hub opening costs + collection costs (origin to hub) + transfer costs (hub to hub) + delivery costs (hub to destination)",
    "constraints": [
      {
        "description": "supply_dispatch: all supply from each origin must be sent to hubs"
      },
      {
        "description": "demand_fulfillment: all demand at each destination must be received from hubs"
      },
      {
        "description": "hub_flow_balance: at each hub, inflow (from origins + other hubs) equals outflow (to destinations + other hubs)"
      },
      {
        "description": "collect_big_m: collection from origin to hub is zero if hub is not open"
      },
      {
        "description": "deliver_big_m: delivery from hub to destination is zero if hub is not open"
      },
      {
        "description": "hub_capacity_limit: total flow through a hub (inbound) cannot exceed its capacity times its open indicator"
      },
      {
        "description": "transfer_big_m: inter-hub transfer is zero if the originating hub is not open"
      }
    ],
    "decision_variables": [
      "open_hub[Hubs]: 1 if hub h is opened (binary)",
      "collect[Origins,Hubs]: flow from origin o to hub h (continuous, non-negative)",
      "transfer[Hubs,Hubs]: flow from hub h1 to hub h2 (continuous, non-negative, exclude diagonal)",
      "deliver[Hubs,Destinations]: flow from hub h to destination d (continuous, non-negative)"
    ],
    "parameters": [
      "hub_fixed_cost[Hubs]: fixed opening cost per hub",
      "collect_cost[Origins,Hubs]: per-unit cost from origin to hub",
      "transfer_cost[Hubs,Hubs]: per-unit inter-hub transfer cost (sparse, no self-loops)",
      "deliver_cost[Hubs,Destinations]: per-unit cost from hub to destination",
      "supply[Origins]: units to ship from each origin",
      "demand[Destinations]: units needed at each destination",
      "hub_capacity[Hubs]: maximum throughput per hub",
      "big_m: large constant for big-M linking constraints (scalar)"
    ],
    "additional_notes": "Total supply = total demand = 155 units. h2 is cheapest to open (400) and centrally located. h3 is cheapest (300) but limited capacity (150). Optimal depends on trade-off between fixed cost, collection, and delivery costs.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "hubs": "hubs.csv",
      "origins": "origins.csv",
      "destinations": "destinations.csv",
      "collect_costs": "collect_costs.csv",
      "transfer_costs": "transfer_costs.csv",
      "deliver_costs": "deliver_costs.csv",
      "hub_params": "hub_params.csv"
    }
  },
