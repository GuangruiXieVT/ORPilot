{
  "problem": {
    "title": "Vehicle Routing Problem with Time Windows (VRPTW)",
    "description": "A depot must deliver goods to several customers using a fleet of vehicles. Each vehicle starts from the depot, visits a subset of customers, and returns to the depot. Each customer has a demand that must be satisfied, a vehicle capacity must not be exceeded, and each customer must be visited within a specified time window (earliest and latest arrival time). Travel times are known between every pair of locations. Service at each customer takes a fixed duration. The objective is to minimize total travel distance.",
    "problem_type": "mixed_integer_programming",
    "objective": "minimize",
    "objective_description": "Total travel distance across all vehicle arcs used",
    "constraints": [
      {
        "description": "Each customer is visited exactly once across all vehicles"
      },
      {
        "description": "Flow conservation: arcs entering and leaving each location balance for each vehicle"
      },
      {
        "description": "Each vehicle departs from the depot at most once"
      },
      {
        "description": "Each vehicle returns to the depot at most once"
      },
      {
        "description": "Vehicle capacity: total customer demand served by each vehicle must not exceed the vehicle capacity"
      },
      {
        "description": "MTZ subtour elimination: position variables prevent sub-tours among customers"
      },
      {
        "description": "Departure time from depot: arrival time at each customer visited from the depot is at least the depot-to-customer travel time (big-M linking)"
      },
      {
        "description": "Time propagation: arrival time at the next customer accounts for service time and travel time at the current customer (big-M linking)"
      },
      {
        "description": "Time window lower bound: each vehicle must arrive at a customer no earlier than the time window opens (enforced only when the customer is visited by that vehicle)"
      },
      {
        "description": "Time window upper bound: each vehicle must arrive at a customer no later than the time window closes"
      }
    ],
    "decision_variables": [
      "y[l1,l2,v]: 1 if vehicle v travels directly from location l1 to location l2, else 0 (binary, exclude self-loops)",
      "u[c,v]: position of customer c in vehicle v's route (integer, used for MTZ subtour elimination)",
      "arrive[c,v]: arrival time of vehicle v at customer c (continuous, non-negative)"
    ],
    "parameters": [
      "distance[l1,l2]: travel distance from location l1 to location l2",
      "travel_time[l1,l2]: travel time from location l1 to location l2",
      "demand[c]: delivery demand at customer c",
      "service_time[c]: time spent servicing customer c",
      "tw_lb[c]: earliest acceptable arrival time at customer c",
      "tw_ub[c]: latest acceptable arrival time at customer c",
      "vehicle_capacity: maximum load per vehicle",
      "big_m: large constant for time-window big-M linking constraints"
    ],
    "additional_notes": "The time propagation constraints use a big-M formulation: arrive[c2,v] - arrive[c1,v] - big_m*y[c1,c2,v] + big_m >= travel_time[c1,c2] + service_time[c1]. When y[c1,c2,v]=1 (arc used), this enforces arrive[c2] >= arrive[c1] + service + travel. When y=0 (arc not used), the constraint is relaxed by big_m. The time window lower bound uses a similar big-M over inbound arcs.",
    "csv_file_paths": {
      "sets": "sets.csv",
      "customers": "customers.csv",
      "arcs": "arcs.csv",
      "service_params": "service_params.csv",
      "vehicle_params": "vehicle_params.csv"
    }
  },
